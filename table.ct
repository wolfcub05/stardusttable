function Apply_Batch_Interactable_Modifications(target_data)
    local target_address = target_data.address
    local g  = target_data.general_zone
    local g0 = target_data.zone1 or g   -- general_zone is read from zone 1

    -- A general_zone value that was changed goes to all 8 zones; an unchanged one
    -- keeps each zone's own value (so restoring .backup puts every zone back as it was).
    for index = 0, 7 do
        local z = target_data["zone" .. (index + 1)] or g
        local base = target_address + 0x008 + index * 0x088
        writeFloat(base + 0x004, (g.radius ~= g0.radius) and g.radius or z.radius)
        writeFloat(base + 0x008, (g.view_distance ~= g0.view_distance) and g.view_distance or z.view_distance)
        writeByte(base + 0x078, (g.auto_interact ~= g0.auto_interact) and g.auto_interact or z.auto_interact)
    end
end
