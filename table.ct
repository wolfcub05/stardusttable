function Apply_AiEnemy_Data(target_data)
    local target_address = target_data.address

    --//! =====================           Movement &amp;&amp; Patrol
    writeFloat(target_address   + 0x000, target_data.guard.movement.speed)
    writeInteger(target_address + 0x004, target_data.guard.movement.locomotion_set)
    writeFloat(target_address   + 0x014, target_data.guard.move_distance[1])
    writeFloat(target_address   + 0x018, target_data.guard.move_distance[2])
    writeFloat(target_address   + 0x01C, target_data.guard.random_wait_time[1])
    writeFloat(target_address   + 0x020, target_data.guard.random_wait_time[2])
    writeFloat(target_address   + 0x024, target_data.patrol.movement.speed)
    writeInteger(target_address + 0x028, target_data.patrol.movement.locomotion_set)

    --//! =====================           Investigate
    writeFloat(target_address   + 0x03C, target_data.investigate.movement.speed)
