-- //! =========================================================================
function Apply_ReloadSettings_Modifications(target_data)
    local target_address = target_data.address
    writeByte(target_address  + 0x00, target_data.manual_clearing)
    writeByte(target_address  + 0x01, target_data.reload_allow_move)
    writeInteger(target_address + 0x04, target_data.ability_type)

    writeInteger(target_address + 0x08, target_data["reload_anim_events"][1]["type"])
    writeInteger(target_address + 0x0C, target_data.reload_anim_events[1]["animation_event_weapon"])
    writeInteger(target_address + 0x10, target_data.reload_anim_events[1]["animation_event_wielder"])


    writeInteger(target_address + 0x14, target_data.reload_anim_events[2]["type"])
    writeInteger(target_address + 0x18, target_data.reload_anim_events[2]["animation_event_weapon"])
    writeInteger(target_address + 0x1C, target_data.reload_anim_events[2]["animation_event_wielder"])


    writeInteger(target_address + 0x20, target_data.reload_anim_events[3]["type"])
    writeInteger(target_address + 0x24, target_data.reload_anim_events[3]["animation_event_weapon"])
    writeInteger(target_address + 0x28, target_data.reload_anim_events[3]["animation_event_wielder"])


    writeInteger(target_address + 0x2C, target_data.reload_anim_events[4]["type"])
    writeInteger(target_address + 0x30, target_data.reload_anim_events[4]["animation_event_weapon"])
    writeInteger(target_address + 0x34, target_data.reload_anim_events[4]["animation_event_wielder"])

    writeFloat(target_address + 0x38, target_data.duration)
end

