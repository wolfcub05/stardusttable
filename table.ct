function locateAiEnemyAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "AiEnemy"
    local struct_size = 0x2DC
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_AiEnemy_Data(target_unique_id)
    local target_info    = locateAiEnemyAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx             = target_info.idx,
        address         = target_address,
    }
    --//! ===================== Offsets: 0x000 - 0x028 =========================
    output_template["guard"] = {
        movement = {
            speed          = readFloat(target_address   + 0x000),
            locomotion_set = readInteger(target_address + 0x004),
        },
        move_distance = {
            [1] = readFloat(target_address + 0x014),
            [2] = readFloat(target_address + 0x018),
        },
        random_wait_time = {
            [1] = readFloat(target_address + 0x01C),
            [2] = readFloat(target_address + 0x020),
        }
