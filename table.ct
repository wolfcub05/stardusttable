        <CheatEntry>
          <ID>9520059</ID>
          <Description>"[MOUNT FORGE v5.3]  (Mount Editor replacement - GUI, player-side platforms only, verified reset)"</Description>
          <Options moAlwaysHideChildren="1" moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <LastState/>
          <Color>FF8000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{
  Game    : helldivers2.exe
  Version : any (compdata-pointer driven, version independent)
  Date    : 2026-09-30
  Author  : Dániel
  Based on: Mount Editor by BREWSKI / MechDataMod by Sakuno
  Requires: XND_ToolKit CORE active first (compdata_db + values_compdata)

  ============================================================
   M O U N T   F O R G E   v5.3
  ============================================================
  A drop-in replacement for the Mount Editor script.

  New in v5.3:
    * Player-side platforms only. Enemies, objective props and ship
      crew can no longer be edited - every write is refused unless the
      record is on the verified platform list (MF.PLATFORMS).
    * No more unknown IDs. Every platform in the picker was named from
      game data (unit path + faction + payload) - 11 new ones incl. the
      TD-110 Maelstrom, all Eagle payloads, the Hot Dog and the extra
      Pelican/GATER variants. Records that are not platforms are gone
      from the picker and the browser.
    * Real attach-node names recovered for the Bastion (attach_tank_gun /
      attach_tank_gun_mg), GATER, Pelican, Eagle, Maelstrom and Grenadier
      Battlement sockets. The old aliases still work.
    * Platforms with no mounts at all (e.g. Pelican (Cargo)) are listed
      too, so you can add to them.

  What it adds over the original:
    * UID validation - the original silently wrote to mount index 0
      when a UID was not found. This one refuses and tells you.
    * Full unsigned 64-bit UID handling. UIDs above 2^63
      (Emancipator = 14038927220542196401) no longer lose precision.
    * attach_node hashing. Node IDs are MurmurHash64A(name) &gt;&gt; 32
      (Stingray IdString32). Verified against all 91 known nodes.
      You can now type ANY node name, not just the listed ones.
    * Whole-DB enumeration + reverse lookup (who mounts what).
    * Per-slot loop access instead of 5x unrolled copy-paste.
    * Undo stack, per-mount reset, global reset.
    * Loadout export/import strings for sharing builds.
    * Fluent builder API.
    * Optional watchdog that re-resolves and re-applies after the
      compdata pointers move.

  Type  MF.help()  in the Lua console after enabling.
  ============================================================
}
{$lua}
if syntaxcheck then return end

--=============================================================
-- 0. ENVIRONMENT
--=============================================================
if compdata_db == nil or values_compdata == nil then
  error("MOUNT FORGE: CORE is not active. Enable the CORE / compdata scripts first.")
end
if compdata_db["mount_params"] == nil then
  error("MOUNT FORGE: compdata_db['mount_params'] is missing. Re-activate CORE.")
end

MF = MF or {}
MF.VERSION   = "5.3"
MF.STRUCT    = 0x78          -- mount_params record size
MF.SLOT      = 0x18          -- 5 slots x 24 bytes = 0x78
MF.SLOTS     = 5
MF.DB        = "mount_params"

MF.cache      = MF.cache      or {}   -- uid -&gt; live record
MF.backup     = MF.backup     or {}   -- uid -&gt; pristine slot array
MF.backupMeta = MF.backupMeta or {}   -- uid -&gt; {addr, idx} at the moment backup was captured
MF.undoStack  = MF.undoStack  or {}
MF.symbols   = MF.symbols or {}
MF.quiet     = false

MF.logSink = MF.logSink or nil     -- set by the GUI so output stops flooding the console
local function say(...)
  if MF.quiet then return end
  local n, parts = select("#", ...), {}
  for i = 1, n do parts[i] = tostring((select(i, ...))) end
  local line = table.concat(parts, "\t")
  if MF.logSink then
    local ok = pcall(MF.logSink, line)
    if ok then return end
    MF.logSink = nil
  end
  print(line)
end
MF.say = function(...) say(...) end

--=============================================================
-- 1. 64-BIT MATH  (compiled at runtime so the script still
--    parses on a Lua 5.1 Cheat Engine; falls back gracefully)
--=============================================================
local bignum = nil
do
  local src = [==[
    local M = {}
    -- decimal / hex string -&gt; wrapped 64-bit integer
    function M.u64(v)
      if type(v) == "number" then return (v // 1) end
      local s = tostring(v):gsub("%s", "")
      if s == "" then return 0 end
      if s:match("^0[xX]%x+$") then
        local n = 0
        for c in s:sub(3):gmatch("%x") do n = n * 16 + tonumber(c, 16) end
        return n
      end
      if not s:match("^%d+$") then return nil end
      local n = 0
      for i = 1, #s do n = n * 10 + (s:byte(i) - 48) end  -- wraps mod 2^64
      return n
    end
    function M.ustr(n)
      if math.type(n) ~= "integer" then n = math.tointeger(n) or 0 end
      return string.format("%u", n)
    end
    -- MurmurHash64A, seed 0 (Bitsquid / Stingray murmur_hash_64)
    function M.mm64(key)
      local m, r = 0xc6a4a7935bd1e995, 47
      local len  = #key
      local h    = 0 ~ (len * m)
      local nb   = len // 8
      for i = 0, nb - 1 do
        local o = i * 8 + 1
        local b1,b2,b3,b4,b5,b6,b7,b8 = key:byte(o, o + 7)
        local k = b1 | (b2&lt;&lt;8) | (b3&lt;&lt;16) | (b4&lt;&lt;24)
                     | (b5&lt;&lt;32) | (b6&lt;&lt;40) | (b7&lt;&lt;48) | (b8&lt;&lt;56)
        k = k * m ; k = k ~ (k &gt;&gt; r) ; k = k * m
        h = h ~ k ; h = h * m
      end
      local o, t = nb * 8, len - nb * 8
      if t &gt;= 7 then h = h ~ (key:byte(o+7) &lt;&lt; 48) end
      if t &gt;= 6 then h = h ~ (key:byte(o+6) &lt;&lt; 40) end
      if t &gt;= 5 then h = h ~ (key:byte(o+5) &lt;&lt; 32) end
      if t &gt;= 4 then h = h ~ (key:byte(o+4) &lt;&lt; 24) end
      if t &gt;= 3 then h = h ~ (key:byte(o+3) &lt;&lt; 16) end
      if t &gt;= 2 then h = h ~ (key:byte(o+2) &lt;&lt;  8) end
      if t &gt;= 1 then h = h ~  key:byte(o+1)        ; h = h * m end
      h = h ~ (h &gt;&gt; r) ; h = h * m ; h = h ~ (h &gt;&gt; r)
      return h
    end
    -- IdString32 = high dword of the 64-bit hash
    function M.id32(key) return (M.mm64(key) &gt;&gt; 32) &amp; 0xFFFFFFFF end
    return M
  ]==]
  local chunk = load or loadstring
  local ok, fn = pcall(chunk, src, "MF_bignum")
  if ok and fn then
    local ok2, mod = pcall(fn)
    if ok2 then bignum = mod end
  end
end

-- Hard requirement. Without 64-bit integers Lua cannot even REPRESENT a mount
-- UID above 2^53, let alone write one - it would silently corrupt the table.
-- Refusing to load beats writing garbage.
if bignum == nil then
  error("MOUNT FORGE requires Cheat Engine 7.x (Lua 5.3+ with 64-bit integers). " ..
        "This CE build cannot represent mount UIDs safely, so the script will not load.")
end

function MF.u64(v)  return bignum.u64(v) end
function MF.ustr(n) if n == nil then return "0" end return bignum.ustr(n) end

-- node ids are unsigned 32-bit; some CE builds hand readInteger back signed
local function rdU32(a)
  local v = readInteger(a)
  if v == nil then return 0 end
  return v &amp; 0xFFFFFFFF
end

