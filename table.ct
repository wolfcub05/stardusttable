{$lua}
-- //! =========================================================================
-- //!  =====================    A R C    S E T T I N G S    ===================
-- //! =========================================================================

function getAddressArcSettings(target_id)
    local struct_size = 0x68
    local output_addr = AddressHandler(target_id, "arc_weapons", struct_size)
    fullAccess(output_addr, struct_size)
    return output_addr
end

function Read_ArcSettings_Data(input_str_idx)
    local arc_idx = readIndexedString(ArcSettingsDatabaseOUT, input_str_idx)
    local target_address = getAddressArcSettings(arc_idx)
    local output_template = {
        address          = target_address,
        typearc                                 = readInteger(target_address + 0x000),
        speed                                   = readFloat(target_address   + 0x004),
        distance                                = readFloat(target_address   + 0x008),
        distance_at_max_angle_spread            = readFloat(target_address   + 0x00C),
        distance_at_max_angle_spread_first_shot = readFloat(target_address   + 0x010),
        max_angle_spread                        = readFloat(target_address   + 0x014),
        max_angle_spread_first_shot             = readFloat(target_address   + 0x018),
        max_chain_length                        = readInteger(target_address + 0x01C),
        max_chain_split                         = readInteger(target_address + 0x020),
        hit_effect_damage_type                  = readInteger(target_address + 0x048),
        demolition_strength                     = readInteger(target_address + 0x058),
        unknown_5C                              = readInteger(target_address + 0x05C),
        unknown_60                              = readInteger(target_address + 0x060),
        unknown_64                              = readInteger(target_address + 0x064)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

-- //! =========================================================================
-- //!  =====================    A R C    C O M P D A T A    ===================
-- //! =========================================================================
function locateArcAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "arc_params"
    local struct_size = 0x50
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_ArcParametersByUID_Data(target_unique_id)
    local target_info    = locateArcAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        address           = target_address,
        rounds_per_minute = readFloat(target_address + 0x04)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

