{$lua}
-- // Function that, if an susceptibility struct has its type set to 27 (StatusEffectSusceptibilityType_Gas)
-- // or 28 (StatusEffectSusceptibilityType_GasConfusion), it will set their min_threshold to 0.1 if it's below that value.
-- // Will also set its max_threshold to 0.2 if it's below that value.
function moreGasSusceptibilities(target_data)
    local modified = false
    for i, zone in ipairs(target_data.zones) do
        for j, susceptibility in ipairs(zone.susceptibilities) do
            if susceptibility.type == 27 or susceptibility.type == 28
                or susceptibility.type == "StatusEffectSusceptibilityType_Gas"
                or susceptibility.type == "StatusEffectSusceptibilityType_Gas_Confusion" then
                if susceptibility.min_threshold &lt; 0.1 then
                    susceptibility.min_threshold = 0.1
                    modified = true
                end
                if susceptibility.max_threshold &lt; 0.2 then
                    susceptibility.max_threshold = 0.2
                    modified = true
                end
            end
        end
    end

    -- // Also force the last two resistance slots to Gas / Gas_Confusion.
    if target_data.status_effect_resistances ~= nil then
        if target_data.status_effect_resistances[7] == nil then
            target_data.status_effect_resistances[7] = {}
        end
        if target_data.status_effect_resistances[8] == nil then
            target_data.status_effect_resistances[8] = {}
        end

        target_data.status_effect_resistances[7].type = "StatusEffectSusceptibilityType_Gas"
        target_data.status_effect_resistances[7].duration_scale = 10.0

        target_data.status_effect_resistances[8].type = "StatusEffectSusceptibilityType_Gas_Confusion"
        target_data.status_effect_resistances[8].duration_scale = 10.0
        modified = true
    end

    return modified
end




-- 64-bit values above 2^63 can't be passed to writeQword as decimal text or as a float
-- (they end up as 0), so turn number-or-text into the exact 64-bit integer first.
local function U64(v)
    if math.type(v) == "integer" then return v end
    if type(v) == "number" then return math.tointeger(v) or 0 end
    local n = 0
    for d in tostring(v or 0):gmatch("%d") do n = n * 10 + tonumber(d) end
    return n
end

function Apply_StatusEffectReceiver_Data(target_data)
    local target_address = target_data.address
    fullAccess(target_address, 0xB608)
    -- // Zones
    for i, zone in ipairs(target_data.zones) do
        local zone_address = target_address + (i - 1) * 0x16B8
        writeInteger(zone_address + 0x0, zone.damageable_zone_name)
        writeInteger(zone_address + 0x4, zone.effect_node_name)
        for j, susceptibility in ipairs(zone.susceptibilities) do
            local susceptibility_address = zone_address + 0x8 + (j - 1) * 0xB0
            for k, effect in ipairs(susceptibility.effects) do
                local effect_address = susceptibility_address + (k - 1) * 0x10
                writeQword(effect_address + 0x0, U64(effect.particle_effect_path))
                writeInteger(effect_address + 0x8, effect.node_id)
            end
            writeInteger(susceptibility_address + 0x8C, fromStringtoMemory(StatusEffectSusceptibilityDatabaseOUT, susceptibility.type))
            writeFloat(susceptibility_address + 0x90, susceptibility.min_threshold)
            writeFloat(susceptibility_address + 0x94, susceptibility.max_threshold)
            writeInteger(susceptibility_address + 0x98, susceptibility.audio_event_start)
            writeInteger(susceptibility_address + 0x9C, susceptibility.audio_event_stop)
            writeInteger(susceptibility_address + 0xA0, susceptibility.animation_event_start)
            writeInteger(susceptibility_address + 0xA4, susceptibility.animation_event_stop)
            writeFloat(susceptibility_address + 0xA8, susceptibility.damage_multiplier)
            writeFloat(susceptibility_address + 0xAC, susceptibility.additional_multiplier)
        end
    end
    -- // Volume query
    writeInteger(target_address + 0xB5C0, target_data.volume_query_node_name)
    writeFloat(target_address + 0xB5C4, target_data.volume_query_size_radius)
    -- // Status effect resistances
    for i, resistance in ipairs(target_data.status_effect_resistances) do
        local resistance_address = target_address + 0xB5C8 + (i - 1) * 0x8
        writeInteger(resistance_address + 0x0, fromStringtoMemory(StatusEffectSusceptibilityDatabaseOUT, resistance.type))
        writeFloat(resistance_address + 0x4, resistance.duration_scale)
    end
    return true
end


