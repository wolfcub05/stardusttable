{$lua}
if syntaxcheck then return end

if _G.CT_UI == nil then _G.CT_UI = {} end
if _G.CT_UI.windows == nil then _G.CT_UI.windows = {} end

function CT_UI_ShowWindow(key, ownerMemrec, opts)
  local w = _G.CT_UI.windows[key]

  if w == nil then
    local f = createForm(false)
    f.Position = "poScreenCenter"
    f.BorderStyle = "bsSizeable"
    f.Width = opts.width or 480
    f.Height = opts.height or 320

    local title = createLabel(f)
    title.Left = 12
    title.Top = 10
    title.AutoSize = true
    title.Font.Size = 11

    local memo = createMemo(f)
    memo.Left = 12
    memo.Top = 34
    memo.ReadOnly = true
    memo.ScrollBars = "ssVertical"
    memo.WordWrap = true

    local ok = createButton(f)
    ok.Caption = "OK"
    ok.Width = 90
    ok.Height = 28

    local function layout()
      memo.Width = f.ClientWidth - 24
      memo.Height = f.ClientHeight - 34 - 46
      ok.Left = f.ClientWidth - ok.Width - 12
      ok.Top = f.ClientHeight - ok.Height - 10
    end

    f.OnResize = layout
    layout()

    ok.OnClick = function()
      f.close()
    end

    f.OnClose = function()
      if ownerMemrec and ownerMemrec.Active then
        ownerMemrec.Active = false
      end
      return caHide
    end

    w = {
      form = f,
      title = title,
      memo = memo
    }

    _G.CT_UI.windows[key] = w
  end

  w.form.Caption = opts.caption or "Info"
  w.title.Caption = opts.title or ""
  w.memo.Lines.Text = opts.text or ""

  w.form.show()
  w.form.bringToFront()
  w.form.repaint()
end

function CT_UI_HideWindow(key)
  local w = _G.CT_UI.windows[key]
  if w and w.form then
    w.form.hide()
  end
end
