                y = readFloat(target_address + 0x014)},
            sway_thirdperson_freq = {
                x = readFloat(target_address + 0x018),
                y = readFloat(target_address + 0x01C)},
            recoil_scoped_mult = {
                x = readFloat(target_address + 0x020),
                y = readFloat(target_address + 0x024)},
            recoil_thirdperson_mult = {
                x = readFloat(target_address + 0x028),
                y = readFloat(target_address + 0x02C)},
            noise = {
                x = readFloat(target_address + 0x030),
                y = readFloat(target_address + 0x034)},
            visibility = {
                x = readFloat(target_address + 0x038),
                y = readFloat(target_address + 0x03C)},
            },
        crouch = {
            sway_scoped_mult = {
                x = readFloat(target_address + 0x050),
                y = readFloat(target_address + 0x054)},
            sway_thirdperson_mult = {
                x = readFloat(target_address + 0x058),
                y = readFloat(target_address + 0x05C)},
            sway_scoped_freq = {
                x = readFloat(target_address + 0x060),
                y = readFloat(target_address + 0x064)},
            sway_thirdperson_freq = {
                x = readFloat(target_address + 0x068),
                y = readFloat(target_address + 0x06C)},
            recoil_scoped_mult = {
                x = readFloat(target_address + 0x070),
                y = readFloat(target_address + 0x074)},
            recoil_thirdperson_mult = {
                x = readFloat(target_address + 0x078),
                y = readFloat(target_address + 0x07C)},
            noise = {
                x = readFloat(target_address + 0x080),
                y = readFloat(target_address + 0x084)},
            visibility = {
                x = readFloat(target_address + 0x088),
                y = readFloat(target_address + 0x08C)},
            },
        prone = {
            sway_scoped_mult = {
                x = readFloat(target_address + 0x0A0),
                y = readFloat(target_address + 0x0A4)},
            sway_thirdperson_mult = {
                x = readFloat(target_address + 0x0A8),
                y = readFloat(target_address + 0x0AC)},
            sway_scoped_freq = {
                x = readFloat(target_address + 0x0B0),
                y = readFloat(target_address + 0x0B4)},
            sway_thirdperson_freq = {
                x = readFloat(target_address + 0x0B8),
                y = readFloat(target_address + 0x0BC)},
            recoil_scoped_mult = {
                x = readFloat(target_address + 0x0C0),
                y = readFloat(target_address + 0x0C4)},
            recoil_thirdperson_mult = {
                x = readFloat(target_address + 0x0C8),
                y = readFloat(target_address + 0x0CC)},
            noise = {
                x = readFloat(target_address + 0x0D0),
                y = readFloat(target_address + 0x0D4)},
            visibility = {
                x = readFloat(target_address + 0x0D8),
                y = readFloat(target_address + 0x0DC)},
            }
    }
    return {backup = deepcopy(stance_template), DATA = deepcopy(stance_template)}
end



