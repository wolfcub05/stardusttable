{$lua}


function Apply_SensorEye_Modifications(target_data)
    local target_address = target_data.address
    writeFloat(target_address   + 0x000, target_data.distance)
    writeFloat(target_address   + 0x004, target_data.peripheral_distance)
    writeFloat(target_address   + 0x008, target_data.back_distance)
    writeFloat(target_address   + 0x00C, target_data.angle_horizontal)
    writeFloat(target_address   + 0x010, target_data.angle_vertical)

    writeInteger(target_address   + 0x014, target_data.sight_node)
    writeInteger(target_address   + 0x018, target_data.use_sight_node_for_direction)
    writeInteger(target_address   + 0x01C, fromStringtoMemory(RaycastTemplateDatabaseOUT, target_data.vision_raycast_template))
    writeInteger(target_address   + 0x020, fromStringtoMemory(EyeTypeTemplateDatabaseOUT, target_data.eye_type))

    writeFloat(target_address   + 0x024, target_data.ignore_inside_foliage_distance)
    writeFloat(target_address   + 0x028, target_data.inside_foliage_distance)
end


