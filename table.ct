-- //! =========================================================================
--                           Ai Spawner Component Data
-- //! =========================================================================

function locateAiSpawnerAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "AiSpawner"
    local struct_size = 0x0C4
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_AiSpawner_Data(target_unique_id)
    local target_info    = locateAiSpawnerAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx             = target_info.idx,
        address         = target_address,
    }
    --//! ===================== Offsets: 0x000 - 0x020 =========================
    output_template["spawn_start_duration"] = readFloat(target_address + 0x01C)
    output_template["spawn_stop_duration"]  = readFloat(target_address + 0x020)
    --//! ===================== Offsets: 0x074 - 0x0AC =========================
    output_template["production_queue_limit"]           = readInteger(target_address  + 0x088)
    output_template["spawn_count"]                      = readInteger(target_address  + 0x08C)
    output_template["spawn_count_minimum"]              = readInteger(target_address  + 0x090)
    output_template["production_cooldown"]              = readFloat(target_address + 0x094)
    output_template["spawn_cooldown"]                   = readFloat(target_address + 0x098)
    output_template["spawn_delay"]                      = readFloat(target_address + 0x09C)
    output_template["cooldown_variation"]               = readFloat(target_address + 0x0A0)
    output_template["use_global_spawner_cooldown"] = readByte(target_address  + 0x0A7)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


{$asm}
