warrant_projectile2.DATA.explosion_type_impact = "ExplosionType_None"

warrant_magazine.DATA.magazine_size = 14

warrant_weaponinfo.DATA.handling.sway_mlt = 1.1
warrant_weaponinfo.DATA.handling.scope_sway = 1.1

-- // =============== Tags Settings
warrant_tagsinfo.DATA.tag4 = 0

warrant_reload.DATA.duration = 1.4

Apply_DamageSettings_Modifications(warrant_stun_damage.DATA)
Apply_ExplosiveSettings_Modifications(warrant_stun_explo.DATA)
