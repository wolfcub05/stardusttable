function Apply_Bombardment_Modifications(target_settings)
    local target_address = target_settings.address
    writeFloat(target_address + 0x0000,   target_settings.initial_delay)
    writeInteger(target_address + 0x0004, target_settings.num_bombs)
    writeFloat(target_address + 0x0008,   target_settings.bomb_interval)
    writeFloat(target_address + 0x000C,   target_settings.bomb_interval_random_offset)
    writeFloat(target_address + 0x0010,   target_settings.wander_offset_radius_min)
    writeFloat(target_address + 0x0014,   target_settings.wander_offset_radius_max)
    writeInteger(target_address + 0x0018, target_settings.num_salvos)
    writeFloat(target_address + 0x001C,   target_settings.salvo_interval)
    writeFloat(target_address + 0x0020,   target_settings.salvo_interval_random_offset)
    writeFloat(target_address + 0x0024,   target_settings.area_size)
    writeFloat(target_address + 0x0028,   target_settings.wander_start_area_radius)
    writeFloat(target_address + 0x002C,   target_settings.fire_height)
    writeInteger(target_address + 0x003C, target_settings.fire_from_ship)
    writeInteger(target_address + 0x0040, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj1))
    writeInteger(target_address + 0x0044, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj2))
    writeInteger(target_address + 0x0048, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj3))
    writeInteger(target_address + 0x004C, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj4))
    writeInteger(target_address + 0x0050, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj5))
    writeInteger(target_address + 0x0054, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj6))
    writeInteger(target_address + 0x0058, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj7))
    writeInteger(target_address + 0x005C, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.projectile_types.proj8))
    writeFloat(target_address + 0x0060,   target_settings.speed)
    writeFloat(target_address + 0x0080,   target_settings.start_delay)
    writeFloat(target_address + 0x0084,   target_settings.walk_angle)
    writeFloat(target_address + 0x0088,   target_settings.walk_offset_fraction)
end
