--// ============    Get Projectile CompData UID Address
function LocateProjectileAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "projectiles"
    local struct_size = 0x268
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


--// ============    Get Projectile Settings Address
function getAddressProjectileSettings(target_id)
    local struct_size = 0x110
    local output_addr = AddressHandler(target_id, "projectiles", struct_size)
    return output_addr
end

--// ===========================================================================
--// ===========================================================================
--// ===========================================================================

function Read_ProjSettings(input_template, projectile_str_idx)
    if projectile_str_idx == nil or projectile_str_idx == "" then
        input_template["info"]["settings"] = {idx     = 0,
                                              address = "0x0000000000000000"}
        return input_template
    end
    local target_id   = readIndexedString(ProjectileSettingsDatabaseOUT, projectile_str_idx)
    local target_addr = getAddressProjectileSettings(target_id)
    input_template["info"]["settings"] = {idx     = target_id,
                                          address = target_addr}
    input_template.enum_type             = readInteger(target_addr + 0x000)
    --//* ======================================================================
    --//* =============          Bytes: [0x018, 0x040]           ===============
    --//* ======================================================================
    input_template.calibre               = readFloat(target_addr   + 0x018)
    input_template.num_projectiles       = readInteger(target_addr + 0x01C)
    input_template.speed                 = readFloat(target_addr   + 0x020)
    input_template.mass                  = readFloat(target_addr   + 0x024)
    input_template.drag                  = readFloat(target_addr   + 0x028)
    input_template.gravity_multiplier    = readFloat(target_addr   + 0x02C)
    input_template.simulation_steps      = readInteger(target_addr + 0x030)
    input_template.life_time             = readFloat(target_addr   + 0x034)
    input_template.life_time_randomness  = readFloat(target_addr   + 0x038)
    input_template.damage_info_type      = readInteger(target_addr + 0x03C)
    input_template.penetration_slowdown  = readFloat(target_addr   + 0x040)
    --//* ======================================================================
    --//* =============          Bytes: [0x048, 0x080]           ===============
    --//* ======================================================================
    input_template.particle_thruster_effect_path          = readQword(target_addr + 0x048)
    input_template.low_ammo_particle_thruster_effect_path = readQword(target_addr + 0x050)
    input_template.particle_thruster_effect_length        = readFloat(target_addr + 0x058)
    input_template.particle_trail_effect_path             = readQword(target_addr + 0x060)
    input_template.dissipate_particle_effect_path         = readQword(target_addr + 0x068)
    input_template.disintegration_particle_effect_path    = readQword(target_addr + 0x070)
    input_template.hit_direction_hint_effect              = readQword(target_addr + 0x078)
    input_template.projectile_unit_path                   = readQword(target_addr + 0x080)
    --//* ======================================================================
    --//* =============          Bytes: [0x088, 0x0A4]           ===============
    --//* ======================================================================
    input_template.expl_threshold_angle     = readFloat(target_addr   + 0x088)
    input_template.can_expire_after_impact  = readInteger(target_addr + 0x08C)
    input_template.explosion_type_impact    = readInteger(target_addr + 0x090)
    input_template.explosion_proximity      = readFloat(target_addr   + 0x094)
    input_template.explosion_delay          = readFloat(target_addr   + 0x098)
    input_template.explosion_type_expire    = readInteger(target_addr + 0x09C)
    input_template.arming_distance          = readFloat(target_addr   + 0x0A0)
    input_template.decal_size               = readFloat(target_addr   + 0x0A4)
    --//* ======================================================================
    --//* =============          Bytes: [0x0A8, 0x0D4]           ===============
    --//* ======================================================================
    input_template.surface_impact_type      = readInteger(target_addr + 0x0A8)
    input_template.ricochet_impact_type     = readInteger(target_addr + 0x0AC)
    input_template.max_ricochets            = readInteger(target_addr + 0x0B0)
    input_template.ricochet_threshold_angle = readFloat(target_addr + 0x0B4)
    input_template.ricochet_threshold_speed = readFloat(target_addr + 0x0B8)
    input_template.ricochet_angle_loss      = readFloat(target_addr + 0x0BC)
    input_template.ricochet_spread_vertical = readFloat(target_addr + 0x0C0)
    input_template.ricochet_spread_horizontal = readFloat(target_addr + 0x0C4)
    input_template.audio_crack_event        = readInteger(target_addr + 0x0C8)
    input_template.audio_ricochet_event     = readInteger(target_addr + 0x0CC)
    input_template.audio_trail_event_start  = readInteger(target_addr + 0x0D0)
    input_template.audio_trail_event_stop   = readInteger(target_addr + 0x0D4)
    --//* ======================================================================
    --//* =============          Bytes: [0x0D8, 0x10C]           ===============
    --//* ======================================================================
    input_template.unknown_D8                    = readFloat(target_addr   + 0x0D8)
    input_template.unknown_DC                    = readInteger(target_addr + 0x0DC)
    input_template.unknown_E0                    = readInteger(target_addr + 0x0E0)
    input_template.status_effect_volume_template = readInteger(target_addr + 0x0E4)
    input_template.hit_effect_damage_type        = readInteger(target_addr + 0x0E8)
    input_template.fire_template                 = readInteger(target_addr + 0x0EC)
    -- //! =================          0x0F0 Assignation         ================
    local byteprep_F0                    = readInt_bin13digits(target_addr + 0x0F0)
    input_template.inherit_velocity                 = tonumber(byteprep_F0:sub(1, 1))
    input_template.ignore_terminal_velocity         = tonumber(byteprep_F0:sub(2, 2))
    input_template.remove_thruster_effect_instantly = tonumber(byteprep_F0:sub(3, 3))
    input_template.remove_trail_effect_instantly    = tonumber(byteprep_F0:sub(4, 4))
    input_template.projectile_unit_auto_remove      = tonumber(byteprep_F0:sub(5, 5))
    input_template.explosions_inherit_velocity      = tonumber(byteprep_F0:sub(6, 6))
    input_template.project_decal                    = tonumber(byteprep_F0:sub(7, 7))
    input_template.global_audio                     = tonumber(byteprep_F0:sub(8, 8))
    input_template.audio_danger_zone                = tonumber(byteprep_F0:sub(9, 9))
    input_template.hit_only_ground                  = tonumber(byteprep_F0:sub(10, 10))
    input_template.can_pass_through_shield          = tonumber(byteprep_F0:sub(11, 11))
    input_template.allow_long_distance_travel       = tonumber(byteprep_F0:sub(12, 12))
    input_template.look_for_audio_source_hijack     = tonumber(byteprep_F0:sub(13, 13))
    -- //! =====================================================================

    input_template.raycast_template                     = readInteger(target_addr + 0x0F4)
    input_template.proximity_explosion_collision_filter = readInteger(target_addr + 0x0F8)
    -- //! =================         0x0FC Assignation         =================
    local byteprep_FC                     = readInt_bin13digits(target_addr + 0x0FC)
    input_template.apply_stim_on_target             = tonumber(byteprep_FC:sub(1, 1))
    input_template.projectile_auto_attach           = tonumber(byteprep_FC:sub(2, 2))
    -- //! =====================================================================
    input_template["projectile_attachment_local_offset"] = {
            x = readFloat(target_addr + 0x100),
            y = readFloat(target_addr + 0x104),
            z = readFloat(target_addr + 0x108),
        }
    return input_template
end

function Read_ProjCompData(input_template, unique_projectile_id)
    local struct_size = 0x268
    local target_info = LocateProjectileAddress(unique_projectile_id)
    local target_id   = target_info.idx
    local target_addr = target_info.address
    fullAccess(target_addr, struct_size)
    input_template["info"]["compdata"] = {idx     = target_id,
                                          address = target_addr}
    --//* ======================================================================
    --//* =============          Bytes: [0x000, 0x030]           ===============
    --//* ======================================================================
    input_template.ptype = readInteger(target_addr + 0x000)
    input_template.rpm  = {
            x = readFloat(target_addr + 0x004),
            y = readFloat(target_addr + 0x008),
            z = readFloat(target_addr + 0x00C)}
    input_template.zeroing  = {
            x = readFloat(target_addr + 0x010),
            y = readFloat(target_addr + 0x014),
            z = readFloat(target_addr + 0x018),
            hipfire = readFloat(target_addr + 0x01C),
            current_zeroing_slot = readInteger(target_addr + 0x020)}
    input_template.infinite_ammo        = readInteger(target_addr + 0x024)
    input_template.projectile_entity    = readQword(target_addr   + 0x028)
    input_template.firenode_pose_limit  = readFloat(target_addr   + 0x030)
    --//* ======================================================================
    --//* =============          Bytes: [0x078, 0x0E0]           ===============
    --//* ======================================================================
    input_template.wind_effect_template  = readInteger(target_addr     + 0x078)
    input_template.speed_multiplier      = readFloat(target_addr       + 0x07C)
    input_template.damage_addends = {
        normal  = readFloat(target_addr + 0x080),
        durable = readFloat(target_addr + 0x084)
    }
    input_template.ap_addends = {
        normal  = readFloat(target_addr + 0x088),
        durable = readFloat(target_addr + 0x08C)
    }
    input_template.spinup_time            = readFloat(target_addr   + 0x090)
    input_template.rpc_synced_fire_events = readInteger(target_addr + 0x094)
    input_template.muzzle_flash           = readQword(target_addr   + 0x0E0)
    --//* ======================================================================
    --//* =============          Bytes: [0x0FC, 0x14C]           ===============
    --//* ======================================================================
    input_template.fire_loop_start_audio_event          = readInteger(target_addr + 0x0FC)
    input_template.fire_loop_stop_audio_event           = readInteger(target_addr + 0x100)
    input_template.fire_single_audio_event              = readInteger(target_addr + 0x104) --//!
    input_template.fire_all_barrel_audio_event          = readInteger(target_addr + 0x108)
    input_template.fire_reflect_audio_event             = readInteger(target_addr + 0x10C)
    input_template.silenced_fire_reflect_audio_event    = readInteger(target_addr + 0x110)
    input_template.haptics_fire_loop_start_audio_event  = readInteger(target_addr + 0x114)
    input_template.haptics_fire_loop_stop_audio_event   = readInteger(target_addr + 0x118)
    input_template.haptics_fire_single_audio_event      = readInteger(target_addr + 0x11C) --//!
    input_template.silenced_fire_loop_start_audio_event = readInteger(target_addr + 0x210)
    input_template.silenced_fire_loop_stop_audio_event  = readInteger(target_addr + 0x214)
    input_template.silenced_fire_single_audio_event     = readInteger(target_addr + 0x218) --//!
    input_template.fire_source_node                     = readInteger(target_addr + 0x21C) --//!
    input_template.dry_fire_audio_event                 = readInteger(target_addr + 0x220)
    input_template.dry_fire_repeat_audio_event          = readInteger(target_addr + 0x224)
    input_template.heat_percentage_material_variable    = readInteger(target_addr + 0x228)
    input_template.silenced                             = readInteger(target_addr + 0x22C) --//!
    --//* ======================================================================
    --//* =============          Bytes: [0x150, 0x184]           ===============
    --//* ======================================================================
    input_template.aim_zeroing_quality             = readInteger(target_addr + 0x230)
    input_template.burst_fire_rate                 = readFloat(target_addr   + 0x238)
    input_template.weapon_function_muzzle_velocity = readFloat(target_addr   + 0x23C)
    input_template.weapon_function_projectile_type = readInteger(target_addr + 0x240)
    input_template.attention_level_drawn_by_shot   = readInteger(target_addr + 0x254)
    return input_template
end

function Read_ProjectileInfo_Data(projectile_str_idx, unique_projectile_id)
    local proj_template = {
        info = {}
    }
    proj_template = Read_ProjSettings(proj_template, projectile_str_idx)
    proj_template = Read_ProjCompData(proj_template, unique_projectile_id)
    return {backup = deepcopy(proj_template), DATA = deepcopy(proj_template)}
end


