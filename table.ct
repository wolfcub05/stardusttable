    writeInteger(target_address + 0x38, input_mods_table.unk_38)
    writeQword(target_address   + 0x40, input_mods_table.path_40)
    writeFloat(target_address   + 0x48, input_mods_table.unk_48)
    writeInteger(target_address + 0x4C, input_mods_table.id_4C)
    writeQword(target_address   + 0x50, input_mods_table.path_50)
    writeInteger(target_address + 0x58, input_mods_table.id_58)
    writeQword(target_address   + 0x5C, input_mods_table.path_5C)
    writeInteger(target_address + 0x64, input_mods_table.unk_64)
    writeInteger(target_address + 0x68, input_mods_table.unk_68)
    writeInteger(target_address + 0x6C, input_mods_table.unk_6C)
    writeFloat(target_address   + 0x70, input_mods_table.unk_70)
    writeInteger(target_address + 0x74, input_mods_table.unk_74)
end

