-- //! =========================================================================
-- //!  ==============    E X P L O S I V E    S E T T I N G S    ==============
-- //! =========================================================================

function writeBytes_74(target_address, target_settings)
    local byte_74_list = {
        [1]  = target_settings.unknown_074_6thflag,
        [2]  = target_settings.look_for_audio_source_hijack,
        [3]  = target_settings.is_huge_explosion,
        [4]  = target_settings.disable_default_surface_impact,
        [5]  = target_settings.requires_raycast_confirmation,
        [6]  = target_settings.do_knockback,
    }
    local value = ""
    for i = 1, #byte_74_list do
        if byte_74_list[i] &gt; 1 then
            byte_74_list[i] = 1
        elseif byte_74_list[i] &lt; 0 then
            byte_74_list[i] = 0
        end
        local digit = string.format("%d", byte_74_list[i])
        value = value .. digit
    end
    --// Return the integer value
    writeInteger(target_address, tonumber(value, 2))
end



function Apply_ExplosiveSettings_Modifications(input_mods_table)
    local target_address = input_mods_table.address
    writeInteger(target_address + 0x04, fromStringtoMemory(DamageSettingsDatabaseOUT, input_mods_table.damage_type))
    writeFloat(target_address   + 0x10, input_mods_table.inner_radius)
    writeFloat(target_address   + 0x14, input_mods_table.outer_radius)
    writeFloat(target_address   + 0x18, input_mods_table.stagger_radius)
    writeFloat(target_address   + 0x1C, input_mods_table.cone_angle)
    writeFloat(target_address   + 0x20, input_mods_table.camera_shake_radius)
    writeQword(target_address   + 0x38, input_mods_table.particle_effect_path)
    writeInteger(target_address + 0x40, input_mods_table.audio_event)
    writeInteger(target_address + 0x44, input_mods_table.crater_type)
    writeInteger(target_address + 0x48, input_mods_table.surface_impact_type)
    writeInteger(target_address + 0x4C, fromStringtoMemory(HitEffectDamageTemplateDatabaseOUT, input_mods_table.hit_effect_damage_type))
    writeInteger(target_address + 0x50, input_mods_table.num_shrapnel_proj)
    writeInteger(target_address + 0x54, fromStringtoMemory(ProjectileSettingsDatabaseOUT, input_mods_table.shrapnel_projtype))
    writeInteger(target_address + 0x58, fromStringtoMemory(NoiseTemplateDatabaseOUT, input_mods_table.noise_template))
    writeInteger(target_address + 0x5C, fromStringtoMemory(WindEffectTemplateDatabaseOUT, input_mods_table.wind_effect_template))
    writeInteger(target_address + 0x60, fromStringtoMemory(FireTemplateDatabaseOUT, input_mods_table.fire_template))
    writeInteger(target_address + 0x64, fromStringtoMemory(StatusEffectVolumeDatabaseOUT, input_mods_table.persistent_status_volume))
    writeFloat(target_address   + 0x68, input_mods_table.status_volume_effect_time)
    writeInteger(target_address + 0x6C, input_mods_table.status_volume_effect_audio_play)
    writeInteger(target_address + 0x70, input_mods_table.status_volume_effect_audio_stop)
    writeBytes_74(target_address + 0x74, input_mods_table)
    writeInteger(target_address + 0x78, fromStringtoMemory(ArcSettingsDatabaseOUT, input_mods_table.arc_type_on_explosion))
    writeInteger(target_address + 0x7C, input_mods_table.unknown_7C)
    writeFloat(target_address   + 0x80, input_mods_table.unknown_80)
    writeInteger(target_address + 0x84, input_mods_table.unknown_84)
    writeFloat(target_address   + 0x88, input_mods_table.unknown_88)
    writeInteger(target_address + 0x8C, input_mods_table.unknown_8C)
    writeInteger(target_address + 0x90, input_mods_table.unknown_90)
    writeInteger(target_address + 0x94, input_mods_table.unknown_94)
end


-- //! =========================================================================
-- //!  ==============    E X P L O S I V E    C O M P D A T A    ==============
-- //! =========================================================================


function Apply_Explosions_Modifications(target_data)
    local target_address = target_data.address
    --//* ======================================================================
    --//* =============          Bytes: [0x000, 0x017]           ===============
    --//* ======================================================================
    writeInteger(target_address + 0x000, fromStringtoMemory(ExplosiveModeDatabaseOUT,  target_data.explosive_mode))
    writeInteger(target_address + 0x004, fromStringtoMemory(RaycastTemplateDatabaseOUT,  target_data.collision_raycast_filter))
    writeFloat(target_address   + 0x008, target_data.arming_delay)
    writeFloat(target_address   + 0x00C, target_data.explosion_delay)
    writeFloat(target_address   + 0x010, target_data.removal_delay)
    writeByte(target_address    + 0x014, target_data.start_active)
    writeByte(target_address    + 0x015, target_data.hide_on_explosion)
    writeByte(target_address    + 0x016, target_data.destroy_actor_on_explosion)
    writeByte(target_address    + 0x017, target_data.ignore_friendly_fire)
    --//* ======================================================================
    --//* =============          Bytes: [0x020, 0x000]           ===============
    --//* ======================================================================
    writeFloat(target_address   + 0x01C, target_data.impact_distance)
    writeFloat(target_address   + 0x020, target_data.impact_airburst_distance)
    writeInteger(target_address + 0x024, fromStringtoMemory(ExplosionSettingsDatabaseOUT,  target_data.explosion_type))
    writeInteger(target_address + 0x028, fromStringtoMemory(ExplosionSettingsDatabaseOUT,  target_data.impact_explosion_type))
    writeInteger(target_address + 0x0FC, fromStringtoMemory(StatusEffectVolumeDatabaseOUT, target_data.status_template.template_type))
    writeInteger(target_address + 0x100, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.status_template.eff1_type))
    writeFloat(target_address   + 0x104, target_data.status_template.eff1_time)
    writeInteger(target_address + 0x108, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.status_template.eff2_type))
    writeFloat(target_address   + 0x10C, target_data.status_template.eff2_time)
    writeInteger(target_address + 0x110, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.status_template.eff3_type))
    writeFloat(target_address   + 0x114, target_data.status_template.eff3_time)
    writeInteger(target_address + 0x118, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.status_template.eff4_type))
    writeFloat(target_address   + 0x11C, target_data.status_template.eff4_time)
    writeFloat(target_address   + 0x124, target_data.status_template.lifetime)
    writeInteger(target_address + 0x128, target_data.status_template.trigger_volume_node_name)
    writeFloat(target_address   + 0x12C, target_data.status_template.inner_radius)
    writeFloat(target_address   + 0x130, target_data.status_template.outer_radius)
    writeByte(target_address    + 0x13C, target_data.explode_on_death)
    writeInteger(target_address + 0x148, target_data.on_armed_ability)
end



