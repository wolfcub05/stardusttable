                              <Description>"Scope Types"</Description>
                              <Options moManualExpandCollapse="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
                              <LastState/>
                              <Color>00FF00</Color>
                              <VariableType>Auto Assembler Script</VariableType>
                              <AssemblerScript>[ENABLE]
{
  Game   : helldivers2.exe
  Version: 1.700.101
  Date   : 2026-09-25
  Author : MIAUSISI || PRODIHUE
}
{$lua}
function Read_Custom_Scope(input_offset, has_offset, has_both)
    local base_addr   = GetEntityDeltasBaseAddr()
    local target_addr = base_addr + input_offset
    fullAccess(target_addr, 0x75)
    local custom_template = {
        address           = target_addr,
        has_offset        = has_offset,
        has_both       	  = has_both,
        aim_zoomx 	  = readFloat(target_addr + 0x000),
        aim_zoomy 	  = readFloat(target_addr + 0x004),
        aim_zoomz 	  = readFloat(target_addr + 0x008)}
    if has_offset == true then
        custom_template["scope_offsetx"] = readFloat(target_addr + 0x00C)
        custom_template["scope_offsety"] = readFloat(target_addr + 0x010)
        custom_template["scope_offsetz"] = readFloat(target_addr + 0x014)
    end
    if has_both == true then
        custom_template["zeroingx"] = readFloat(target_addr + 0x00C)
        custom_template["zeroingy"] = readFloat(target_addr + 0x010)
        custom_template["zeroingz"] = readFloat(target_addr + 0x014)
        custom_template["scope_offsetx"] = readFloat(target_addr + 0x059)
        custom_template["scope_offsety"] = readFloat(target_addr + 0x05D)
        custom_template["scope_offsetz"] = readFloat(target_addr + 0x061)
   end
    return {backup = deepcopy(custom_template), DATA = deepcopy(custom_template)}
end

function Apply_Custom_Scope(target_data)
    local target_address = target_data.address
    local has_offset     = target_data.has_offset
    local has_both       = target_data.has_both
    writeFloat(target_address + 0x000, target_data.aim_zoomx)
    writeFloat(target_address + 0x004, target_data.aim_zoomy)
    writeFloat(target_address + 0x008, target_data.aim_zoomz)
    if has_offset == true then
        writeFloat(target_address + 0x00C, target_data.scope_offsetx)
        writeFloat(target_address + 0x010, target_data.scope_offsety)
        writeFloat(target_address + 0x014, target_data.scope_offsetz)
    end
    if has_both == true then
        writeFloat(target_address + 0x00C, target_data.zeroingx)
        writeFloat(target_address + 0x010, target_data.zeroingy)
        writeFloat(target_address + 0x014, target_data.zeroingz)
        writeFloat(target_address + 0x059, target_data.scope_offsetx)
        writeFloat(target_address + 0x05D, target_data.scope_offsety)
        writeFloat(target_address + 0x061, target_data.scope_offsetz)
   end
end

