{$lua}
-- //! =========================================================================
--                           Status Effect Receiver Component Data
-- //! =========================================================================
function createStatusEffectSusceptibilityEffect(address)
    local effects = {}
    for i = 0, 6 do
        local effect_address = address + (i * 0x10)
        table.insert(effects, {
            particle_effect_path = string.format("%u", readQword(effect_address + 0x0)), -- // Assuming it's a pointer to a string
            node_id = readInteger(effect_address + 0x8) -- // Assuming it's an integer ID
        })
    end
    return effects
end

function createStatusEffectSusceptibilityStruct(address)
    return {
        effects = createStatusEffectSusceptibilityEffect(address + 0x0),
        type = readInteger(address + 0x8C), -- // Enum value
        min_threshold = readFloat(address + 0x90),
        max_threshold = readFloat(address + 0x94),
        audio_event_start = readInteger(address + 0x98), -- // Assuming it's an integer ID
        audio_event_stop = readInteger(address + 0x9C), -- // Assuming it's an integer ID
        animation_event_start = readInteger(address + 0xA0), -- // Assuming it's an integer ID
        animation_event_stop = readInteger(address + 0xA4), -- // Assuming it's an integer ID
        damage_multiplier = readFloat(address + 0xA8),
        additional_multiplier = readFloat(address + 0xAC)
    }
end

function createStatusEffectZoneStruct(address)
    local zones = {}
    -- // 8 zone items, 32 susceptibilities items
    for i = 0, 7 do
        local zone_address = address + (i * 0x16B8)
        damageable_zone_name = readInteger(zone_address + 0x0) -- // Assuming it's an integer ID
        effect_node_name = readInteger(zone_address + 0x4) -- // Assuming it's an integer ID
        susceptibilities = {}
        for j = 0, 31 do
            local susceptibility_address = zone_address + 0x8 + (j * 0xB0)
            local susceptibility = createStatusEffectSusceptibilityStruct(susceptibility_address)
            table.insert(susceptibilities, susceptibility)

            -- // Optimization: once None appears, remaining entries are also None.
            if susceptibility.type == 0 then
                break
            end
        end
        table.insert(zones, {
            damageable_zone_name = damageable_zone_name,
            effect_node_name = effect_node_name,
            susceptibilities = susceptibilities
        })
    end
    return zones
end


function createStatusEffectResistanceStruct(address)
    return {
        type = readInteger(address + 0x0), -- // Enum value
        duration_scale = readFloat(address + 0x4)
    }
end


function createStatusEffectReceiverStruct(address)
    local init_address = address
    local output_dict = {
        address = init_address,
        zones = createStatusEffectZoneStruct(init_address + 0x0000),
        volume_query_node_name = readInteger(init_address + 0xB5C0), -- // Assuming it's an integer ID
        volume_query_size_radius = readFloat(init_address + 0xB5C4),
        status_effect_resistances = {
            [1] = createStatusEffectResistanceStruct(init_address + 0xB5C8),
            [2] = createStatusEffectResistanceStruct(init_address + 0xB5D0),
            [3] = createStatusEffectResistanceStruct(init_address + 0xB5D8),
            [4] = createStatusEffectResistanceStruct(init_address + 0xB5E0),
            [5] = createStatusEffectResistanceStruct(init_address + 0xB5E8),
            [6] = createStatusEffectResistanceStruct(init_address + 0xB5F0),
            [7] = createStatusEffectResistanceStruct(init_address + 0xB5F8),
            [8] = createStatusEffectResistanceStruct(init_address + 0xB600)
        }
    }
    return output_dict
end

function locateStatusEffectReceiverAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "stteff_receiver"
    local struct_size = 0xB608
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_StatusEffectReceiver_Data(target_unique_id)
    local target_info    = locateStatusEffectReceiverAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = createStatusEffectReceiverStruct(target_address)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end
