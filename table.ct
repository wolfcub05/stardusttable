            max_time_repositioning = readFloat(target_address + 0x0B4),
            max_flank_reposition_angle = readFloat(target_address + 0x0B8),
            min_distance           = readFloat(target_address + 0x0BC),
            max_distance           = readFloat(target_address + 0x0C0),
            allow_abilities        = readInteger(target_address  + 0x0C4),
        },
        target_minimum_distance             = readFloat(target_address + 0x0C8),
        target_maximum_distance             = readFloat(target_address + 0x0CC),
        target_preferred_distance           = readFloat(target_address + 0x0D0),
        target_minimum_distance_secondary   = readFloat(target_address + 0x0D4),
        target_maximum_distance_secondary   = readFloat(target_address + 0x0D8),
        target_preferred_distance_secondary = readFloat(target_address + 0x0DC),
        combat_navigation_agent_type        = readInteger(target_address  + 0x0E4),
        rotate_target_intercept_time        = readFloat(target_address + 0x0E8),
        time_until_reengagement             = readFloat(target_address + 0x0EC),
        rotate_toward_target                = readByte(target_address + 0x0F0),
        follow_squad_leader                 = readByte(target_address + 0x0F1),
    }
    --//! ===================== Offsets: 0x0F4 - 0x13C =========================
    output_template["retreat"] = {
        movement = {
            speed          = readFloat(target_address + 0x0F4),
            locomotion_set = readInteger(target_address  + 0x0F8),
        },
        retreat_distance = readFloat(target_address + 0x104),
        max_retreat_time = readFloat(target_address + 0x108),
        ability_target_distance = readFloat(target_address + 0x110),
    }
    output_template["charge"] = {
        movement = {
            speed          = readFloat(target_address + 0x114),
            locomotion_set = readInteger(target_address  + 0x118),
        },
        acceleration                  = readFloat(target_address + 0x124),
        turn_rate_interpolation_speed = readFloat(target_address + 0x128),
        charge_angle     = readFloat(target_address + 0x12C),
        passed_stop_time = readFloat(target_address + 0x130),
        lock_rotation_distance = readFloat(target_address + 0x138),
    }

    --//! ===================== Offsets: 0x1D4 - 0x214 =========================
    output_template["flank"] = {
