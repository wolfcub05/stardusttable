{$lua}


function Apply_HiveMind_Data(target_data)
    local target_address = target_data.address

    --//! ===================== Offsets: 0x000 - 0x010 =========================
    writeInteger(target_address + 0x004, target_data.max_encounters_members_to_remove)
    writeFloat(target_address   + 0x008, target_data.selected_encounter_member_weight_multiplier)
    writeFloat(target_address   + 0x00C, target_data.traveler_settings.minimum_spawn_point_cooldown)
    writeFloat(target_address   + 0x010, target_data.traveler_settings.maximum_spawn_point_cooldown)

    --//! ===================== Offsets: 0x074 - 0x084 =========================
    writeFloat(target_address + 0x074, target_data.starting_time_limit)
    writeFloat(target_address + 0x078, target_data.forced_encounter_point_amount)
    writeFloat(target_address + 0x07C, target_data.forced_encounter_enemy_cap)
    writeFloat(target_address + 0x080, target_data.encounter_enemy_cap_multiplier)
    writeFloat(target_address + 0x084, target_data.patrol_spawn_duration_multiplier)

    --//! ===================== Offsets: 0x0E0 - 0x124 =========================
    local mds = target_data.mission_difficulty_settings
    local influence = mds.influence_settings
    local extraction = mds.extraction_settings

    writeFloat(target_address + 0x0E0, influence.encounter_points_modifier.min_max.x)
    writeFloat(target_address + 0x0E4, influence.encounter_points_modifier.min_max.y)
    writeFloat(target_address + 0x0E8, influence.encounter_points_modifier.fallout_distance)

    writeFloat(target_address + 0x0EC, influence.encounter_cooldown_rate_modifier.min_max.x)
    writeFloat(target_address + 0x0F0, influence.encounter_cooldown_rate_modifier.min_max.y)
    writeFloat(target_address + 0x0F4, influence.encounter_cooldown_rate_modifier.fallout_distance)

    writeFloat(target_address + 0x0F8, influence.patrol_spawn_cooldown_rate_modifier.min_max.x)
    writeFloat(target_address + 0x0FC, influence.patrol_spawn_cooldown_rate_modifier.min_max.y)
    writeFloat(target_address + 0x100, influence.patrol_spawn_cooldown_rate_modifier.fallout_distance)

    writeFloat(target_address + 0x104, extraction.encounter_points_modifier.min_max.x)
    writeFloat(target_address + 0x108, extraction.encounter_points_modifier.min_max.y)
    writeFloat(target_address + 0x10C, extraction.encounter_points_modifier.fallout_distance)

    writeFloat(target_address + 0x110, extraction.encounter_cooldown_rate_modifier.min_max.x)
    writeFloat(target_address + 0x114, extraction.encounter_cooldown_rate_modifier.min_max.y)
    writeFloat(target_address + 0x118, extraction.encounter_cooldown_rate_modifier.fallout_distance)

    writeFloat(target_address + 0x11C, extraction.patrol_spawn_cooldown_rate_modifier.min_max.x)
    writeFloat(target_address + 0x120, extraction.patrol_spawn_cooldown_rate_modifier.min_max.y)
    writeFloat(target_address + 0x124, extraction.patrol_spawn_cooldown_rate_modifier.fallout_distance)

    --//! ===================== Offsets: 0x128 - 0x214 =========================
    local function write_modifier_block(base_offset, modifier)
        writeFloat(target_address + base_offset + 0x000, modifier.mission_progression_step_multipliers[1])
        writeFloat(target_address + base_offset + 0x004, modifier.mission_progression_step_multipliers[2])
        writeFloat(target_address + base_offset + 0x008, modifier.mission_progression_step_multipliers[3])
        writeFloat(target_address + base_offset + 0x00C, modifier.mission_progression_step_multipliers[4])
        writeFloat(target_address + base_offset + 0x010, modifier.mission_progression_step_multipliers[5])

        writeFloat(target_address + base_offset + 0x014, modifier.player_count_multipliers[1])
        writeFloat(target_address + base_offset + 0x018, modifier.player_count_multipliers[2])
        writeFloat(target_address + base_offset + 0x01C, modifier.player_count_multipliers[3])
        writeFloat(target_address + base_offset + 0x020, modifier.player_count_multipliers[4])

        writeFloat(target_address + base_offset + 0x024, modifier.extraction_available_multiplier)

        writeFloat(target_address + base_offset + 0x028, modifier.unknown_floats[1])
        writeFloat(target_address + base_offset + 0x02C, modifier.unknown_floats[2])
        writeFloat(target_address + base_offset + 0x030, modifier.unknown_floats[3])
        writeFloat(target_address + base_offset + 0x034, modifier.unknown_floats[4])
        writeFloat(target_address + base_offset + 0x038, modifier.unknown_floats[5])
    end

    write_modifier_block(0x128, mds.encounter_points_modifier)
    write_modifier_block(0x164, mds.encounter_cooldown_rate_modifier)
    write_modifier_block(0x1A0, mds.patrol_count_max_modifier)
    write_modifier_block(0x1DC, mds.patrol_spawn_cooldown_rate_modifier)
    write_modifier_block(0x218, mds.spawner_queue_limit_modifier)
    write_modifier_block(0x254, mds.spawner_production_cooldown_rate_modifier)
    write_modifier_block(0x290, mds.spawner_spawn_count_modifier)
    write_modifier_block(0x2CC, mds.spawner_spawn_count_minimum_modifier)
    write_modifier_block(0x308, mds.spawner_spawn_cooldown_rate_modifier)
    write_modifier_block(0x344, mds.guard_force_member_count_max_modifier)
    write_modifier_block(0x380, mds.global_spawner_cooldown_modifier)
    write_modifier_block(0x3BC, mds.travelers_waves_cooldown_multiplier)
    write_modifier_block(0x3F8, mds.travelers_max_unit_count_multiplier)

    --//! ===================== Offsets: 0x434 - 0x437 =========================
    writeByte(target_address + 0x434, mds.unknown_434)
    writeByte(target_address + 0x435, mds.unknown_435)
    writeByte(target_address + 0x436, mds.unknown_436)
    writeByte(target_address + 0x437, mds.unknown_437)
end
