-- //! =========================================================================
-- //!                    Apply Warp Pack CompData Modifications
-- //! =========================================================================

function Apply_Warppack_Modifications(target_data)
    local target_address = target_data.address
    writeInteger(target_address + 0x038, fromStringtoMemory(ExplosionSettingsDatabaseOUT, target_data.explosion_type))
    writeFloat(target_address   + 0x04C, target_data.warp_usage_delay)
    writeFloat(target_address   + 0x078, target_data.warp_forward_distance)
    writeFloat(target_address   + 0x080, target_data.warp_upward_distance)
    writeFloat(target_address   + 0x084, target_data.warp_downward_distance)
    writeFloat(target_address   + 0x08C, target_data.warp_charge_safe_usage)
    writeFloat(target_address   + 0x090, target_data.explosion_threshold)
    writeFloat(target_address   + 0x094, target_data.heat_gained_per_use)
    writeFloat(target_address   + 0x098, target_data.heat_decay_rate)
end


