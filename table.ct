-- //! =========================================================================
--                           Sensor Eye Component Data
-- //! =========================================================================

function locateSensorEyeAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "SensorEye"
    local struct_size = 0x02C
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_SensorEye_Data(target_unique_id)
    local target_info    = locateSensorEyeAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        }
        output_template["distance"]            = readFloat(target_address + 0x000)
        output_template["peripheral_distance"] = readFloat(target_address + 0x004)
        output_template["back_distance"]       = readFloat(target_address + 0x008)
        output_template["angle_horizontal"]    = readFloat(target_address + 0x00C)
        output_template["angle_vertical"]      = readFloat(target_address + 0x010)
        output_template["sight_node"]                     = readInteger(target_address + 0x014)
        output_template["use_sight_node_for_direction"]   = readInteger(target_address + 0x018)
        output_template["vision_raycast_template"]        = readInteger(target_address + 0x01C)
        output_template["eye_type"]                       = readInteger(target_address + 0x020)
        output_template["ignore_inside_foliage_distance"] = readFloat(target_address   + 0x024)
        output_template["inside_foliage_distance"]        = readFloat(target_address   + 0x028)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


