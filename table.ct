-- //! =========================================================================
-- //!  =================         SPECIAL   FUNCTIONS        ===================
-- //! =========================================================================



function writeBytes_F0(target_address, target_settings)
    local byte_F0_list = {
        [1]  = target_settings.look_for_audio_source_hijack,
        [2]  = target_settings.allow_long_distance_travel,
        [3]  = target_settings.can_pass_through_shield,
        [4]  = target_settings.hit_only_ground,
        [5]  = target_settings.audio_danger_zone,
        [6]  = target_settings.global_audio,
        [7]  = target_settings.project_decal,
        [8]  = target_settings.explosions_inherit_velocity,
        [9]  = target_settings.projectile_unit_auto_remove,
        [10] = target_settings.remove_trail_effect_instantly,
        [11] = target_settings.remove_thruster_effect_instantly,
        [12] = target_settings.ignore_terminal_velocity,
        [13] = target_settings.inherit_velocity,
    }
    local value = ""
    for i = 1, #byte_F0_list do
        if byte_F0_list[i] &gt; 1 then
            byte_F0_list[i] = 1
        elseif byte_F0_list[i] &lt; 0 then
            byte_F0_list[i] = 0
        end
        local digit = string.format("%d", byte_F0_list[i])
        value = value .. digit
    end
    --// Return the integer value
    writeInteger(target_address + 0x0F0, tonumber(value, 2))
end

function writeBytes_FC(target_address, target_settings)
    local byte_FC_list = {
        [1]  = target_settings.projectile_auto_attach,
        [2]  = target_settings.apply_stim_on_target
    }
    local value = ""
    for i = 1, #byte_FC_list do
        if byte_FC_list[i] &gt; 1 then
            byte_FC_list[i] = 1
        elseif byte_FC_list[i] &lt; 0 then
            byte_FC_list[i] = 0
        end
        local digit = string.format("%d", byte_FC_list[i])
        value = value .. digit
    end
    --// Return the integer value
    writeInteger(target_address + 0x0FC, tonumber(value, 2))
end



