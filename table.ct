function Apply_AiCharacter_Data(target_data)
    local target_address = target_data.address
    --//! =====================================================================
    writeFloat(target_address + 0x000, target_data.preferred_speed)
    writeFloat(target_address + 0x004, target_data.maximum_speed)
    writeFloat(target_address + 0x008, target_data.fire_avoidance)
    writeFloat(target_address + 0x00C, target_data.boids_cohesion_strength)
    writeFloat(target_address + 0x010, target_data.boids_optimal_distance)
    writeFloat(target_address + 0x014, target_data.boids_view_radius)
    writeByte(target_address + 0x018, target_data.unknown_018)
    writeByte(target_address + 0x019, target_data.unknown_019)
    writeByte(target_address + 0x01A, target_data.unknown_01A)
    writeByte(target_address + 0x01B, target_data.unknown_01B)
end

