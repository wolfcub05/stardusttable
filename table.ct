{$lua}

-- //! =========================================================================
--                           Detector Component Data
-- //! =========================================================================

function locateDetectorAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "Detector"
    local struct_size = 0x18
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_Detector_Data(target_unique_id)
    local target_info    = locateDetectorAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        }
    output_template["detect_time_min"]                = readFloat(target_address + 0x000)
    output_template["detect_time_max"]                = readFloat(target_address + 0x004)
    output_template["noise_removal_time"]             = readFloat(target_address + 0x008)
    output_template["vision_intensity_rate"]          = readFloat(target_address + 0x00C)
    output_template["vision_intensity_decay"]         = readFloat(target_address + 0x010)
    output_template["avatar_always_enemy"]            = readByte(target_address  + 0x014)
    output_template["unknown_015"]                    = readByte(target_address  + 0x015)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end




