-- //! =========================================================================
-- //!  ==============    E X P L O S I V E    S E T T I N G S    ==============
-- //! =========================================================================

--// ============    Get Explosions Settings Address
function getAddressExplosionSettings(target_id)
    local struct_size = 0x98
    local output_addr = AddressHandler(target_id, "explosions", struct_size)
    return output_addr
end


function Read_ExplosiveSettings_Data(explosion_str)
    local explosion_idx  = readIndexedString(ExplosionSettingsDatabaseOUT, explosion_str)
    local target_address = getAddressExplosionSettings(explosion_idx)
    local output_template = {
        address        = target_address,
        target_id      = explosion_idx,
        enum_explosion         = readInteger(target_address + 0x00),
        damage_type            = readInteger(target_address + 0x04),
        inner_radius           = readFloat(target_address   + 0x10),
        outer_radius           = readFloat(target_address   + 0x14),
        stagger_radius         = readFloat(target_address   + 0x18),
        cone_angle             = readFloat(target_address   + 0x1C),
        camera_shake_radius    = readFloat(target_address   + 0x20),
        particle_effect_path   = readQword(target_address   + 0x38),
        audio_event            = readInteger(target_address + 0x40),
        crater_type            = readInteger(target_address + 0x44),
        surface_impact_type    = readInteger(target_address + 0x48),
        hit_effect_damage_type = readInteger(target_address + 0x4C),
        num_shrapnel_proj      = readInteger(target_address + 0x50),
        shrapnel_projtype      = readInteger(target_address + 0x54),
        noise_template         = readInteger(target_address + 0x58),
        wind_effect_template            = readInteger(target_address + 0x5C),
        fire_template                   = readInteger(target_address + 0x60),
        persistent_status_volume        = readInteger(target_address + 0x64),
        status_volume_effect_time       = readFloat(target_address   + 0x68),
        status_volume_effect_audio_play = readInteger(target_address + 0x6C),
        status_volume_effect_audio_stop = readInteger(target_address + 0x70)
    }
    byteprep_74 =  readInt_bin13digits(target_address + 0x074)
    output_template.do_knockback                   = tonumber(byteprep_74:sub(1, 1))
    output_template.requires_raycast_confirmation  = tonumber(byteprep_74:sub(2, 2))
    output_template.disable_default_surface_impact = tonumber(byteprep_74:sub(3, 3))
    output_template.is_huge_explosion              = tonumber(byteprep_74:sub(4, 4))
    output_template.look_for_audio_source_hijack   = tonumber(byteprep_74:sub(5, 5))
    output_template.unknown_074_6thflag            = tonumber(byteprep_74:sub(6, 6))
    output_template.arc_type_on_explosion          = readInteger(target_address + 0x78)
    output_template.unknown_7C                     = readInteger(target_address + 0x7C)
    output_template.unknown_80                     = readFloat(target_address   + 0x80)
    output_template.unknown_84                     = readInteger(target_address + 0x84)
    output_template.unknown_88                     = readFloat(target_address   + 0x88)
    output_template.unknown_8C                     = readInteger(target_address + 0x8C)
    output_template.unknown_90                     = readInteger(target_address + 0x90)
    output_template.unknown_94                     = readInteger(target_address + 0x94)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

-- //! =========================================================================
-- //!  ==============    E X P L O S I V E    C O M P D A T A    ==============
-- //! =========================================================================


--// ============    Get Explosions CompData UID Address
function locateExplosionsComponentAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "explosions"
    local struct_size = 0x168
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_Explosions_Data(target_unique_id)
    local target_info = locateExplosionsComponentAddress(target_unique_id)
    local target_id   = target_info.idx
    local target_addr = target_info.address
    local output_template = {
        idx                = target_id,
        address            = target_addr,
        --//* ======================================================================
        --//* =============          Bytes: [0x000, 0x017]           ===============
        --//* ======================================================================
        explosive_mode           = readInteger(target_addr + 0x000),
        collision_raycast_filter = readInteger(target_addr + 0x004),
        arming_delay             = readFloat(target_addr   + 0x008),
        explosion_delay          = readFloat(target_addr   + 0x00C),
        removal_delay            = readFloat(target_addr   + 0x010),
        start_active                = readByte(target_addr + 0x014),
        hide_on_explosion           = readByte(target_addr + 0x015),
        destroy_actor_on_explosion  = readByte(target_addr + 0x016),
        ignore_friendly_fire        = readByte(target_addr + 0x017),
        --//* ======================================================================
        --//* =============          Bytes: [0x020, 0x000]           ===============
        --//* ======================================================================
        impact_distance          = readFloat(target_addr   + 0x01C),
        impact_airburst_distance = readFloat(target_addr   + 0x020),
        explosion_type           = readInteger(target_addr + 0x024),
        impact_explosion_type    = readInteger(target_addr + 0x028),
        status_template = {
            template_type = readInteger(target_addr + 0x0FC),
            eff1_type     = readInteger(target_addr + 0x100),
            eff1_time     = readFloat(target_addr   + 0x104),
            eff2_type     = readInteger(target_addr + 0x108),
            eff2_time     = readFloat(target_addr   + 0x10C),
            eff3_type     = readInteger(target_addr + 0x110),
            eff3_time     = readFloat(target_addr   + 0x114),
            eff4_type     = readInteger(target_addr + 0x118),
            eff4_time     = readFloat(target_addr   + 0x11C),
            lifetime      = readFloat(target_addr   + 0x124),
            trigger_volume_node_name = readInteger(target_addr + 0x128),
            inner_radius  = readFloat(target_addr   + 0x12C),
            outer_radius  = readFloat(target_addr   + 0x130)
        },
        explode_on_death = readByte(target_addr     + 0x13C),
        on_armed_ability = readInteger(target_addr  + 0x148)
    }
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

