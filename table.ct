}
{$lua}

function Apply_Passive_Modifications(input_data)
    local target_address = getAddress(input_data.address)
    if target_address == "0x0000000000000000" then
        return
    end
    if input_data.passive_name == "HelldiverCustomizationPassiveBonus_Armor_Hero" then
        if input_data.passives[1].mod_value &gt; 100.0 then
            input_data.passives[1].mod_value = 2.0
        elseif input_data.passives[1].mod_value &lt; 0.0 then
            input_data.passives[1].mod_value = 1.5
        else
            input_data.passives[1].mod_value = input_data.passives[1].mod_value/100.0 + 1.0
        end
    end

    if input_data.offset == "HelldiverCustomizationPassiveBonus_Armor_SiegeBreaker" then
        writeFloat(target_address + 0x60, input_data.passives[1].mod_value)
        writeFloat(target_address + 0x6C, input_data.passives[2].mod_value)
    end

    if input_data.offset == "HelldiverCustomizationPassiveBonus_Armor_ReinforcedEpaulettes" then
        writeFloat(target_address + 0x70, input_data.passives[1].mod_value)
    end

    if input_data.offset == "HelldiverCustomizationPassiveBonus_Armor_Gunslinger" then
        writeFloat(target_address + 0x70, input_data.passives[1].mod_value)
        writeFloat(target_address + 0x7C, input_data.passives[2].mod_value)
        writeFloat(target_address + 0x88, input_data.passives[3].mod_value)
    end


    for i = 1, input_data.num_pass do
        local mod_offset = 0x38 + (i - 1) * 0x10
        writeInteger(target_address + mod_offset,        input_data.passives[i].mod_id)
        writeInteger(target_address + mod_offset + 0x04, input_data.passives[i].mod_type)
        writeFloat(target_address   + mod_offset + 0x08, input_data.passives[i].mod_value)
        writeInteger(target_address + mod_offset + 0x0C, input_data.passives[i].mod_desc)
    end
end
