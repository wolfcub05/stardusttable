{$lua}
local function writeBytes_78(target_address, target_settings)
    local tempSetting = target_settings["call_in_logic_flags"]
    local byte_78_list = {
        [1]  = tempSetting.unknown_08 or tempSetting.Available_After_Mission_End,
        [2]  = tempSetting.unknown_07 or tempSetting.unknown_8_yes_for_hellbomb,
        [3]  = tempSetting.unknown_06 or tempSetting.Blocked_by_Stratagem_Blocker,
        [4]  = tempSetting.unknown_05 or tempSetting.Host_Confirm_Objective_Stratagem_Usage,
        [5]  = tempSetting.unknown_04 or tempSetting.Host_Confirm_Unique_Instance,
        [6]  = tempSetting.unknown_03 or tempSetting.Host_Confirmation,
        [7]  = tempSetting.unknown_02 or tempSetting.Objective_Owner,
        [8]  = tempSetting.unknown_01 or tempSetting.unknown_02,
        [9]  = tempSetting.unknown_00 or tempSetting.Use_Objective_Position,
    }
    local value = ""
    for i = 1, #byte_78_list do
        if byte_78_list[i] &gt; 1 then
            byte_78_list[i] = 1
        elseif byte_78_list[i] &lt; 0 then
            byte_78_list[i] = 0
        end
        local digit = string.format("%d", byte_78_list[i])
        value = value .. digit
    end
    --// Return the integer value
    writeInteger(target_address, tonumber(value, 2))
end

local function writeBytes_180(target_address, target_settings)
    local byte_180_list = {
        [1]  = target_settings.deploy_on_navmesh_only,
        [2]  = target_settings.allow_for_button_overlap
    }
    local value = ""
    for i = 1, #byte_180_list do
        if byte_180_list[i] &gt; 1 then
            byte_180_list[i] = 1
        elseif byte_180_list[i] &lt; 0 then
            byte_180_list[i] = 0
        end
        local digit = string.format("%d", byte_180_list[i])
        value = value .. digit
    end
    --// Return the integer value
    writeInteger(target_address, tonumber(value, 2))
end


function Apply_Stratagems_Modifications(target_settings)
    local target_address = target_settings.address
    writeInteger(target_address   + 0x03C, fromStringtoMemory(StratagemCategoryTypeDatabaseOUT, target_settings.category))
    writeInteger(target_address   + 0x050, target_settings.uses)
    writeFloat(target_address     + 0x054, target_settings.spawn_time)
    writeFloat(target_address     + 0x058, target_settings.spawn_radius)
    writeFloat(target_address     + 0x05C, target_settings.unknown_05C)
    writeFloat(target_address     + 0x060, target_settings.beacon_linger_time)
    writeFloat(target_address     + 0x064, target_settings.extra_travel_time)
    writeFloat(target_address     + 0x068, target_settings.cd_success)
    writeFloat(target_address     + 0x06C, target_settings.cd_fail)
    writeInteger(target_address   + 0x074, fromStringtoMemory(StratagemCallInTypeDatabaseOUT, target_settings.call_in_type))
    writeBytes_78(target_address  + 0x078, target_settings)
    writeInteger(target_address   + 0x090, target_settings.triggers_war)
    writeInteger(target_address   + 0x0BC, target_settings.cost)
    writeInteger(target_address   + 0x0C0, target_settings.enabled)
    --writeInteger(target_address   + 0x0CC, target_settings.Max_in_Loadout)
    writeBytes_180(target_address + 0x170, target_settings)

end

