{$lua}
-- //! =========================================================================
-- //! ==================              T A G S            ======================
-- //! =========================================================================

function locateTagsAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "tag_loadout"
    local struct_size = 0x20
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function getTag(string_tag)
    local tags = {
        LightArmorPen  = 300892437,
        MediumArmorPen = 3085090887,
        HeavyArmorPen  = 658390125,
        OneHanded      = 768786388,
        RoundsReload   = 1501540430,
        Explosive      = 1325312028,
        ChargeUp       = 2297916711,
        LightAntiTank  = 612466998,
        AntiTank       = 3591930318,
        Caustic        = 1865818670,
        Electrocution  = 2287695974,
        Incendiary     = 2783978577,
        Suppressed     = 1933041026,
    }
    local tag = tags[string_tag]
    if tag == nil then
        error("Unknown tag: " .. tostring(string_tag))
    end
    return tag
end

function Read_TagsInfo_Data(target_unique_id)
    local target_info = locateTagsAddress(target_unique_id)
    local target_address = target_info.address
    local tags_template = {
        address = target_address,
        tag1 = readInteger(target_address + 0x00C),
        tag2 = readInteger(target_address + 0x010),
        tag3 = readInteger(target_address + 0x014),
        tag4 = readInteger(target_address + 0x018),
        tag5 = readInteger(target_address + 0x01C),
    }
    return {backup = deepcopy(tags_template), DATA = deepcopy(tags_template)}
end


