{$lua}
needed_auto_heal = false
function CheckSimplePointerStatus()
    local key, val, condition
    for key, val in pairs(simple_pointers) do
        condition = readInteger(readPointer(val))
        if condition == nil then
            print("WARNING: Pointer '" .. key .. "' has changed!\nWill try to 'auto-heal' pointer if possible (results not warranteed)\n")
            needed_auto_heal = true
        end
    end
    if needed_auto_heal == true then
        print("...\nProceeding with Pointer 'auto-heal'\n...")
    end
end


