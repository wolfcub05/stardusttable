+ Less Recoil (17.5x 25y --&gt; 12x 15y)
-- Light armor Penetration (AP3 --&gt; AP2)
- Less Demo force (15 --&gt; 10)
- Less damage (90 --&gt; 60)
- Less durable damage (25 --&gt; 18)
}

aobscanmodule(MovewithMG,game.dll,74 6A 83 7E ? 00)
MovewithMG:
  db EB
registersymbol(MovewithMG)

aobscanmodule(RemoveIntLimit,helldivers2.exe,3B ? 7F ? 41 3B C6 8B F8)

RemoveIntLimit:
  nop 4

registersymbol(RemoveIntLimit)

{$lua}

-- //! ===================   M-1000 Maxigun   ===================
minigun_damage     	= Read_DamageSettings_Data("DamageInfoType_Projectile_Maxigun")
minigun_projectile 	= Read_ProjectileInfo_Data("ProjectileType_Maxigun", 4874456896233937276)
minigun_weaponinfo 	= Read_WeaponInfo_Data(4874456896233937276)
minigun_deposit    	= Read_DepositBackpack_Data(391216982669554238)
minigun_tagsinfo   = Read_TagsInfo_Data(391216982669554238)

-- // ================================================================================



-- // =============== Projectile Damage Settings
minigun_damage.DATA.damage_std = 60 --80
minigun_damage.DATA.damage_drb = 18 --18
minigun_damage.DATA.demolition = 10
minigun_damage.DATA.momentum.stagger = 20
minigun_damage.DATA.momentum.knkback = 25

minigun_weaponinfo.DATA.recoil.x = 12 --17.5
minigun_weaponinfo.DATA.recoil.y = 15 --25
minigun_weaponinfo.DATA.climb.x = 12
minigun_weaponinfo.DATA.climb.y = 15

minigun_projectile.DATA.rpm.y = 2000

Set_ArmorPenetration_Type(minigun_damage, minigun_tagsinfo.DATA, "LightArmorPen")

minigun_damage.DATA.ap_vals.ap1 = 2
minigun_damage.DATA.ap_vals.ap2 = 2
minigun_damage.DATA.ap_vals.ap3 = 2
minigun_damage.DATA.ap_vals.ap4 = 1

-- // =============== WeaponInfo Settings

-- // =============== Deposit Settings
minigun_deposit.DATA.capacity = 1250
minigun_deposit.DATA.init = 1250
minigun_deposit.DATA.refill = 1000


-- // Apply Modifications
Apply_DamageSettings_Modifications(minigun_damage.DATA)
Apply_ProjectileInfo_Modifications(minigun_projectile.DATA)
Apply_WeaponInfo_Modifications(minigun_weaponinfo.DATA)
Apply_DepositBackpack_Modifications(minigun_deposit.DATA)
Apply_TagsInfo_Modifications(minigun_tagsinfo.DATA)

{$asm}
[DISABLE]

MovewithMG:
  db 74
unregistersymbol(MovewithMG)

RemoveIntLimit:
  db 3B C7 7F 09

dealloc(*)
unregistersymbol(*)

{$lua}

Apply_DamageSettings_Modifications(minigun_damage.backup)
Apply_ProjectileInfo_Modifications(minigun_projectile.backup)
Apply_WeaponInfo_Modifications(minigun_weaponinfo.backup)
Apply_DepositBackpack_Modifications(minigun_deposit.backup)
Apply_TagsInfo_Modifications(minigun_tagsinfo.backup)

</AssemblerScript>
