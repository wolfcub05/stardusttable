--------------------------------------------------- pool reverse index
MF.POOL_INDEX = {}
for i, n in ipairs(MF.NODEPOOL) do MF.POOL_INDEX[n] = i end

MF.NODE_IN = {}                 -- pool index -&gt; { skeleton names that use it }
do
  local seen = {}
  for g, raw in pairs(MF.NODEGROUPS_RAW) do
    for i in raw:gmatch("%d+") do
      local key = g .. "\0" .. i
      if not seen[key] then
        seen[key] = true
        local pi = tonumber(i)
        local t = MF.NODE_IN[pi]
        if t == nil then t = {} ; MF.NODE_IN[pi] = t end
        t[#t + 1] = g
      end
    end
  end
end

--------------------------------------------------- index addressing
function MF.at(idx)
  local db = compdata_db[MF.DB]
  if db == nil then return nil end
  return db[(tonumber(idx) or -1) + 1]
end

function MF.indexOf(uidStr)
  for i, u in pairs(compdata_db[MF.DB]) do if u == uidStr then return i - 1 end end
  return nil
end

--------------------------------------------------- tags
MF.tags = MF.tags or {}

function MF.tag(target, name, cat)
  local uid = MF.entityUid(target)
  if name == nil or name == "" then
    local had = MF.tags[uid]
    MF.tags[uid] = nil ; MF.idCache[uid] = nil
    say("[MF] tag removed: " .. uid .. (had and (" (was " .. had.name .. ")") or ""))
    return uid
  end
  if cat == nil or cat == "" then
    local id = MF.identify(uid)
    cat = (MF.tags[uid] and MF.tags[uid].cat) or id.cat or "UNCLASSIFIED"
  end
  MF.tags[uid] = { name = tostring(name), cat = tostring(cat) }
  MF.idCache[uid] = nil
  say(("[MF] tagged %s (idx %s) as %q [%s]")
      :format(uid, tostring(MF.indexOf(uid)), tostring(name), cat))
  return uid
end

function MF.untag(target) return MF.tag(target, nil) end

function MF.listTags()
  local n = 0
  for uid, t in pairs(MF.tags) do
    n = n + 1
    say(("  %-21s idx %-6s %-34s [%s]")
        :format(uid, tostring(MF.indexOf(uid)), t.name, t.cat))
  end
  if n == 0 then say("[MF] no tags yet - MF.tag(\"#42\", \"Some Enemy\", \"AUTOMATONS\")") end
  return n
end

-- tags do not survive a CE restart on their own; keep the string somewhere
function MF.exportTags()
  local parts = { "MFT1" }
  for uid, t in pairs(MF.tags) do
    parts[#parts + 1] = ("%s=%s=%s"):format(uid, (t.name:gsub("[|=]", " ")), (t.cat:gsub("[|=]", " ")))
  end
  local str = table.concat(parts, "|")
  say("[MF] " .. str)
  pcall(function() writeToClipboard(str) ; say("[MF] copied to clipboard") end)
  return str
end

function MF.importTags(str)
  local parts = {}
  for p in tostring(str):gmatch("[^|]+") do parts[#parts + 1] = p end
  if parts[1] ~= "MFT1" then error("MF.importTags: not an MFT1 string", 2) end
  local n = 0
  for i = 2, #parts do
    local uid, name, cat = parts[i]:match("^(%d+)=([^=]*)=(.*)$")
    if uid then MF.tags[uid] = { name = name, cat = cat } ; MF.idCache[uid] = nil ; n = n + 1 end
  end
  say(("[MF] imported %d tag(s)"):format(n))
  return n
end

--------------------------------------------------- identification
MF.idCache = MF.idCache or {}
MF.ID_MIN  = 0.34        -- below this the fingerprint is treated as noise

local function slotSurvey(uidStr)
  local idx = MF.indexOf(uidStr)
  if idx == nil then return nil end
  local addr = values_compdata[MF.DB] + idx * MF.STRUCT
  local nodes, paths = {}, {}
  for i = 1, MF.SLOTS do
    local a = addr + (i - 1) * MF.SLOT
    local ok, pv = pcall(readQword, a)
    if ok and pv ~= nil and pv ~= 0 then
      paths[#paths + 1] = MF.ustr(pv)
      local nd = rdU32(a + 0x08)
      if nd ~= 0 then nodes[#nodes + 1] = nd end
    end
  end
  return nodes, paths, idx
end

-- Guess what an unnamed mount record actually is.
--   * attach nodes are hashed names; 2670 of the 3214 known node names
--     belong to exactly one skeleton, so even one good node is decisive
--   * each node votes 1/(number of skeletons using it), so shared nodes
--     like "root" or "boss" contribute almost nothing
--   * the categories of the things already mounted give a second opinion
-- Many Automaton/Illuminate/Terminid units share ONE skeleton across several
-- loadouts - a Hulk with a Saw, a Flamethrower, or an Autocannon is the same
-- skeleton, so fingerprinting alone only ever says "Hulk". The game names
-- their weapons consistently as "&lt;Unit&gt; &lt;Variant&gt;" ("Hulk Autocannon",
-- "Factory Strider Cannon", "Devastator Shield"), so stripping the known
-- skeleton name off the front of whatever is actually mounted recovers the
-- specific variant without hand-listing every enemy's loadouts.
local function deriveVariant(skeleton, paths)
  if skeleton == nil then return nil end
  local skelLower = skeleton:lower()
  local seen, variants = {}, {}
  for _, p in ipairs(paths) do
    local nm = MF.name(p)
    if nm and nm:lower():sub(1, #skelLower) == skelLower then
      local rest = (nm:sub(#skeleton + 1):gsub("^%s+", ""))
      if rest ~= "" and not seen[rest] then seen[rest] = true ; variants[#variants + 1] = rest end
    end
  end
  if #variants == 0 then return nil end
  table.sort(variants)
  return table.concat(variants, " + ")
end

function MF.identify(target, force)
  local uidStr = (type(target) == "table") and target.uid or MF.entityUid(target)
  if MF.idCache[uidStr] and not force then return MF.idCache[uidStr] end

  local res = { uid = uidStr, alts = {}, conf = 0, usable = 0 }
  local nodes, paths, idx = slotSurvey(uidStr)
  res.idx = idx
  if nodes == nil then MF.idCache[uidStr] = res return res end

  -- 1. skeleton fingerprint
  local score, usable = {}, 0
  for _, id in ipairs(nodes) do
    local nm = MF.NODE_NAME[id]
    local pi = nm and MF.POOL_INDEX[nm]
    local groups = pi and MF.NODE_IN[pi]
    if groups and #groups &gt; 0 then
      usable = usable + 1
      local w = 1 / #groups
      for _, g in ipairs(groups) do score[g] = (score[g] or 0) + w end
    end
  end
  res.usable = usable
  if usable &gt; 0 then
    local ranked = {}
    for g, v in pairs(score) do ranked[#ranked + 1] = { name = g, conf = v / usable } end
    table.sort(ranked, function(a, b)
      if a.conf ~= b.conf then return a.conf &gt; b.conf end
      return a.name &lt; b.name
    end)
    if ranked[1] then
      res.skeleton = ranked[1].name
      res.conf     = ranked[1].conf
      for i = 1, math.min(4, #ranked) do res.alts[i] = ranked[i] end
    end
  end
  if res.skeleton and res.conf &gt;= MF.ID_MIN then
    res.variant = deriveVariant(res.skeleton, paths)
  end

  -- 2. category vote from what is already mounted
  local votes, best, bestN, named = {}, nil, 0, 0
  for _, p in ipairs(paths) do
    local c = MF.cat(p)
    if c then named = named + 1 ; votes[c] = (votes[c] or 0) + 1 end
  end
  for c, n in pairs(votes) do if n &gt; bestN then best, bestN = c, n end end
  res.slotCat, res.slotCatN, res.slotNamed = best, bestN, named

  -- 3. shared word prefix of the mounted weapon names
  local words, seenNamed = nil, 0
  for _, p in ipairs(paths) do
    local nm = MF.name(p)
    if nm then
      seenNamed = seenNamed + 1
      local w = {}
      for tok in nm:gmatch("%S+") do w[#w + 1] = tok end
      if words == nil then words = w
      else
        local keep = {}
        for i = 1, math.min(#words, #w) do
          if words[i] == w[i] then keep[i] = words[i] else break end
        end
        words = keep
      end
    end
  end
  if seenNamed &gt;= 2 and words and #words &gt; 0 then
    res.family = table.concat(words, " ")
  end
  -- With exactly ONE named weapon mounted and no skeleton group at all
  -- (some enemies, e.g. the Hulk, simply are not present in the attach-node
  -- dump), the weapon's own name is usually the best available identifier -
  -- "Hulk Autocannon" already tells you both the unit and its variant.
  if seenNamed == 1 then
    for _, p in ipairs(paths) do
      local nm = MF.name(p)
      if nm then res.singleWeapon = nm break end
    end
  end

  res.cat = (res.skeleton and res.conf &gt;= MF.ID_MIN and MF.SKELETON_CAT[res.skeleton])
            or res.slotCat or "UNCLASSIFIED"
  MF.idCache[uidStr] = res
  return res
end

-- the single answer used everywhere: name, source, category, confidence
function MF.whatIs(uidStr)
  local t = MF.tags[uidStr]
  if t then return t.name, "tagged", t.cat or "UNCLASSIFIED", 1 end
  local e = MF.byUid[uidStr]
  if e then return e.name, "catalog", e.cat, 1 end
  local id = MF.identify(uidStr)
  if id.skeleton and id.conf &gt;= MF.ID_MIN then
    local label = id.variant and (id.skeleton .. " (" .. id.variant .. ")") or id.skeleton
    return "~" .. label, "inferred", id.cat, id.conf
  end
  if id.family then return "~" .. id.family, "family", id.cat, 0.5 end
  if id.singleWeapon then return "~" .. id.singleWeapon, "weapon", id.cat, 0.4 end
  return nil, "unknown", id.cat or "UNCLASSIFIED", 0
end

-- full explanation of how a record was identified
function MF.who(target)
  local uid = MF.entityUid(target)
  local id  = MF.identify(uid, true)
  local nm, src, cat, conf = MF.whatIs(uid)
  say(("\n== %s   (idx %s) =="):format(uid, tostring(id.idx)))
  local t = MF.tags[uid]
  say("  your tag    : " .. (t and (t.name .. "  [" .. t.cat .. "]") or "-"))
  say("  catalog     : " .. (MF.byUid[uid] and (MF.byUid[uid].name .. "  [" .. MF.byUid[uid].cat .. "]") or "not listed"))
  if id.skeleton then
    say(("  skeleton    : %s   (%.0f%% from %d usable attach node(s))")
        :format(id.skeleton, id.conf * 100, id.usable))
    say("  variant     : " .. (id.variant or "- (no mounted weapon shares a name prefix with the skeleton)"))
    local alt = {}
    for i = 2, #id.alts do alt[#alt + 1] = ("%s %.0f%%"):format(id.alts[i].name, id.alts[i].conf * 100) end
    if #alt &gt; 0 then say("  runners up  : " .. table.concat(alt, ",  ")) end
  else
    say("  skeleton    : no usable attach nodes to fingerprint")
  end
  say(("  slot cats   : %s"):format(id.slotCat and
      ("%s  (%d of %d named slots agree)"):format(id.slotCat, id.slotCatN, id.slotNamed) or "-"))
  say("  name family : " .. (id.family or "-"))
  say("  lone weapon : " .. (id.singleWeapon or "-") ..
      (id.singleWeapon and "  (only one named slot, no skeleton match - best guess is its name)" or ""))
  say(("  =&gt; %s / %s   (source: %s)"):format(cat, nm or "** unknown **", src))
  return id
end

-- rebuild every guess (after tagging, or after the game loads new assets)
function MF.reidentify()
  MF.idCache = {}
  say("[MF] identification cache cleared")
end

--=============================================================
-- 3c. SIDES
--=============================================================
MF.SIDE = { common = 0, right = 1, left = 2, both = 0, none = 0 }
MF.SIDE_NAME = { [0] = "Common", [1] = "Right", [2] = "Left" }
function MF.side(v)
  if v == nil then return 0 end
  if type(v) == "number" then return v end
  local s = tostring(v):lower()
  if s:match("^%d+$") then return tonumber(s) end
  return MF.SIDE[s] or error("MF.side: use Common/Right/Left or 0/1/2", 2)
end

--=============================================================
-- 4. ADDRESS RESOLUTION  (validated - this is the big fix)
--=============================================================
function MF.count(db)
  local n = 0
  for _ in pairs(db) do n = n + 1 end
  return n
end

function MF.refresh()
  -- rebuild the compdata pointers + databases after a pointer move
  if compdata_baseaddr and generateCompDataPointers and generateValuesCompData then
    baseaddr_pointer  = readPointer(compdata_baseaddr)
    compdata_pointers = generateCompDataPointers()
    values_compdata   = generateValuesCompData()
    if GenerateDatabases then compdata_db = GenerateDatabases() end
    MF.cache = {}
    say("[MF] compdata refreshed.")
    return true
  end
  say("[MF] refresh: CORE generator functions not visible; skipped.")
  return false
end

-- returns address, index   OR   nil, reason
function MF.locate(uidStr)
  local db = compdata_db[MF.DB]
  if db == nil then return nil, "compdata_db['"..MF.DB.."'] is nil - re-enable CORE" end
  local idx = nil
  for i, u in pairs(db) do
    if u == uidStr then idx = i - 1 break end
  end
  if idx == nil then
    return nil, "UID " .. uidStr .. " is not present in mount_params. " ..
                "The asset is probably not loaded - use the package loader / stratagem adder first."
  end
  local addr = values_compdata[MF.DB] + (idx * MF.STRUCT)
  fullAccess(addr, MF.STRUCT)
  return addr, idx
end

--=============================================================
-- 5. READ / WRITE
--=============================================================
local function slotAddr(base, i) return base + (i - 1) * MF.SLOT end

local function readSlot(base, i)
  local a = slotAddr(base, i)
  return {
    path    = MF.ustr(readQword(a + 0x00)),
    node    = rdU32(a + 0x08),
    side    = rdU32(a + 0x0C),
    name    = rdU32(a + 0x10),
    unknown = rdU32(a + 0x14),
  }
end

local function writeSlot(base, i, s)
  local a = slotAddr(base, i)
  writeQword  (a + 0x00, MF.u64(s.path or 0))
  writeInteger(a + 0x08, s.node    or 0)
  writeInteger(a + 0x0C, s.side    or 0)
  writeInteger(a + 0x10, s.name    or 0)
  writeInteger(a + 0x14, s.unknown or 0)
end

local function copySlots(src)
  local t = {}
  for i = 1, MF.SLOTS do
    local s = src[i]
    t[i] = { path = s.path, node = s.node, side = s.side, name = s.name, unknown = s.unknown }
  end
  return t
end

-- MF.read(entity) -&gt; record { uid, uidStr, addr, idx, slots[1..5] }
function MF.read(entity, forceReload)
  local uidStr = MF.entityUid(entity)

  local rec = MF.cache[uidStr]
  if rec and not forceReload then
    local a, e = MF.locate(uidStr)          -- re-resolve in case pointers moved
    if a == nil then return nil, e end
    rec.addr = a
    return rec
  end

  local addr, idx = MF.locate(uidStr)
  if addr == nil then return nil, idx end

  rec = { uid = uidStr, uidStr = uidStr, addr = addr, idx = idx,
          label = MF.entityName(uidStr), slots = {} }
  for i = 1, MF.SLOTS do rec.slots[i] = readSlot(addr, i) end

  rec.locked = not MF.editable(uidStr)
  if rec.locked then return rec end            -- read-only view, never cached or backed up
  if MF.backup[uidStr] == nil then
    MF.backup[uidStr] = copySlots(rec.slots)
    MF.backupMeta[uidStr] = { addr = addr, idx = idx }
  end
  MF.cache[uidStr] = rec
  return rec
end

function MF.apply(rec)
  if type(rec) == "string" then rec = assert(MF.read(rec)) end
  if not MF.editable(rec.uidStr) then
    say(("[MF] refused: %s is not a player-side platform (enemies, objective props and ship crew are read-only)")
        :format(rec.label or rec.uidStr))
    return false
  end
  local addr, e = MF.locate(rec.uidStr)
  if addr == nil then say("[MF] apply failed: " .. e) return false end
  rec.addr = addr
  table.insert(MF.undoStack, { uidStr = rec.uidStr, slots = copySlots(rec.slots) })
  if #MF.undoStack &gt; 32 then table.remove(MF.undoStack, 1) end
  for i = 1, MF.SLOTS do writeSlot(addr, i, rec.slots[i]) end
  say(("[MF] applied -&gt; %s @ %X (idx %d)"):format(rec.label, addr, rec.idx))
  return true
end

local function readAllSlots(addr)
  local t = {}
  for i = 1, MF.SLOTS do t[i] = readSlot(addr, i) end
  return t
end

local function slotsMatch(a, b)
  for i = 1, MF.SLOTS do
    if a[i].path ~= b[i].path or a[i].node ~= b[i].node or a[i].side ~= b[i].side then
      return false, i
    end
  end
  return true
end

-- Writes the backup back AND verifies it actually took by reading memory
-- straight back afterward - the old version trusted the write unconditionally
-- and always reported success even when nothing changed. On a mismatch this
-- refreshes compdata (in case the record moved) and retries exactly once
-- before reporting a real, specific failure.
function MF.reset(entity, _retried)
  local uidStr = MF.entityUid(entity)
  local b = MF.backup[uidStr]
  if b == nil then say("[MF] no backup for " .. uidStr) return false end

  local addr, e = MF.locate(uidStr)
  if addr == nil then say("[MF] reset failed: " .. e) return false end

  local meta = MF.backupMeta[uidStr]
  if meta and meta.addr ~= addr then
    say(("[MF] note: %s has moved since its backup was captured (was @%X, now @%X) - " ..
         "writing to the current location"):format(MF.entityName(uidStr), meta.addr, addr))
  end

  for i = 1, MF.SLOTS do writeSlot(addr, i, b[i]) end
  local now = readAllSlots(addr)
  local ok, badSlot = slotsMatch(now, b)

  if not ok and not _retried then
    say(("[MF] %s: slot %d did not take - refreshing compdata and retrying once")
        :format(MF.entityName(uidStr), badSlot))
    MF.refresh()
    return MF.reset(entity, true)
  end

  if not ok then
    say(("[MF] RESET DID NOT TAKE for %s (slot %d), even after a refresh+retry.")
        :format(MF.entityName(uidStr), badSlot))
    say(("       backup says : %s"):format(MF.label(b[badSlot].path) .. " @ " .. MF.nodeName(b[badSlot].node)))
    say(("       memory says : %s"):format(MF.label(now[badSlot].path) .. " @ " .. MF.nodeName(now[badSlot].node)))
    say("       this is not a caching problem on this script's end - something else is holding " ..
        "or rewriting this record. If only a full game restart clears it, the live entity may be " ..
        "an already-spawned instance that copied its config at spawn time; recalling/redeploying " ..
        "it (not just editing the record) may be what actually needs to happen.")
    if MF.cache[uidStr] then MF.cache[uidStr].slots = now end   -- cache reflects reality, not the failed intent
    return false
  end

  if MF.cache[uidStr] then MF.cache[uidStr].slots = copySlots(b) end
  say("[MF] reset " .. MF.entityName(uidStr) .. " (verified)")
  return true
end

function MF.resetAll()
  local ok, failed = 0, {}
  for uidStr in pairs(MF.backup) do
    if MF.reset(uidStr) then ok = ok + 1 else failed[#failed + 1] = MF.entityName(uidStr) end
  end
  say(("[MF] reset %d mount(s)."):format(ok))
  if #failed &gt; 0 then
    say("[MF] " .. #failed .. " did NOT verify: " .. table.concat(failed, ", "))
  end
  return ok, failed
end

-- Force-recapture the backup from CURRENT live memory instead of whatever
-- was captured earlier this session. Use this right after a fresh mission
-- or game restart, before editing anything, if reset ever stops matching
-- true vanilla - it makes "right now" the new reset target.
function MF.rebaseline(entity)
  local uidStr = MF.entityUid(entity)
  if not MF.editable(uidStr) then say("[MF] rebaseline: " .. uidStr .. " is read-only") return false end
  local addr, e = MF.locate(uidStr)
  if addr == nil then say("[MF] rebaseline failed: " .. e) return false end
  local slots = readAllSlots(addr)
  MF.backup[uidStr] = slots
  MF.backupMeta[uidStr] = { addr = addr, idx = MF.indexOf(uidStr) }
  if MF.cache[uidStr] then MF.cache[uidStr].slots = copySlots(slots) end
  say("[MF] rebaselined " .. MF.entityName(uidStr) .. " - current values are now the reset target")
  return true
end

function MF.rebaselineAll()
  local n = 0
  for _, e in ipairs(MF.scan{ list = false }) do
    if MF.rebaseline(e.uid) then n = n + 1 end
  end
  say(("[MF] rebaselined %d mount(s)."):format(n))
  return n
end

function MF.undo()
  local last = table.remove(MF.undoStack)
  if last == nil then say("[MF] undo stack empty") return false end
  local target = MF.backup[last.uidStr]
  for i = #MF.undoStack, 1, -1 do                     -- most recent state for THIS mount
    if MF.undoStack[i].uidStr == last.uidStr then target = MF.undoStack[i].slots break end
  end
  if target == nil then say("[MF] nothing to roll back to") return false end
  local addr = MF.locate(last.uidStr)
  if addr == nil then return false end
  for i = 1, MF.SLOTS do writeSlot(addr, i, target[i]) end
  local now = readAllSlots(addr)
  local ok, badSlot = slotsMatch(now, target)
  if MF.cache[last.uidStr] then MF.cache[last.uidStr].slots = now end
  if not ok then
    say(("[MF] undo -&gt; %s did NOT take (slot %d) - same underlying issue as a failed reset")
        :format(MF.entityName(last.uidStr), badSlot))
    return false
  end
  say("[MF] undo -&gt; " .. MF.entityName(last.uidStr) .. " (verified)")
  return true
end

--=============================================================
-- 6. SLOT EDITING
--=============================================================
-- read a record that is about to be modified; read-only records stop here
local function readForEdit(entity, fname)
  local rec, e = MF.read(entity)
  if rec == nil then error(fname .. ": " .. tostring(e), 3) end
  if rec.locked then error(fname .. ": " .. rec.label .. " is read-only (not a player-side platform)", 3) end
  return rec
end

local function checkSlot(i)
  if type(i) ~= "number" or i &lt; 1 or i &gt; MF.SLOTS then
    error("MF: slot must be 1.." .. MF.SLOTS, 3)
  end
  return i
end

-- MF.set("EXO-45 Patriot Exosuit", 3, {path=..., node=..., side=...})
function MF.set(entity, slot, spec, noApply)
  local rec, e = MF.read(entity)
  if rec == nil then error("MF.set: " .. tostring(e), 2) end
  if rec.locked then error("MF.set: " .. rec.label .. " is read-only (not a player-side platform)", 2) end
  checkSlot(slot)
  local s = rec.slots[slot]
  if spec.path    ~= nil then s.path    = MF.pathUid(spec.path) end
  if spec.node    ~= nil then s.node    = MF.node(spec.node)             end
  if spec.side    ~= nil then s.side    = MF.side(spec.side)             end
  if spec.name    ~= nil then s.name    = MF.node(spec.name)             end
  if spec.unknown ~= nil then s.unknown = spec.unknown                   end
  if not noApply then MF.apply(rec) end
  return rec
end

function MF.clear(entity, slot, noApply)
  local rec = readForEdit(entity, "MF.clear")
  checkSlot(slot)
  rec.slots[slot] = { path = "0", node = 0, side = 0, name = 0, unknown = 0 }
  if not noApply then MF.apply(rec) end
  return rec
end

function MF.firstFree(rec)
  for i = 1, MF.SLOTS do
    if rec.slots[i].path == "0" or rec.slots[i].path == nil then return i end
  end
  return nil
end

-- append into the first empty slot
function MF.add(entity, spec)
  local rec = readForEdit(entity, "MF.add")
  local i = MF.firstFree(rec)
  if i == nil then error("MF.add: all " .. MF.SLOTS .. " slots on " .. rec.label .. " are occupied", 2) end
  return MF.set(entity, i, spec)
end

-- transplant a slot from one vehicle onto another
function MF.copy(srcEntity, srcSlot, dstEntity, dstSlot, overrides)
  local a = assert(MF.read(srcEntity))          -- the source may be read-only
  local b = readForEdit(dstEntity, "MF.copy")
  checkSlot(srcSlot) ; checkSlot(dstSlot)
  local s = a.slots[srcSlot]
  b.slots[dstSlot] = { path = s.path, node = s.node, side = s.side, name = s.name, unknown = s.unknown }
  if overrides then
    local d = b.slots[dstSlot]
    if overrides.node ~= nil then d.node = MF.node(overrides.node) end
    if overrides.side ~= nil then d.side = MF.side(overrides.side) end
  end
  MF.apply(b)
  return b
end

-- duplicate a slot onto another slot with the side flipped
function MF.mirror(entity, srcSlot, dstSlot, node)
  local rec = readForEdit(entity, "MF.mirror")
  checkSlot(srcSlot) ; checkSlot(dstSlot)
  local s = rec.slots[srcSlot]
  local flip = (s.side == 1 and 2) or (s.side == 2 and 1) or 0
  rec.slots[dstSlot] = { path = s.path, node = node and MF.node(node) or s.node,
                         side = flip, name = s.name, unknown = s.unknown }
  MF.apply(rec)
  return rec
end

function MF.swap(entity, a, b)
  local rec = readForEdit(entity, "MF.swap")
  checkSlot(a) ; checkSlot(b)
  rec.slots[a], rec.slots[b] = rec.slots[b], rec.slots[a]
  MF.apply(rec)
  return rec
end

--=============================================================
-- 7. FLUENT BUILDER
--   MF.on("EXO-45 Patriot Exosuit")
--     :slot(3):path("EXO-55 Breakthrough Flak Cannon"):node("cockpit_aim"):side("Left")
--     :free()  :path("A/MG-43 Machine Gun Sentry"):node("back_top_hinge_01")
--     :apply()
--=============================================================
local B = {} ; B.__index = B
function MF.on(entity)
  local rec = readForEdit(entity, "MF.on")
  return setmetatable({ rec = rec, cur = 1 }, B)
end
function B:slot(i)    self.cur = checkSlot(i) ; return self end
function B:free()
  local i = MF.firstFree(self.rec)
  if i == nil then error("MF builder: no free slot on " .. self.rec.label, 2) end
  self.cur = i ; return self
end
function B:path(p)    self.rec.slots[self.cur].path = MF.pathUid(p) ; return self end
function B:node(n)    self.rec.slots[self.cur].node = MF.node(n)             ; return self end
function B:side(s)    self.rec.slots[self.cur].side = MF.side(s)             ; return self end
function B:name(n)    self.rec.slots[self.cur].name = MF.node(n)             ; return self end
function B:wipe()     self.rec.slots[self.cur] = {path="0",node=0,side=0,name=0,unknown=0} ; return self end
function B:apply()    MF.apply(self.rec) ; return self end
function B:dump()     MF.dump(self.rec)  ; return self end
function B:record()   return self.rec end

--=============================================================
-- 8. INSPECTION
--=============================================================
local function fit(v, n)
  v = tostring(v)
  if #v &gt; n then return v:sub(1, n - 2) .. ".." end
  return v .. string.rep(" ", n - #v)
end

function MF.dump(entity)
  local rec = (type(entity) == "table") and entity or MF.read(entity)
  if rec == nil then say("[MF] dump: not resolvable") return end
  local lbl = MF.entityName(rec.uidStr)        -- recompute: a tag may have landed since the read
  local _, src, cat = MF.whatIs(rec.uidStr)
  say(("\n== %s  [%s / %s]  (uid %s, idx %d, @%X)%s =="):format(
      lbl, cat or "?", src, rec.uidStr, rec.idx, rec.addr,
      MF.editable(rec.uidStr) and "" or "  READ-ONLY"))
  say("  # | path uid             | what it is                                 | attach node                | side")
  say("  --+----------------------+--------------------------------------------+----------------------------+-------")
  for i = 1, MF.SLOTS do
    local s = rec.slots[i]
    if s.path == "0" then
      say(("  %d | %s | %s | %s | %s"):format(i, fit("-", 20), fit("(empty)", 42), fit("-", 26), "-"))
    else
      say(("  %d | %s | %s | %s | %s"):format(i, fit(s.path, 20), fit(MF.label(s.path), 42),
          fit(MF.nodeName(s.node), 26), MF.SIDE_NAME[s.side] or s.side))
    end
  end
end

function MF.diff(entity)
  local rec = assert(MF.read(entity))
  local b = MF.backup[rec.uidStr]
  if b == nil then say("[MF] no backup") return end
  local changed = false
  for i = 1, MF.SLOTS do
    local n, o = rec.slots[i], b[i]
    if n.path ~= o.path or n.node ~= o.node or n.side ~= o.side then
      changed = true
      say(("  slot %d: %s/%s/%s  -&gt;  %s/%s/%s"):format(i,
        MF.pathName(o.path), MF.nodeName(o.node), MF.SIDE_NAME[o.side] or o.side,
        MF.pathName(n.path), MF.nodeName(n.node), MF.SIDE_NAME[n.side] or n.side))
    end
  end
  if not changed then say("[MF] " .. rec.label .. ": unchanged") end
end

--------------------------------------------------------------------
-- MF.scan - walk mount_params and CROSS-REFERENCE every uid against
-- the catalog, so you get names instead of a wall of idx/uid numbers.
-- Only player-side platforms (MF.PLATFORMS) are returned, empty ones too.
--   MF.scan()                     annotated, every editable platform
--   MF.scan{slots=false}          one line per record, no slot detail
--   MF.scan{filter="exo"}         substring match on name or uid
--   MF.scan{cat="DRONES"}         one category only
--   MF.scan{locked=true}          the read-only records instead (enemies, props, crew)
--   MF.scan{list=false}           return the table, print nothing
--------------------------------------------------------------------
function MF.count(db)
  local n = 0
  for _ in pairs(db) do n = n + 1 end
  return n
end

function MF.scan(opts)
  opts = opts or {}
  local db    = compdata_db[MF.DB]
  local base  = values_compdata[MF.DB]
  local out   = {}
  local needle = opts.filter and tostring(opts.filter):lower() or nil

  for i, uidStr in pairs(db) do
    local idx  = i - 1
    local addr = base + idx * MF.STRUCT
    local ok, p1 = pcall(readQword, addr)
    local want
    if opts.locked then want = (not MF.editable(uidStr)) and ok and p1 ~= nil and p1 ~= 0
    else want = MF.editable(uidStr) and ok end
    if want then
      local name, source, cat, conf = MF.whatIs(uidStr)
      local keep = true
      if opts.named   and name == nil then keep = false end
      if opts.unknown and name ~= nil then keep = false end
      if opts.cat     and cat ~= opts.cat then keep = false end
      if opts.source  and source ~= opts.source then keep = false end
      if keep and needle then
        keep = (name and name:lower():find(needle, 1, true)) ~= nil
               or uidStr:find(needle, 1, true) ~= nil
               or tostring(idx) == needle
      end
      if keep then
        local slots, filled = {}, 0
        for sN = 1, MF.SLOTS do
          local a = addr + (sN - 1) * MF.SLOT
          local okp, pv = pcall(readQword, a)
          local pu = (okp and pv ~= nil) and MF.ustr(pv) or "0"
          if pu ~= "0" then
            filled = filled + 1
            slots[sN] = { path = pu, node = rdU32(a + 0x08), side = rdU32(a + 0x0C) }
          end
        end
        out[#out + 1] = { idx = idx, uid = uidStr, addr = addr, name = name,
                          cat = cat or "UNCLASSIFIED", source = source, conf = conf or 0,
                          slots = slots, filled = filled, mount = MF.isMount[uidStr] or false }
      end
    end
  end

  local by = opts.sort or "idx"
  table.sort(out, function(a, b)
    if by == "cat" then
      local ra = MF.CAT_RANK[a.cat] or 99
      local rb = MF.CAT_RANK[b.cat] or 99
      if ra ~= rb then return ra &lt; rb end
      local na, nb = a.name or ("~~~" .. a.uid), b.name or ("~~~" .. b.uid)
      if na ~= nb then return na &lt; nb end
    elseif by == "name" then
      local na, nb = a.name or ("~~~" .. a.uid), b.name or ("~~~" .. b.uid)
      if na ~= nb then return na &lt; nb end
    elseif by == "slots" then
      if a.filled ~= b.filled then return a.filled &gt; b.filled end
    end
    return a.idx &lt; b.idx
  end)

  if opts.list ~= false then
    local bySrc = {}
    for _, e in ipairs(out) do bySrc[e.source] = (bySrc[e.source] or 0) + 1 end
    say(("\n[MF] mount_params @ %X - %d record(s) in table, %d shown")
        :format(base, MF.count(db), #out))
    say(("       named: %d catalog, %d your tags, %d fingerprinted, %d by weapon family, %d still unknown")
        :format(bySrc.catalog or 0, bySrc.tagged or 0, bySrc.inferred or 0,
                bySrc.family or 0, bySrc.unknown or 0))
    if needle then say(("       filter: %q"):format(tostring(opts.filter))) end
    say("")
    local lastCat = nil
    for _, e in ipairs(out) do
      if by == "cat" and e.cat ~= lastCat then
        lastCat = e.cat
        say(("  ---- %s %s"):format(e.cat, string.rep("-", math.max(4, 60 - #e.cat))))
      end
      local tail = ""
      if e.source == "inferred" then tail = ("  (%.0f%% guess)"):format(e.conf * 100)
      elseif e.source == "family" then tail = "  (guessed from its weapons)"
      elseif e.source == "tagged" then tail = "  (your tag)" end
      say(("  idx %-5d %s %s%s"):format(e.idx, fit("[" .. e.cat .. "]", 19),
          fit(e.name or ("** unnamed **   uid " .. e.uid), 46), tail))
      if e.name and by ~= "cat" then say(("           uid %s"):format(e.uid)) end
      if opts.slots ~= false then
        for sN = 1, MF.SLOTS do
          local sl = e.slots[sN]
          if sl then
            say(("        slot %d -&gt; %s @ %s %s"):format(
                sN, fit(MF.label(sl.path), 44), fit(MF.nodeName(sl.node), 26),
                MF.SIDE_NAME[sl.side] or tostring(sl.side)))
          end
        end
      end
    end
    say("")
  end
  return out
end

-- one line per category: how much of the table is identified
function MF.categories()
  local all = MF.scan{ list = false }
  local cnt, srcs = {}, {}
  for _, e in ipairs(all) do
    cnt[e.cat] = (cnt[e.cat] or 0) + 1
    srcs[e.cat] = srcs[e.cat] or {}
    srcs[e.cat][e.source] = (srcs[e.cat][e.source] or 0) + 1
  end
  say(("\n[MF] %d populated mount_params records by category"):format(#all))
  for _, c in ipairs(MF.CAT_ORDER) do
    if cnt[c] then
      local s2 = srcs[c]
      say(("  %s %4d    (catalog %d, tagged %d, fingerprint %d, family %d, unknown %d)")
          :format(fit(c, 18), cnt[c], s2.catalog or 0, s2.tagged or 0,
                  s2.inferred or 0, s2.family or 0, s2.unknown or 0))
    end
  end
  say("")
  return cnt
end

-- reverse lookup: which mounts reference this weapon/asset path?
function MF.whoUses(path)
  local want = MF.pathUid(path)
  local db   = compdata_db[MF.DB]
  local base = values_compdata[MF.DB]
  local hits = 0
  say(("\n[MF] searching mount_params for %s (%s)"):format(want, MF.label(want)))
  for i, uidStr in pairs(db) do
    local addr = base + (i - 1) * MF.STRUCT
    for sN = 1, MF.SLOTS do
      local a = addr + (sN - 1) * MF.SLOT
      local ok, v = pcall(readQword, a)
      if ok and v ~= nil and MF.ustr(v) == want then
        hits = hits + 1
        say(("   idx %-5d slot %d   %s @ %s"):format(
            i - 1, sN, fit(MF.name(uidStr) or ("uid " .. uidStr), 38), MF.nodeName(rdU32(a + 0x08))))
      end
    end
  end
  if hits == 0 then say("   no references found (asset may not be loaded)") end
  return hits
end

--=============================================================
-- 9. EXPORT / IMPORT  (share loadouts as one line of text)
--=============================================================
function MF.export(entity)
  local rec = assert(MF.read(entity))
  local parts = { "MF1", rec.uidStr }
  for i = 1, MF.SLOTS do
    local s = rec.slots[i]
    if s.path ~= "0" then
      parts[#parts + 1] = ("%d,%s,%d,%d,%d,%d"):format(i, s.path, s.node, s.side, s.name, s.unknown)
    end
  end
  local str = table.concat(parts, "|")
  say("[MF] " .. rec.label .. " -&gt; " .. str)
  return str
end

function MF.import(str, targetEntity)
  local parts = {}
  for p in tostring(str):gmatch("[^|]+") do parts[#parts + 1] = p end
  if parts[1] ~= "MF1" then error("MF.import: not an MF1 loadout string", 2) end
  local rec = readForEdit(targetEntity or parts[2], "MF.import")
  for i = 1, MF.SLOTS do rec.slots[i] = { path = "0", node = 0, side = 0, name = 0, unknown = 0 } end
  for i = 3, #parts do
    local sl, path, node, side, name, unk = parts[i]:match("^(%d+),(%d+),(%d+),(%d+),(%d+),(%d+)$")
    if sl then
      rec.slots[tonumber(sl)] = { path = path, node = tonumber(node), side = tonumber(side),
                                  name = tonumber(name), unknown = tonumber(unk) }
    end
  end
  MF.apply(rec)
  MF.dump(rec)
  return rec
end

--=============================================================
-- 10. CE SYMBOLS  (so address-list entries + dropdowns work)
--=============================================================
local function sanitize(s) return (s:gsub("[^%w]", "_")) end

function MF.symbol(entity, alias)
  local rec, e = MF.read(entity)
  if rec == nil then say("[MF] symbol: " .. tostring(e)) return false end
  local base = alias or sanitize(rec.label)
  unregisterSymbol(base) ; registerSymbol(base, rec.addr, true)
  MF.symbols[base] = true
  for i = 1, MF.SLOTS do
    local n = base .. "_S" .. i
    unregisterSymbol(n) ; registerSymbol(n, slotAddr(rec.addr, i), true)
    MF.symbols[n] = true
  end
  say(("[MF] symbols: %s (+ _S1.._S%d) -&gt; %X"):format(base, MF.SLOTS, rec.addr))
  return true
end

function MF.unsymbol()
  for n in pairs(MF.symbols) do pcall(unregisterSymbol, n) end
  MF.symbols = {}
end

--=============================================================
-- 11. WATCHDOG  (opt-in; re-resolves + re-applies periodically)
--=============================================================
function MF.watch(ms)
  MF.unwatch()
  ms = ms or 2000
  MF.timer = createTimer(nil, false)
  MF.timer.Interval = ms
  MF.timer.OnTimer = function()
    for uidStr, rec in pairs(MF.cache) do
      local addr = MF.locate(uidStr)
      if addr then
        rec.addr = addr
        for i = 1, MF.SLOTS do writeSlot(addr, i, rec.slots[i]) end
      end
    end
  end
  MF.timer.Enabled = true
  say(("[MF] watchdog on (%d ms). MF.unwatch() to stop."):format(ms))
end

function MF.unwatch()
  if MF.timer then pcall(function() MF.timer.Enabled = false ; MF.timer.destroy() end) end
  MF.timer = nil
end

--=============================================================
-- 12b. GUI
--   MF.gui()      main window
--   MF.browser()  mount_params database browser
--   Everything here is an additive layer. If a control cannot be
--   created the window bails out with a message and every console
--   command keeps working exactly as before.
--=============================================================
MF.ui = MF.ui or {}

local function guiMissing()
  local need = { "createForm", "createLabel", "createButton", "createComboBox",
                 "createListView", "createMemo", "createEdit" }
  for _, n in ipairs(need) do
    if rawget(_G, n) == nil then return n end
  end
  return nil
end

local function enum(name, fallback)
  local v = rawget(_G, name)
  if v ~= nil then return v end
  return fallback
end

local function prop(o, k, v) pcall(function() o[k] = v end) end

local function place(c, l, t, w, h)
  prop(c, "Left", l) prop(c, "Top", t)
  prop(c, "Width", w) prop(c, "Height", h)
  return c
end

local function guard(fn)
  return function(sender)
    local ok, err = pcall(fn, sender)
    if not ok then say("[MF] " .. tostring(err)) end
  end
end

local function mkLabel(o, cap, l, t, w)
  local c = createLabel(o) ; prop(c, "Caption", cap) ; place(c, l, t, w or 90, 17) ; return c
end

local function mkButton(o, cap, l, t, w, fn)
  local c = createButton(o) ; prop(c, "Caption", cap) ; place(c, l, t, w, 26)
  if fn then c.OnClick = guard(fn) end
  return c
end

local function mkCombo(o, l, t, w, locked)
  local c = createComboBox(o) ; place(c, l, t, w, 24)
  prop(c, "Style", locked and enum("csDropDownList", 2) or enum("csDropDown", 0))
  return c
end

local function lvCol(lv, cap, w)
  local c = lv.Columns.add() ; c.Caption = cap ; c.Width = w ; return c
end

local function lvRow(lv, first, ...)
  local it = lv.Items.add()
  it.Caption = tostring(first)
  for i = 1, select("#", ...) do it.SubItems.add(tostring((select(i, ...)))) end
  return it
end

local function fillCombo(cb, items, keep)
  local txt = keep and cb.Text or nil
  cb.Items.clear()
  for _, v in ipairs(items) do cb.Items.add(v) end
  if txt then prop(cb, "Text", txt) end
end

--------------------------------------------------------------- catalog display
-- "A/MG-43 Machine Gun Sentry  [DEFENSIVE]"  &lt;-&gt;  uid
local function buildPathList()
  if MF.ui.pathDisp then return MF.ui.pathDisp, MF.ui.pathMap end
  local disp, map = {}, {}
  for _, r in ipairs(MF.CATALOG) do
    local d = ("%s  [%s]"):format(r[2], r[3])
    if map[d] == nil then map[d] = r[1] ; disp[#disp + 1] = d end
  end
  table.sort(disp)
  table.insert(disp, 1, "(empty)")
  map["(empty)"] = "0"
  MF.ui.pathDisp, MF.ui.pathMap = disp, map
  return disp, map
end

local function pathFromText(txt)
  local _, map = buildPathList()
  txt = (tostring(txt or ""):gsub("^%s+", ""):gsub("%s+$", ""))
  if txt == "" then return "0" end
  if map[txt] then return map[txt] end
  return MF.pathUid(txt)                        -- raw uid or partial name
end

--------------------------------------------------------------- main window
function MF.gui()
  local miss = guiMissing()
  if miss then
    print("[MF] this Cheat Engine build has no " .. miss .. "() - GUI unavailable, " ..
          "console commands still work (MF.help()).")
    return nil
  end
  if MF.ui.form then pcall(function() MF.ui.form.show() end) ; MF.logSink = MF.ui.sink ; return MF.ui.form end

  local f = createForm(true)
  MF.ui.form = f
  prop(f, "Caption", "MOUNT FORGE " .. MF.VERSION .. "  -  Helldivers 2 mount_params editor (player-side platforms)")
  prop(f, "Width", 980) prop(f, "Height", 650)
  pcall(function() f.centerScreen() end)
  f.OnClose = function() MF.logSink = nil ; return enum("caHide", 1) end

  ------------------------------------------------ row 1: platform picker
  mkLabel(f, "Mount platform", 8, 12, 95)
  local cbVeh = mkCombo(f, 106, 8, 468, true)
  MF.ui.cbVeh = cbVeh

  mkButton(f, "Load", 580, 7, 58, function() MF.ui.load() end)
  mkButton(f, "Rescan DB", 642, 7, 86, function() MF.ui.rescan() ; say("[MF] platform list rebuilt from mount_params") end)
  mkButton(f, "Reset", 732, 7, 58, function()
    if MF.ui.rec then MF.reset(MF.ui.rec.uidStr) ; MF.ui.load(true) end end)
  mkButton(f, "Reset all", 794, 7, 74, function() MF.resetAll() ; MF.ui.load(true) end)
  mkButton(f, "Undo", 872, 7, 58, function() MF.undo() ; MF.ui.load(true) end)

  ------------------------------------------------ row 2: slot grid
  local lv = createListView(f)
  place(lv, 8, 40, 922, 152)
  prop(lv, "ViewStyle", enum("vsReport", 3))
  prop(lv, "RowSelect", true)
  prop(lv, "ReadOnly", true)
  prop(lv, "GridLines", true)
  lvCol(lv, "Slot", 42) ; lvCol(lv, "Path UID", 158) ; lvCol(lv, "What it is", 300)
  lvCol(lv, "Category", 120) ; lvCol(lv, "Attach node", 200) ; lvCol(lv, "Side", 70)
  MF.ui.lv = lv
  lv.OnSelectItem = function() pcall(MF.ui.slotToEditor) end

  ------------------------------------------------ row 3: slot editor
  mkLabel(f, "--- edit the selected slot ---", 8, 200, 220)
  mkLabel(f, "Path", 8, 226, 36)
  local cbPath = mkCombo(f, 48, 222, 426, false)
  MF.ui.cbPath = cbPath
  mkButton(f, "Who uses?", 480, 221, 86, function() MF.whoUses(pathFromText(cbPath.Text)) end)

  mkLabel(f, "Node", 574, 226, 38)
  local cbNode = mkCombo(f, 614, 222, 316, false)
  MF.ui.cbNode = cbNode

  mkLabel(f, "Side", 8, 258, 36)
  local cbSide = mkCombo(f, 48, 254, 110, true)
  for _, v in ipairs({ "Common", "Right", "Left" }) do cbSide.Items.add(v) end
  prop(cbSide, "ItemIndex", 0)
  MF.ui.cbSide = cbSide

  mkButton(f, "Apply slot", 166, 253, 92, function() MF.ui.applySlot() end)
  mkButton(f, "Clear slot", 262, 253, 92, function()
    local i = MF.ui.slot() ; if i then MF.clear(MF.ui.rec.uidStr, i) ; MF.ui.load(true) end end)
  mkButton(f, "Free slot", 358, 253, 84, function()
    local r = MF.ui.rec ; if not r then return end
    local i = MF.firstFree(r)
    if i == nil then say("[MF] no free slot") else prop(lv, "ItemIndex", i - 1) ; say("[MF] free slot: " .. i) end
  end)
  mkButton(f, "Mirror to next", 446, 253, 110, function()
    local i = MF.ui.slot() ; if not i then return end
    if i &gt;= MF.SLOTS then say("[MF] nothing to mirror into") return end
    MF.mirror(MF.ui.rec.uidStr, i, i + 1) ; MF.ui.load(true)
  end)
  MF.ui.hint = mkLabel(f, "", 564, 258, 366)

  ------------------------------------------------ row 4: actions
  mkButton(f, "Browse DB...", 8, 288, 96, function() MF.browser() end)
  mkButton(f, "Dump", 108, 288, 58, function() if MF.ui.rec then MF.dump(MF.ui.rec) end end)
  mkButton(f, "Diff", 170, 288, 52, function() if MF.ui.rec then MF.diff(MF.ui.rec.uidStr) end end)
  mkButton(f, "Export", 226, 288, 66, function()
    if not MF.ui.rec then return end
    local str = MF.export(MF.ui.rec.uidStr)
    pcall(function() writeToClipboard(str) ; say("[MF] copied to clipboard") end)
  end)
  mkButton(f, "Import", 296, 288, 66, function()
    local str
    pcall(function() str = inputQuery("MOUNT FORGE", "Paste an MF1 loadout string:", "") end)
    if str == nil or str == "" then say("[MF] import cancelled") return end
    MF.import(str) ; MF.ui.rescan() ; MF.ui.load(true)
  end)

  mkButton(f, "Clear log", 846, 288, 84, function() MF.ui.log.Lines.clear() end)

  ------------------------------------------------ row 5: log
  local mem = createMemo(f)
  place(mem, 8, 322, 922, 288)
  prop(mem, "ScrollBars", enum("ssBoth", 3))
  prop(mem, "WordWrap", false)
  prop(mem, "Font.Name", "Consolas")
  MF.ui.log = mem

  MF.ui.sink = function(line)
    if mem.Lines.Count &gt; 900 then mem.Lines.clear() end
    for part in tostring(line):gmatch("([^\n]*)\n?") do mem.Lines.add(part) end
  end
  MF.logSink = MF.ui.sink

  MF.ui.rescan()
  say("MOUNT FORGE " .. MF.VERSION .. " - pick a platform and press Load. Only player-side platforms are listed.")
  say("Everything the console commands print now lands here instead.")
  return f
end

--------------------------------------------------------------- main-window logic
function MF.ui.rescan()
  local cb = MF.ui.cbVeh ; if cb == nil then return end
  local keepIdx = cb.ItemIndex
  local full = MF.scan{ list = false, sort = "cat" }
  local list = {}
  for _, e in ipairs(full) do
    if not MF.PLATFORM_EXCLUDE[e.uid] then list[#list + 1] = e end
  end
  MF.ui.vlist = list
  local items = {}
  for _, e in ipairs(list) do
    items[#items + 1] = ("%s idx %-5d  %s%s"):format(
      ("[" .. e.cat .. "]") .. string.rep(" ", math.max(0, 19 - #e.cat)),
      e.idx, e.name or ("uid " .. e.uid), e.filled == 0 and "   (no mounts)" or "")
  end
  fillCombo(cb, items)
  if keepIdx ~= nil and keepIdx &gt;= 0 and keepIdx &lt; #items then prop(cb, "ItemIndex", keepIdx)
  elseif #items &gt; 0 then prop(cb, "ItemIndex", 0) end
end

function MF.ui.slot()
  local lv = MF.ui.lv
  if lv == nil or MF.ui.rec == nil then say("[MF] load a platform first") return nil end
  local i = lv.ItemIndex
  if i == nil or i &lt; 0 then say("[MF] select a slot row first") return nil end
  return i + 1
end

function MF.ui.load(keepSelection)
  local cb, lv = MF.ui.cbVeh, MF.ui.lv
  if cb == nil then return end
  local i = cb.ItemIndex
  if i == nil or i &lt; 0 or MF.ui.vlist == nil or MF.ui.vlist[i + 1] == nil then
    say("[MF] pick a platform first") return
  end
  local sel = lv and lv.ItemIndex or -1
  local entry = MF.ui.vlist[i + 1]
  local rec, err = MF.read(entry.uid, true)
  if rec == nil then say("[MF] " .. tostring(err)) return end
  MF.ui.rec = rec

  -- node dropdown follows the platform's skeleton
  local group, gname = MF.nodeGroup(rec.label)
  local names = group
  if names == nil then names = MF.NODEPOOL end
  local sorted = {}
  for _, n in ipairs(names) do sorted[#sorted + 1] = n end
  table.sort(sorted)
  fillCombo(MF.ui.cbNode, sorted)
  prop(MF.ui.hint, "Caption",
       gname and ("nodes: " .. gname .. " skeleton (" .. #sorted .. ")")
              or ("nodes: no skeleton mapped - all " .. #sorted .. " listed, or type any name"))

  fillCombo(MF.ui.cbPath, (buildPathList()))
  MF.ui.refreshSlots()
  if keepSelection and sel and sel &gt;= 0 then prop(lv, "ItemIndex", sel) end
  MF.ui.slotToEditor()
end

function MF.ui.refreshSlots()
  local lv, rec = MF.ui.lv, MF.ui.rec
  if lv == nil or rec == nil then return end
  lv.Items.clear()
  for i = 1, MF.SLOTS do
    local s = rec.slots[i]
    if s.path == "0" then
      lvRow(lv, i, "-", "(empty)", "-", "-", "-")
    else
      lvRow(lv, i, s.path, MF.name(s.path) or "** unknown **", MF.cat(s.path) or "?",
            MF.nodeName(s.node), MF.SIDE_NAME[s.side] or tostring(s.side))
    end
  end
end

function MF.ui.slotToEditor()
  local rec = MF.ui.rec ; if rec == nil then return end
  local lv = MF.ui.lv
  local i = lv.ItemIndex
  if i == nil or i &lt; 0 then return end
  local s = rec.slots[i + 1] ; if s == nil then return end
  local _, map = buildPathList()
  local disp = "(empty)"
  if s.path ~= "0" then
    local nm = MF.name(s.path)
    disp = nm and ("%s  [%s]"):format(nm, MF.cat(s.path)) or s.path
  end
  prop(MF.ui.cbPath, "Text", disp)
  prop(MF.ui.cbNode, "Text", s.node == 0 and "" or MF.nodeName(s.node))
  prop(MF.ui.cbSide, "ItemIndex", (s.side == 1 or s.side == 2) and s.side or 0)
end

function MF.ui.applySlot()
  local i = MF.ui.slot() ; if i == nil then return end
  local rec  = MF.ui.rec
  local path = pathFromText(MF.ui.cbPath.Text)
  local nodeTxt = (tostring(MF.ui.cbNode.Text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
  local side = MF.ui.cbSide.ItemIndex
  if side == nil or side &lt; 0 then side = 0 end
  MF.set(rec.uidStr, i, { path = path,
                          node = nodeTxt == "" and 0 or MF.node(nodeTxt),
                          side = side })
  MF.ui.load(true)
end

function MF.guiClose()
  MF.logSink = nil
  pcall(function() if MF.ui.browserForm then MF.ui.browserForm.hide() end end)
  pcall(function() if MF.ui.form then MF.ui.form.hide() end end)
end

--------------------------------------------------------------- database browser
function MF.browser()
  if guiMissing() then print("[MF] GUI unavailable on this CE build") return nil end
  if MF.ui.browserForm then
    pcall(function() MF.ui.browserForm.show() end)
    MF.ui.browserCats() ; MF.ui.browserFill()
    return MF.ui.browserForm
  end

  local f = createForm(true)
  MF.ui.browserForm = f
  prop(f, "Caption", "MOUNT FORGE - platform browser (player-side platforms)")
  prop(f, "Width", 1030) prop(f, "Height", 580)
  pcall(function() f.centerScreen() end)
  f.OnClose = function() return enum("caHide", 1) end

  ------------------------------------------------ filter row
  mkLabel(f, "Category", 8, 12, 56)
  local cbCat = mkCombo(f, 66, 8, 208, true) ; MF.ui.bCat = cbCat

  mkLabel(f, "Show", 282, 12, 34)
  local cbMode = mkCombo(f, 318, 8, 150, true) ; MF.ui.bMode = cbMode
  for _, v in ipairs({ "All platforms", "With mounts", "No mounts" }) do cbMode.Items.add(v) end
  prop(cbMode, "ItemIndex", 0)

  mkLabel(f, "Sort", 476, 12, 28)
  local cbSort = mkCombo(f, 508, 8, 128, true) ; MF.ui.bSort = cbSort
  for _, v in ipairs({ "Category", "Index", "Name", "Slots used" }) do cbSort.Items.add(v) end
  prop(cbSort, "ItemIndex", 0)

  mkLabel(f, "Find", 646, 12, 28)
  local ed = createEdit(f) ; place(ed, 678, 8, 184, 24) ; prop(ed, "Text", "")
  MF.ui.bFilter = ed

  mkButton(f, "Search", 868, 7, 72, function() MF.ui.browserFill() end)
  mkButton(f, "Refresh", 944, 7, 76, function()
    MF.ui.browserCats() ; MF.ui.browserFill() end)

  ------------------------------------------------ action row
  mkButton(f, "Load into editor", 8, 40, 124, function()
    local e = MF.ui.browserSelected() ; if e == nil then say("[MF] select a row first") return end
    MF.gui() ; MF.ui.rescan()
    for i = 1, #(MF.ui.vlist or {}) do
      if MF.ui.vlist[i].uid == e.uid then prop(MF.ui.cbVeh, "ItemIndex", i - 1) ; MF.ui.load() ; return end
    end
    say("[MF] could not find that record in the platform list")
  end)
  mkButton(f, "Dump", 136, 40, 62, function()
    local e = MF.ui.browserSelected() ; if e then MF.dump(e.uid) end end)
  mkButton(f, "Copy UID", 202, 40, 80, function()
    local e = MF.ui.browserSelected()
    if e then pcall(function() writeToClipboard(e.uid) end) ; say("[MF] uid " .. e.uid) end end)
  mkButton(f, "Category report", 286, 40, 120, function() MF.categories() end)
  MF.ui.bCount = mkLabel(f, "", 850, 45, 170)

  ------------------------------------------------ list
  local lv = createListView(f)
  place(lv, 8, 72, 1012, 468)
  prop(lv, "ViewStyle", enum("vsReport", 3))
  prop(lv, "RowSelect", true) prop(lv, "ReadOnly", true) prop(lv, "GridLines", true)
  lvCol(lv, "Idx", 52) ; lvCol(lv, "Category", 124) ; lvCol(lv, "Name", 300)
  lvCol(lv, "UID", 168) ; lvCol(lv, "Slots", 48)
  lvCol(lv, "First mount", 306)
  MF.ui.bLv = lv

  MF.ui.browserCats()
  MF.ui.browserFill()
  return f
end

function MF.ui.browserSelected()
  local lv = MF.ui.bLv
  if lv == nil or MF.ui.blist == nil then return nil end
  local i = lv.ItemIndex
  if i == nil or i &lt; 0 then return nil end
  return MF.ui.blist[i + 1]
end

-- rebuild the category dropdown with live counts
function MF.ui.browserCats()
  local cb = MF.ui.bCat ; if cb == nil then return end
  local keep = MF.ui.bCatList and MF.ui.bCatList[(cb.ItemIndex or 0) + 1]
  local all = MF.scan{ list = false }
  local cnt = {}
  for _, e in ipairs(all) do cnt[e.cat] = (cnt[e.cat] or 0) + 1 end
  local codes, items = { "*" }, { ("All categories (%d)"):format(#all) }
  for _, c in ipairs(MF.CAT_ORDER) do
    if cnt[c] then codes[#codes + 1] = c ; items[#items + 1] = ("%s (%d)"):format(c, cnt[c]) end
  end
  for c, n in pairs(cnt) do                       -- anything outside CAT_ORDER
    if MF.CAT_RANK[c] == nil then
      codes[#codes + 1] = c ; items[#items + 1] = ("%s (%d)"):format(c, n)
    end
  end
  MF.ui.bCatList = codes
  fillCombo(cb, items)
  local at = 0
  for i, c in ipairs(codes) do if c == keep then at = i - 1 break end end
  prop(cb, "ItemIndex", at)
end

function MF.ui.browserFill()
  local lv = MF.ui.bLv ; if lv == nil then return end
  local opts = { list = false }

  local m = MF.ui.bMode.ItemIndex or 0

  local ci = (MF.ui.bCat.ItemIndex or 0) + 1
  local want = MF.ui.bCatList and MF.ui.bCatList[ci]
  if want and want ~= "*" then opts.cat = want end

  local txt = MF.ui.bFilter.Text
  if txt ~= nil and txt ~= "" then opts.filter = txt end

  opts.sort = ({ [0] = "cat", [1] = "idx", [2] = "name", [3] = "slots" })[MF.ui.bSort.ItemIndex or 0] or "cat"

  local list = MF.scan(opts)
  if m == 1 or m == 2 then
    local only = {}
    for _, e in ipairs(list) do
      if (m == 1) == (e.filled &gt; 0) then only[#only + 1] = e end
    end
    list = only
  end
  MF.ui.blist = list

  lv.Items.clear()
  for _, e in ipairs(list) do
    local s1 = e.slots[1]
    for sN = 2, MF.SLOTS do if s1 == nil then s1 = e.slots[sN] end end
    lvRow(lv, e.idx, e.cat, e.name or ("uid " .. e.uid), e.uid,
          ("%d/%d"):format(e.filled, MF.SLOTS),
          s1 and MF.label(s1.path) or "-")
  end
  prop(MF.ui.bCount, "Caption", ("%d record(s)"):format(#list))
  say(("[MF] browser: %d record(s)"):format(#list))
end

--=============================================================
-- 13. HELP / BANNER
--=============================================================
function MF.help()
  print([==[
================ MOUNT FORGE ]==] .. MF.VERSION .. [==[ ================
GUI          MF.gui()      main window (vehicle picker, slot grid, editor, log)
             MF.browser()  database browser with live filter
             While a window is open, output goes to its log, not this console.

ADDRESSING   anywhere an entity is expected you can pass:
             a name, a raw decimal uid, or "#42" for mount_params index 42.
             MF.at(42) -&gt; uid at that index      MF.indexOf(uid) -&gt; its index

WHAT CAN BE EDITED
  Player-side platforms only (MF.PLATFORMS): exosuits, FRVs, Bastion,
  TD-110 Maelstrom, GATER, Pelicans, Eagles, Guard Dogs, emplacements.
  Enemies, objective props and ship crew are read-only: MF.dump() still
  shows them, and they can be the SOURCE of MF.copy(), but every write
  to them is refused.
  MF.editable(uid)                       true if Mount Forge will write it
  MF.scan{locked=true}                   list the read-only records
  MF.categories()                        platforms per category

LOOKUP
  MF.dump("#42")                         works on anything (read-only ones are marked)
  MF.dump("EXO-45 Patriot Exosuit")      show the 5 slots, cross-referenced
  MF.scan()                              every editable platform, annotated
  MF.scan{slots=false}                   one line per record
  MF.scan{filter="exo"}                  substring match on name or uid
  MF.scan{cat="DRONES"}                  one category only
  MF.scan{sort="cat"}                    grouped under category headings
  MF.whoUses("A/MG-43 Machine Gun Sentry")  reverse lookup
  MF.diff("EXO-45 Patriot Exosuit")      what you changed vs original
  MF.nodeGroup("EXO-45 Patriot Exosuit") node names valid for that skeleton
  MF.hash32("some_node_name")            IdString32 of any node name
  MF.hash64("content/some/asset_path")   full 64-bit Stingray hash

EDIT
  MF.set(entity, slot, {path=, node=, side=, name=})
  MF.add(entity, {path=, node=, side=})        first free slot
  MF.clear(entity, slot)
  MF.copy(srcEntity, srcSlot, dstEntity, dstSlot [, {node=,side=}])
  MF.mirror(entity, srcSlot, dstSlot [, node])
  MF.swap(entity, a, b)

BUILDER
  MF.on("EXO-45 Patriot Exosuit")
    :slot(3):path("EXO-55 Breakthrough Flak Cannon"):node("cockpit_aim"):side("Left")
    :free() :path("A/MG-43 Machine Gun Sentry"):node("back_top_hinge_01")
    :apply():dump()

SHARE
  MF.export(entity)          -&gt; "MF1|...|..." one-line loadout
  MF.import(str [, entity])  apply a loadout string

UNDO / RESET
  MF.undo()   MF.reset(entity)   MF.resetAll()

RESET        MF.reset(entity) / MF.resetAll()  writes the backup back AND
             verifies the write actually took by reading memory straight
             back; on mismatch it refreshes compdata and retries once,
             then reports plainly if it still didn't take.
             MF.rebaseline(entity) / MF.rebaselineAll()  re-captures the
             CURRENT live values as the new reset target. Use this right
             after a fresh mission/game restart, before editing anything,
             if a reset ever stops matching true vanilla.
SYMBOLS      MF.symbol(entity [,alias])  -&gt; alias, alias_S1..S5
PLUMBING     MF.refresh()  rebuild compdata after pointers move
             MF.watch(2000) / MF.unwatch()  re-apply watchdog

ARG FORMS    entity/path: friendly name (partial ok) | decimal UID | number
             node:        name string (hashed) | numeric id
             side:        "Common"/"Right"/"Left" | 0/1/2

NOTE  mount_params is read when the entity spawns. Apply BEFORE you
      call the vehicle in. The asset you mount must already be loaded
      (package loader / stratagem adder) or its UID will not be in the
      table and MF will refuse rather than corrupt index 0.
=====================================================================]==])
end

