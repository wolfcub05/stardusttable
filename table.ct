-- //! =========================================================================
-- //!  =================        WRITE       FUNCTIONS       ===================
-- //! =========================================================================

function ProjectileData_RPM(target_address, target_settings)
    writeInteger(target_address + 0x000, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.ptype))
    writeFloat(target_address   + 0x004,   target_settings.rpm.x)
    writeFloat(target_address   + 0x008,   target_settings.rpm.y)
    writeFloat(target_address   + 0x00C,   target_settings.rpm.z)
end

function ProjectileData_Zeroing(target_address, target_settings)
    writeFloat(target_address   + 0x010, target_settings.zeroing.x)
    writeFloat(target_address   + 0x014, target_settings.zeroing.y)
    writeFloat(target_address   + 0x018, target_settings.zeroing.z)
    writeFloat(target_address   + 0x01C, target_settings.zeroing.hipfire)
    writeInteger(target_address + 0x020, target_settings.zeroing.current_zeroing_slot)
end

function ProjectileData_ProjData(target_address, target_settings)
    writeInteger(target_address + 0x024, target_settings.infinite_ammo)
    writeQword(target_address   + 0x028, target_settings.projectile_entity)
    writeFloat(target_address   + 0x030, target_settings.firenode_pose_limit)

    --//* ======================================================================
    --//* =============          Bytes: [0x078, 0x0E0]           ===============
    --//* ======================================================================
    writeInteger(target_address + 0x078, fromStringtoMemory(WindEffectTemplateDatabaseOUT, target_settings.wind_effect_template))
    writeFloat(target_address   + 0x07C, target_settings.speed_multiplier)
    writeFloat(target_address   + 0x080, target_settings.damage_addends.normal)
    writeFloat(target_address   + 0x084, target_settings.damage_addends.durable)
    writeFloat(target_address   + 0x088, target_settings.ap_addends.normal)
    writeFloat(target_address   + 0x08C, target_settings.ap_addends.durable)
    writeFloat(target_address   + 0x090, target_settings.spinup_time)
    writeInteger(target_address + 0x094, target_settings.rpc_synced_fire_events)
    writeQword(target_address   + 0x0E0, target_settings.muzzle_flash)
    --//* ======================================================================
    --//* =============          Bytes: [0x0FC, 0x22C]           ===============
    --//* ======================================================================
    writeInteger(target_address + 0x0FC, target_settings.fire_loop_start_audio_event         )
    writeInteger(target_address + 0x100, target_settings.fire_loop_stop_audio_event          )
    writeInteger(target_address + 0x104, target_settings.fire_single_audio_event             ) --//!
    writeInteger(target_address + 0x108, target_settings.fire_all_barrel_audio_event         )
    writeInteger(target_address + 0x10C, target_settings.fire_reflect_audio_event            )
    writeInteger(target_address + 0x110, target_settings.silenced_fire_reflect_audio_event   )
    writeInteger(target_address + 0x114, target_settings.haptics_fire_loop_start_audio_event )
    writeInteger(target_address + 0x118, target_settings.haptics_fire_loop_stop_audio_event  )
    writeInteger(target_address + 0x11C, target_settings.haptics_fire_single_audio_event     ) --//!
    writeInteger(target_address + 0x210, target_settings.silenced_fire_loop_start_audio_event)
    writeInteger(target_address + 0x214, target_settings.silenced_fire_loop_stop_audio_event )
    writeInteger(target_address + 0x218, target_settings.silenced_fire_single_audio_event    ) --//!
    writeInteger(target_address + 0x21C, target_settings.fire_source_node                    ) --//!
    writeInteger(target_address + 0x220, target_settings.dry_fire_audio_event                )
    writeInteger(target_address + 0x224, target_settings.dry_fire_repeat_audio_event         )
    writeInteger(target_address + 0x228, target_settings.heat_percentage_material_variable   )
    writeInteger(target_address + 0x22C, target_settings.silenced                            ) --//!
    --//* ======================================================================
    --//* =============          Bytes: [0x230, 0x254]           ===============
    --//* ======================================================================
    writeInteger(target_address + 0x230, fromStringtoMemory(ProjectileZeroingQualityDatabaseOUT, target_settings.aim_zeroing_quality))
    writeFloat(target_address   + 0x238, target_settings.burst_fire_rate)
    writeFloat(target_address   + 0x23C, target_settings.weapon_function_muzzle_velocity)
    writeInteger(target_address + 0x240, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_settings.weapon_function_projectile_type))
    writeInteger(target_address + 0x254, target_settings.attention_level_drawn_by_shot)
end






function ProjectileSettings_general_modifications(target_address, target_settings)
    --//* ======================================================================
    --//* =============          Bytes: [0x018, 0x040]           ===============
    --//* ======================================================================
    writeFloat(target_address   + 0x18, target_settings.calibre)
    writeInteger(target_address + 0x1C, target_settings.num_projectiles)
    writeFloat(target_address   + 0x20, target_settings.speed)
    writeFloat(target_address   + 0x24, target_settings.mass)
    writeFloat(target_address   + 0x28, target_settings.drag)
    writeFloat(target_address   + 0x2C, target_settings.gravity_multiplier)
    writeInteger(target_address + 0x30, target_settings.simulation_steps)
    writeFloat(target_address   + 0x34, target_settings.life_time)
    writeFloat(target_address   + 0x38, target_settings.life_time_randomness)
    writeInteger(target_address + 0x3C, fromStringtoMemory(DamageSettingsDatabaseOUT, target_settings.damage_info_type))
    writeFloat(target_address   + 0x40, target_settings.penetration_slowdown)
    --//* ======================================================================
    --//* =============          Bytes: [0x048, 0x080]           ===============
    --//* ======================================================================
    writeQword(target_address   + 0x48, target_settings.particle_thruster_effect_path)
    writeQword(target_address   + 0x50, target_settings.low_ammo_particle_thruster_effect_path)
    writeFloat(target_address   + 0x58, target_settings.particle_thruster_effect_length)
    writeQword(target_address   + 0x60, target_settings.particle_trail_effect_path)
    writeQword(target_address   + 0x68, target_settings.dissipate_particle_effect_path)
    writeQword(target_address   + 0x70, target_settings.disintegration_particle_effect_path)
    writeQword(target_address   + 0x78, target_settings.hit_direction_hint_effect)
    writeQword(target_address   + 0x80, target_settings.projectile_unit_path)
    --//* ======================================================================
    --//* =============          Bytes: [0x088, 0x0A4]           ===============
    --//* ======================================================================
    writeFloat(target_address   + 0x088, target_settings.expl_threshold_angle)
    writeInteger(target_address + 0x08C, target_settings.can_expire_after_impact)
    writeInteger(target_address + 0x090, fromStringtoMemory(ExplosionSettingsDatabaseOUT, target_settings.explosion_type_impact))
    writeFloat(target_address   + 0x094, target_settings.explosion_proximity)
    writeFloat(target_address   + 0x098, target_settings.explosion_delay)
    writeInteger(target_address + 0x09C, fromStringtoMemory(ExplosionSettingsDatabaseOUT, target_settings.explosion_type_expire))
    writeFloat(target_address   + 0x0A0, target_settings.arming_distance)
    writeFloat(target_address   + 0x0A4, target_settings.decal_size)
    --//* ======================================================================
    --//* =============          Bytes: [0x0A8, 0x0D4]           ===============
    --//* ======================================================================
    writeInteger(target_address + 0x0A8, target_settings.surface_impact_type)
    writeInteger(target_address + 0x0AC, target_settings.ricochet_impact_type)
    writeInteger(target_address + 0x0B0, target_settings.max_ricochets)
    writeFloat(target_address   + 0x0B4, target_settings.ricochet_threshold_angle)
    writeFloat(target_address   + 0x0B8, target_settings.ricochet_threshold_speed)
    writeFloat(target_address   + 0x0BC, target_settings.ricochet_angle_loss)
    writeFloat(target_address   + 0x0C0, target_settings.ricochet_spread_vertical)
    writeFloat(target_address   + 0x0C4, target_settings.ricochet_spread_horizontal)
    writeInteger(target_address + 0x0C8, target_settings.audio_crack_event)
    writeInteger(target_address + 0x0CC, target_settings.audio_ricochet_event)
    writeInteger(target_address + 0x0D0, target_settings.audio_trail_event_start)
    writeInteger(target_address + 0x0D4, target_settings.audio_trail_event_stop)
    --//* ======================================================================
    --//* =============          Bytes: [0x0D8, 0x10C]           ===============
    --//* ======================================================================
    writeFloat(target_address   + 0x0D8, target_settings.unknown_D8)
    writeInteger(target_address + 0x0DC, target_settings.unknown_DC)
    writeInteger(target_address + 0x0E0, target_settings.unknown_E0)
    writeInteger(target_address + 0x0E4, fromStringtoMemory(ProjectileStatusEffectVolumeDatabaseOUT, target_settings.status_effect_volume_template))
    writeInteger(target_address + 0x0E8, fromStringtoMemory(HitEffectDamageTemplateDatabaseOUT, target_settings.hit_effect_damage_type))
    writeInteger(target_address + 0x0EC, fromStringtoMemory(FireTemplateDatabaseOUT, target_settings.fire_template))
    writeBytes_F0(target_address, target_settings)
    writeInteger(target_address + 0x0F4, fromStringtoMemory(RaycastTemplateDatabaseOUT, target_settings.raycast_template))
    writeInteger(target_address + 0x0F8, target_settings.proximity_explosion_collision_filter)
    writeBytes_FC(target_address, target_settings)
    writeFloat(target_address   + 0x100, target_settings.projectile_attachment_local_offset.x)
    writeFloat(target_address   + 0x104, target_settings.projectile_attachment_local_offset.y)
    writeFloat(target_address   + 0x108, target_settings.projectile_attachment_local_offset.z)
end



function Apply_ProjectileSettingsOnly_Modifications(target_settings)
    local target_address = target_settings.info.settings.address
    ProjectileSettings_general_modifications(target_address, target_settings)
end

--// ============    Get Projectile CompData UID Address
function Apply_ProjectileInfo_Modifications(target_settings)
    local target_address = target_settings.info.settings.address
    if target_address ~= "0x0000000000000000" then
        ProjectileSettings_general_modifications(target_address, target_settings)
    end
    local target_projdata = target_settings.info.compdata.address
    if target_projdata ~= "0x0000000000000000" then
        ProjectileData_RPM(target_projdata,      target_settings)
        ProjectileData_Zeroing(target_projdata,  target_settings)
        ProjectileData_ProjData(target_projdata, target_settings)
    end
end

