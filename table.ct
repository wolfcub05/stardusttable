-- //! =========================================================================
-- //!  ===================     B E A M   S E T T I N G S    ===================
-- //! =========================================================================
function getAddressBeamSettings(target_id)
    local struct_size = 0x70
    local output_addr = AddressHandler(target_id, "beam_weapons", struct_size)
    return output_addr
end


function Read_BeamSettings_Data(input_str_idx)
    local beam_idx = readIndexedString(BeamSettingsDatabaseOUT, input_str_idx)
    local target_address = getAddressBeamSettings(beam_idx)
    local output_template = {
        address          = target_address,
        beam_type        = readInteger(target_address + 0x00),
        radius           = readFloat(target_address   + 0x04),
        length           = readFloat(target_address   + 0x08),
        damage_info_type = readInteger(target_address + 0x0C),
        focal_shoulder_width   = readFloat(target_address   + 0x10),
        decal_size             = readFloat(target_address   + 0x28),
        beam_effect_path       = readQword(target_address   + 0x30), --// resource hash, e.g. LaserCannon 2215274758992860742
        raycast_template       = readInteger(target_address + 0x50),
        hit_effect_damage_type = readInteger(target_address + 0x58),
        explosion_type         = readInteger(target_address + 0x64)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


-- //! =========================================================================
-- //!  ================     B E A M   P A R A M S  (per weapon)     ===========
-- //! =========================================================================
-- //  BeamWeaponComponentData, keyed by weapon UID (compdata_db["beam_params"])
-- //  Record size 0x78. Mapped 2026-10-14.
-- //  NOTE: beam_effect_path is NOT here - it is in Beam Settings at +0x30.
-- //  path_30 / path_40 / path_50 / path_5C are resource hashes whose purpose
-- //  is not confirmed yet; unk_* fields are unidentified.
function locateBeamParamsAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "beam_params"
    local struct_size = 0x78
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_BeamParams_Data(target_unique_id)
    local target_info    = locateBeamParamsAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx              = target_info.idx,
        address          = target_address,
        beam_settings    = readInteger(target_address + 0x00), --// index into beam settings (LC=1, Scythe=8, Dagger=11)
        unk_0C           = readFloat(target_address   + 0x0C), --// 180.0 on most
        unk_10           = readFloat(target_address   + 0x10), --// 1.0 on most
        unk_14           = readFloat(target_address   + 0x14),
        unk_18           = readFloat(target_address   + 0x18), --// 10.0 on most
        unk_1C           = readFloat(target_address   + 0x1C), --// 5.0 on most
        path_30          = readQword(target_address   + 0x30), --// unique per weapon
        unk_38           = readInteger(target_address + 0x38),
        path_40          = readQword(target_address   + 0x40), --// shared in groups
        unk_48           = readFloat(target_address   + 0x48), --// 0.25
        id_4C            = readInteger(target_address + 0x4C), --// 32-bit id (sound event?)
        path_50          = readQword(target_address   + 0x50), --// unknown path (same on most player beams)
        id_58            = readInteger(target_address + 0x58),
        path_5C          = readQword(target_address   + 0x5C),
        unk_64           = readInteger(target_address + 0x64),
        unk_68           = readInteger(target_address + 0x68),
        unk_6C           = readInteger(target_address + 0x6C),
        unk_70           = readFloat(target_address   + 0x70),
        unk_74           = readInteger(target_address + 0x74)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

