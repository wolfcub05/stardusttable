-- //! =========================================================================
-- //!                    Read Status Effect Parameters
-- //! =========================================================================
function getAddressStatusEffectSettings(target_id)
    local struct_size = 0x98
    local output_addr = AddressHandler(target_id, "status_effect", struct_size)
    return output_addr
end

function Read_StatusEffect_Data(input_str_idx)
    local statuseffect_idx = readIndexedString(StatusEffectDatabaseOUT, input_str_idx)
    local target_address = getAddressStatusEffectSettings(statuseffect_idx)
    fullAccess(target_address, 0x98)
    local output_template = {
        address    = target_address,
        target_id  = statuseffect_idx,
        shader_variable_preset     = readInteger(target_address + 0x10),
        shader_env_qword           = readQword(target_address + 0x18),
        shader_env_fade_time       = readFloat(target_address + 0x20),
        strength                   = readFloat(target_address + 0x24),
        duration                   = readFloat(target_address + 0x28),
        damage_info_type           = readInteger(target_address + 0x2C),
        damage_ignore_avatar_armor = readInteger(target_address + 0x30),
        difficult_terrain_amount   = readFloat(target_address + 0x60),

        }
        byteprep_64 =  readInt_bin13digits(target_address + 0x064)
        output_template.unique_effect              = tonumber(byteprep_64:sub(1, 1))
        output_template.no_susceptibility_required = tonumber(byteprep_64:sub(2, 2))
        output_template.audio_event_master_only    = tonumber(byteprep_64:sub(3, 3))
        output_template.block_sprint               = tonumber(byteprep_64:sub(4, 4))
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


