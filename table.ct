{$lua}
-- //! =========================================================================
--                           Turret Component Data
-- //! =========================================================================
function locateTurretComponentAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "turret_params"
    local struct_size = 0x4C
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_TurretInfo_Data(target_unique_id)
    local target_info    = locateTurretComponentAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx								= target_info.idx,
        address							= target_address,
        vertical_anim					= readInteger(target_address + 0x000),
        horizontal_anim					= readInteger(target_address + 0x004),
        turn_speed_vertical				= readFloat(target_address   + 0x008),
        turn_speed_horizontal			= readFloat(target_address   + 0x00C),
        ratio_exponent					= readFloat(target_address 	 + 0x010),
        vertical_limit_min				= readFloat(target_address   + 0x014),
        vertical_limit_max				= readFloat(target_address   + 0x018),
        horizontal_limit_min			= readFloat(target_address   + 0x01C),
        horizontal_limit_max            = readFloat(target_address   + 0x020),
        trigger_rotation_sound_timer	= readFloat(target_address   + 0x024),
        trigger_pitch_sound_timer       = readFloat(target_address   + 0x028),
        pivot_node        				= readInteger(target_address + 0x048)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


