--=====================================================================
-- HD2PKG - native package loader (shared by the Mount Forge Assets add-on
-- and the Squad Asset Loader). Asks Helldivers 2 to load a package through
-- the game's own RefcountedPackageSystem request, the same call the game
-- makes when a player carries an item. Build: HD2 7.1.0 (game.dll 0x4744000).
--
-- Safety:
--  * Fails closed: the exact code bytes of the request function and the
--    shape of the reference table / engine package list are proven first.
--    After a game update nothing is called until the offsets are updated.
--  * Only package ids from the whitelist (the generated table) are accepted.
--  * Each package is requested once per game session and never released,
--    because vehicles already on the map use the assets without holding a
--    reference. Restarting the game resets everything.
--  * Budget: 32 packages per session, reference table must stay under 50%.
--  * The call runs on a CE-created thread (like the manual test). The game
--    function takes no lock, so request while nothing else is changing
--    loadouts (ship, or mid-mission - not on the loading screen).
--=====================================================================
HD2PKG = HD2PKG or {}
local P = HD2PKG
P.VERSION = "1.0"

P.REQ_RVA   = 0x12FE350      -- game.dll: RefcountedPackageSystem::request(system, const u64 *ids, u32 count)
P.INST_RVA  = 0x347CEB0      -- game.dll: pointer to the RefcountedPackageSystem instance
P.MGR_RVA   = 0x1A10208      -- helldivers2.exe: engine globals -&gt; +0x400 package manager
P.REQ_PROOF = { 0x45,0x85,0xC0,0x0F,0x84,0x75,0x01,0x00,0x00,0x41,0x56,0x41,0x57,0x48,0x83,0xEC,
                0x38,0x48,0x89,0x5C,0x24,0x50,0x4C,0x8B,0xFA,0x48,0x89,0x6C,0x24,0x58,0x4C,0x8B,
                0xF1,0x48,0x89,0x74,0x24,0x60,0x48,0x89,0x7C,0x24,0x30,0x4C,0x89,0x64,0x24,0x28 }
P.BOOT_ID   = 0x9BA626AFA44A3AA3 -- packages/boot: always in the engine list, used to prove its layout
P.MAX_HELD  = 32
P.MAX_FILL  = 0.50

P.held    = P.held or {}      -- hex id -&gt; {t = os.clock() of request}
P.session = P.session or nil

local function hex(id) return string.format("%016X", id) end
P.hex = hex

-- "1A3DC966179BD5A4" -&gt; 64-bit integer (Lua 5.3 wraps, which is what we want)
function P.parse(s)
  s = tostring(s):gsub("^0[xX]", ""):upper()
  if not s:match("^%x+$") or #s ~= 16 then return nil end
  return math.tointeger(tonumber(s:sub(1, 8), 16) &lt;&lt; 32 | tonumber(s:sub(9, 16), 16))
end

local function ptr(a) local v = a and readPointer(a); if v == nil or v == 0 then return nil end; return v end

local function session_key()
  local pid = getOpenedProcessID and getOpenedProcessID() or 0
  local dll = getAddressSafe("game.dll") or 0
  return string.format("%d:%X", pid, dll)
end

-- Proves every native assumption. Returns pins table or nil, reason.
function P.prove()
  local key = session_key()
  if P.session ~= key then P.session = key; P.held = {}; P.pins = nil end   -- new game session
  if P.pins then return P.pins end
  local dll, exe = getAddressSafe("game.dll"), getAddressSafe("helldivers2.exe")
  if not dll or not exe then return nil, "helldivers2.exe / game.dll not found (attach CE to the game)" end
  local req = dll + P.REQ_RVA
  local b = readBytes(req, #P.REQ_PROOF, true)
  if not b then return nil, "request function unreadable" end
  for i = 1, #P.REQ_PROOF do
    if b[i] ~= P.REQ_PROOF[i] then return nil, "request function changed (game update?) - loader disabled" end
  end
  local inst = ptr(dll + P.INST_RVA)
  if not inst then return nil, "package system not initialised" end
  local cap, ent = readInteger(inst + 8), ptr(inst)
  if not cap or cap &lt; 16 or cap &gt; 65536 or cap % 2 ~= 0 or not ent then
    return nil, "reference table shape changed - loader disabled"
  end
  local mgr = ptr(ptr(exe + P.MGR_RVA) and (ptr(exe + P.MGR_RVA) + 0x400))
  local res = mgr and ptr(mgr + 0x208)
  local cnt = res and readInteger(res + 0x80)
  if not res or not cnt or cnt &lt; 1 or cnt &gt; 8192 then return nil, "engine package list not found - loader disabled" end
  local pins = { dll = dll, exe = exe, req = req, inst = inst, cap = cap, ent = ent, res = res }
  P.pins = pins
  if P.state(P.BOOT_ID) == "absent" then P.pins = nil; return nil, "engine package list layout changed - loader disabled" end
  return pins
end

-- Fraction of the reference table in use, and whether an id is referenced.
function P.table_info(id)
  local p = assert(P.pins)
  local used, count = 0, nil
  for i = 0, p.cap - 1 do
    local k = readQword(p.ent + i * 16)
    if k and k ~= 0 then
      used = used + 1
      if id and k == id then count = readInteger(p.ent + i * 16 + 8) end
    end
  end
  return used / p.cap, count, used
end

-- 'resident' | 'loading' (parts still loading) | 'absent'
function P.state(id)
  local p = P.pins
  if not p then return "absent" end
  local cnt, list = readInteger(p.res + 0x80), ptr(p.res + 0x88)
  if not cnt or not list or cnt &gt; 8192 then return "absent" end
  for i = 0, cnt - 1 do
    local pk = ptr(list + i * 8)
    if pk and readQword(pk + 0x10) == id then
      local parts, arr = readInteger(pk + 0x18) or 0, ptr(pk + 0x20)
      if parts == 0 or parts &gt; 4096 or not arr then return "loading" end
      for k = 0, parts - 1 do
        local part = ptr(arr + k * 8)
        if not part or readInteger(part + 0x1C) ~= 4 then return "loading" end
      end
      return "resident"
    end
  end
  return "absent"
end

-- Requests the given ids (integers) that this session does not hold yet.
-- Returns list of newly requested hex ids, or nil, reason.
function P.request(ids)
  local pins, why = P.prove()
  if not pins then return nil, why end
  local todo = {}
  for _, id in ipairs(ids) do
    local h = hex(id)
    if not P.held[h] then todo[#todo + 1] = id end
  end
  if #todo == 0 then return {} end
  local n = 0; for _ in pairs(P.held) do n = n + 1 end
  if n + #todo &gt; P.MAX_HELD then return nil, ("budget reached (%d packages per session)"):format(P.MAX_HELD) end
  local fill = P.table_info()
  if fill &gt; P.MAX_FILL then return nil, ("game reference table %.0f%% full - refusing"):format(fill * 100) end
  P.buf = P.buf or allocateMemory(8 * P.MAX_HELD)
  if not P.buf then return nil, "could not allocate the id buffer" end
  for i, id in ipairs(todo) do writeQword(P.buf + (i - 1) * 8, id) end
  local r = executeCodeEx(0, 5000, pins.req, { type = 0, value = pins.inst }, { type = 0, value = P.buf }, { type = 0, value = #todo })
  local out = {}
  for _, id in ipairs(todo) do
    local _, c = P.table_info(id)
    if c then P.held[hex(id)] = { t = os.clock() }; out[#out + 1] = hex(id) end
  end
  if #out &lt; #todo then return out, "some requests did not register (call returned " .. tostring(r) .. ")" end
  return out
end

function P.selfcheck()
  local lines = {}
  local function add(s) lines[#lines + 1] = s end
  P.pins = nil
  local pins, why = P.prove()
  add("HD2PKG " .. P.VERSION .. "  session " .. tostring(P.session))
  if not pins then add("  NOT OK: " .. why); return table.concat(lines, "\n"), false end
  add(("  request fn   game.dll+%X  bytes OK"):format(P.REQ_RVA))
  local fill, _, used = P.table_info()
  add(("  ref table    %d / %d used (%.1f%%)"):format(used, pins.cap, fill * 100))
  add(("  engine list  %d packages (boot package found)"):format(readInteger(pins.res + 0x80)))
  local held = 0
  for h in pairs(P.held) do held = held + 1; add(("  held %s  %s"):format(h, P.state(P.parse(h)))) end
  add(("  held by loader this session: %d / %d"):format(held, P.MAX_HELD))
  return table.concat(lines, "\n"), true
end

--=====================================================================
-- MOUNT FORGE ASSETS v1.0 - cross-faction mount loader for Mount Forge
--
-- A mount from another faction (e.g. the Barrager's rocket turret on the
-- FRV on a bug planet) shows as a purple question mark because its assets
-- only load on that faction's planets. This add-on loads what a mount
-- needs through the game's own package loader when you apply it:
--   * the package that holds the mount's model, and
--   * the faction content package that holds its firing effects.
-- Loads take about a second and also fix mounts already on the map.
--
-- Everyone who should see the mount needs it loaded on THEIR game:
-- MFA.share() copies a squad code; squadmates paste it into the
-- Squad Asset Loader.
--
-- Console: MFA.gui()  MFA.loadCurrent()  MFA.status()  MFA.share()
--          MFA.selfcheck()  MFA.needs("Tank Turret Missiles")
--=====================================================================
MFA = MFA or {}
MFA.VERSION = "1.0"
if MFA.auto == nil then MFA.auto = true end

local function say(s)
  if MFA.logFn then pcall(MFA.logFn, s) end
  if MF and MF.say then MF.say(s) else print(s) end
end
MFA.say = say

local function mb(ids)
  local t = 0
  for _, h in ipairs(ids) do local p = MFA.PACKAGES[h]; if p then t = t + p[2] end end
  return t
end

-- Packages a Mount Forge path (entity uid string or name) needs.
function MFA.needs(path)
  local uid = path
  if MF and MF.pathUid and not tostring(path):match("^%d+$") then
    local ok, v = pcall(MF.pathUid, path); if ok then uid = v end
  end
  return MFA.NEEDS[tostring(uid)] or {}, tostring(uid)
end

local function describe(ids)
  local t = {}
  for _, h in ipairs(ids) do
    local p = MFA.PACKAGES[h]
    t[#t + 1] = ("%s (%.0f MB)"):format(p and p[1] or h, p and p[2] or 0)
  end
  return table.concat(t, ", ")
end

-- pending hex ids -&gt; {label, t0}
MFA.pending = MFA.pending or {}

local function startWatch()
  if MFA.timer then return end
  MFA.timer = createTimer(nil)
  MFA.timer.Interval = 500
  MFA.timer.OnTimer = function(t)
    local left = 0
    for h, info in pairs(MFA.pending) do
      local st = HD2PKG.state(HD2PKG.parse(h))
      if st == "resident" then
        say(("[MFA] loaded: %s (%.1f s)"):format(MFA.PACKAGES[h] and MFA.PACKAGES[h][1] or h, os.clock() - info.t0))
        MFA.pending[h] = nil
      elseif os.clock() - info.t0 &gt; 90 then
        say(("[MFA] still %s after 90 s: %s - the mount may show as missing"):format(st, MFA.PACKAGES[h] and MFA.PACKAGES[h][1] or h))
        MFA.pending[h] = nil
      else
        left = left + 1
      end
    end
    if left == 0 then t.destroy(); MFA.timer = nil end
  end
end

-- Loads the packages for a list of hex ids (whitelist only). Non-blocking.
function MFA.ensure(ids, label)
  local want = {}
  for _, h in ipairs(ids) do
    if MFA.PACKAGES[h] and not HD2PKG.held[h] then want[#want + 1] = HD2PKG.parse(h) end
  end
  if #want == 0 then return true end
  local done, why = HD2PKG.request(want)
  if not done then say("[MFA] not loaded (" .. tostring(label) .. "): " .. tostring(why)); return false end
  if #done &gt; 0 then
    say(("[MFA] %s -&gt; requested %s"):format(label or "?", describe(done)))
    for _, h in ipairs(done) do MFA.pending[h] = { t0 = os.clock() } end
    startWatch()
  end
  if why then say("[MFA] warning: " .. why) end
  return true
end

-- All packages the slots of one Mount Forge record need.
function MFA.recordNeeds(rec)
  local seen, ids = {}, {}
  for i = 1, (MF.SLOTS or 5) do
    local s = rec.slots and rec.slots[i]
    if s and s.path and s.path ~= "0" then
      for _, h in ipairs(MFA.NEEDS[s.path] or {}) do
        if not seen[h] then seen[h] = true; ids[#ids + 1] = h end
      end
    end
  end
  return ids
end

function MFA.ensureRecord(rec)
  local ids = MFA.recordNeeds(rec)
  if #ids &gt; 0 then return MFA.ensure(ids, rec.label or rec.uidStr) end
  return true
end

-- Everything currently edited in Mount Forge (records that differ from their backup).
function MFA.loadCurrent()
  local n = 0
  for uid, rec in pairs(MF.cache or {}) do
    if not rec.locked then MFA.ensureRecord(rec); n = n + 1 end
  end
  say(("[MFA] checked %d edited platform(s)"):format(n))
end

function MFA.status()
  local ok = HD2PKG.prove()
  local lines = { "[MFA] packages held this session:" }
  local any = false
  for h in pairs(HD2PKG.held) do
    any = true
    lines[#lines + 1] = ("   %s  %-40s %s"):format(h, MFA.PACKAGES[h] and MFA.PACKAGES[h][1] or "?",
      ok and HD2PKG.state(HD2PKG.parse(h)) or "?")
  end
  if not any then lines[#lines + 1] = "   (none)" end
  say(table.concat(lines, "\n"))
end

-- Squad code: every package this session holds. Squadmates paste it into the Squad Asset Loader.
function MFA.share()
  local ids = {}
  for h in pairs(HD2PKG.held) do ids[#ids + 1] = h end
  table.sort(ids)
  if #ids == 0 then say("[MFA] nothing loaded yet - apply a cross-faction mount first"); return nil end
  local code = "MFA1:" .. table.concat(ids, ",")
  if writeToClipboard then writeToClipboard(code) end
  say(("[MFA] squad code (copied to clipboard, %.0f MB):\n%s"):format(mb(ids), code))
  return code
end

function MFA.selfcheck()
  local txt = HD2PKG.selfcheck()
  say(txt)
  say(("[MFA] table: %d mounts, %d packages; auto-load on apply: %s"):format(
    (function() local n = 0 for _ in pairs(MFA.NEEDS) do n = n + 1 end return n end)(),
    (function() local n = 0 for _ in pairs(MFA.PACKAGES) do n = n + 1 end return n end)(),
    tostring(MFA.auto)))
end

--------------------------------------------------------------------- hook
-- Wraps MF.apply: before a platform is written, its mounts' packages are
-- requested. The write itself is never blocked or changed.
function MFA.hook()
  if MFA.origApply then return end
  MFA.origApply = MF.apply
  MF.apply = function(rec)
    if MFA.auto then
      local r = rec
      if type(r) == "string" then local ok, v = pcall(MF.read, r); r = ok and v or nil end
      if type(r) == "table" and r.uidStr and MF.editable(r.uidStr) then
        local ok, e = pcall(MFA.ensureRecord, r)
        if not ok then say("[MFA] error: " .. tostring(e)) end
      end
    end
    return MFA.origApply(rec)
  end
end

function MFA.unhook()
  if MFA.origApply then MF.apply = MFA.origApply; MFA.origApply = nil end
  if MFA.timer then MFA.timer.destroy(); MFA.timer = nil end
  if MFA.form then pcall(function() MFA.form.destroy() end); MFA.form = nil end
end

---------------------------------------------------------------------- GUI
function MFA.gui()
  if MFA.form then MFA.form.show(); return end
  local f = createForm(false)
  f.Caption = "Mount Forge Assets " .. MFA.VERSION
  f.Width, f.Height = 560, 330
  f.Position = "poScreenCenter"
  local memo = createMemo(f)
  memo.Left, memo.Top, memo.Width, memo.Height = 8, 72, 544, 250
  memo.ReadOnly = true
  memo.ScrollBars = "ssVertical"
  pcall(function() memo.Font.Name = "Consolas" end)
  MFA.logFn = function(s) memo.Lines.Add(s) end
  local function btn(cap, l, t, w, fn)
    local b = createButton(f)
    b.Caption, b.Left, b.Top, b.Width, b.Height = cap, l, t, w, 26
    b.OnClick = function() local ok, e = pcall(fn); if not ok then memo.Lines.Add("[MFA] error: " .. tostring(e)) end end
    return b
  end
  btn("Load for current mounts", 8, 8, 170, MFA.loadCurrent)
  btn("Status", 184, 8, 80, MFA.status)
  btn("Copy squad code", 270, 8, 130, MFA.share)
  btn("Self-check", 406, 8, 90, MFA.selfcheck)
  local cb = createCheckBox(f)
  cb.Caption, cb.Left, cb.Top, cb.Width = "Load automatically when a mount is applied", 8, 42, 360
  cb.Checked = MFA.auto
  cb.OnChange = function() MFA.auto = cb.Checked end
  f.OnClose = function() MFA.logFn = nil; MFA.form = nil; return caFree end
  MFA.form = f
  f.show()
  MFA.selfcheck()
end

