-- //! =========================================================================
--                           ShowOnMap Component Data
-- //! =========================================================================

function locateShowOnMapAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "ShowOnMap"
    local struct_size = 0x30
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_ShowOnMap_Data(target_unique_id)
    local target_info    = locateShowOnMapAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        }
        output_template["start_revealed"]         = readByte(target_address  + 0x000)
        output_template["is_discoverable"]        = readByte(target_address  + 0x001)
        output_template["icon"]                   = readQword(target_address + 0x008)
        output_template["discovery_cleared_icon"] = readQword(target_address + 0x010)
