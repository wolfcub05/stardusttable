-- //! =========================================================================
--                           Spray Component Data
-- //! =========================================================================

function locateSprayComponentAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "spray_params"
    local struct_size = 0xE0
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end

function Read_Spray_Data(target_unique_id)
    local target_info    = locateSprayComponentAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx             = target_info.idx,
        address         = target_address,
        warmup_time     = readFloat(target_address + 0x000),
        cooldown_time   = readFloat(target_address + 0x004),
        firenode_pose   = readFloat(target_address + 0x008),
        spray_capsule_radius = readFloat(target_address + 0x010),
        warmup = {
            shake = {
                world_shake_effect = readQword(target_address + 0x018),
                local_shake_effect = readQword(target_address + 0x020),
                fpv_shake_effect   = readQword(target_address + 0x028),
                inner_radius       = readFloat(target_address   + 0x030),
                outer_radius       = readFloat(target_address   + 0x034)},
            muzzle_effect = readQword(target_address + 0x038)},
        firing = {
            shake = {
                world_shake_effect = readQword(target_address + 0x050),
                local_shake_effect = readQword(target_address + 0x058),
                fpv_shake_effect   = readQword(target_address + 0x060),
                inner_radius       = readFloat(target_address   + 0x068),
                outer_radius       = readFloat(target_address   + 0x06C)},
            muzzle_effect = readQword(target_address + 0x070)},
        cooldown = {
            shake = {
                world_shake_effect = readQword(target_address + 0x088),
                local_shake_effect = readQword(target_address + 0x090),
                fpv_shake_effect   = readQword(target_address + 0x098),
                inner_radius       = readFloat(target_address   + 0x0A0),
                outer_radius       = readFloat(target_address   + 0x0A4)},
            muzzle_effect = readQword(target_address + 0x0A8)},
        ammo_cost = readInteger(target_address + 0x0C0),
        ptype     = readInteger(target_address + 0x0C4),
        damage_info_type = readInteger(target_address + 0x0C8),
        hit_effect_damage_type  = readInteger(target_address + 0x0CC),
        particle_triggers_mines = readInteger(target_address + 0x0D0),
        collision_fire_template = readInteger(target_address + 0x0DC)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


