-- Prints keys ordered by db[key].type_num
function print_db_keys_by_type_num(db_name, db)
    local items = {}

    for key, value in pairs(db) do
        table.insert(items, { key = key, type_num = value.type_num or math.huge })
    end

    table.sort(items, function(a, b)
        if a.type_num == b.type_num then
            return a.key &lt; b.key
        end
        return a.type_num &lt; b.type_num
    end)

    print(db_name .. " = {")
    for _, item in ipairs(items) do
        print("    " .. item.key)
    end
    print("}")
end

-- Returns the key name for a given type_num inside a database table.
-- Example return: "ElementType_Fire"
function get_key_by_type_num(db, target_type_num)
    for key, value in pairs(db) do
        if value and value.type_num == target_type_num then
            return key
        end
    end
    return nil
end

-- Optional helper if you also want to include the database name in one string.
-- Example return: "ElementTypeDatabaseOUT.ElementType_Fire"
function get_db_and_key_by_type_num(db_name, db, target_type_num)
    local key = get_key_by_type_num(db, target_type_num)
    if not key then
        return nil
    end
    return db_name .. "." .. key
end


-- Finds the key name in a database by type_num
local function get_key_by_type_num(db, target_type_num)
    for key, value in pairs(db) do
        if value and value.type_num == target_type_num then
            return key
        end
    end
    return nil
end

-- Prints explosion + linked damage info
function print_explosion_damage_report(target_expl_str)
    local target_explosion_info = Read_ExplosiveSettings_Data(target_expl_str)
    if not target_explosion_info then
        print("Explosion not found: " .. tostring(target_expl_str))
        return
    end

    print("Explosion: " .. tostring(target_expl_str))
    print("    Explosion Inner Radius: " .. tostring(target_explosion_info.DATA.inner_radius))
    print("    Explosion Outer Radius: " .. tostring(target_explosion_info.DATA.outer_radius))
    print("    Explosion Stagger Radius: " .. tostring(target_explosion_info.DATA.stagger_radius))

    local damage_type_num = target_explosion_info.backup and target_explosion_info.backup.damage_type
    local local_damage_type_str = get_key_by_type_num(DamageSettingsDatabaseOUT, damage_type_num)

    print(tostring(local_damage_type_str))

    if not local_damage_type_str then
        print("Damage type not found for type_num: " .. tostring(damage_type_num))
        return
    end

    local damage_type = Read_DamageSettings_Data(local_damage_type_str)
    if not damage_type then
        print("Damage settings not found: " .. tostring(local_damage_type_str))
        return
    end

    print("Damage: " .. tostring(local_damage_type_str))
    print("    Damage: " .. tostring(damage_type.DATA.damage_std) .. " || " .. tostring(damage_type.DATA.damage_drb))
    print(
        "    AP Values: "
        .. tostring(damage_type.DATA.ap_vals.ap1) .. " || "
        .. tostring(damage_type.DATA.ap_vals.ap2) .. " || "
        .. tostring(damage_type.DATA.ap_vals.ap3) .. " || "
        .. tostring(damage_type.DATA.ap_vals.ap4)
    )
end


-- Prints explosion info (radii) + its linked damage info, with a label prefix
function print_explosion_block(label, expl_type_num)
    local expl_str = get_key_by_type_num(ExplosionSettingsDatabaseOUT, expl_type_num)
    if not expl_str or expl_str == "ExplosionType_None" then -- ← add this
        print(label .. ": &lt;not found, type_num=" .. tostring(expl_type_num) .. "&gt;")
        return
    end

    local expl_info = Read_ExplosiveSettings_Data(expl_str)
    if not expl_info then
        print(label .. ": &lt;no data for " .. expl_str .. "&gt;")
        return
    end

    print(label .. ": " .. expl_str)
    print("    Inner Radius:   " .. tostring(expl_info.DATA.inner_radius))
    print("    Outer Radius:   " .. tostring(expl_info.DATA.outer_radius))
    print("    Stagger Radius: " .. tostring(expl_info.DATA.stagger_radius))

    local dmg_str = get_key_by_type_num(DamageSettingsDatabaseOUT, expl_info.backup.damage_type)
    if not dmg_str then
        print("    Damage: &lt;not found, type_num=" .. tostring(expl_info.backup.damage_type) .. "&gt;")
        return
    end

    local dmg = Read_DamageSettings_Data(dmg_str)
    if not dmg then
        print("    Damage: &lt;no data for " .. dmg_str .. "&gt;")
        return
    end

    print("    Damage: " .. dmg_str)
    print("        Damage: " .. tostring(dmg.DATA.damage_std) .. " || " .. tostring(dmg.DATA.damage_drb))
    print(
        "        AP Values: "
        .. tostring(dmg.DATA.ap_vals.ap1) .. " || "
        .. tostring(dmg.DATA.ap_vals.ap2) .. " || "
        .. tostring(dmg.DATA.ap_vals.ap3) .. " || "
        .. tostring(dmg.DATA.ap_vals.ap4)
    )
end

-- Prints full projectile report: direct damage type + both explosion types
function print_projectile_report(projectile_str, unique_projectile_id)
    local proj = Read_ProjectileInfo_Data(projectile_str, unique_projectile_id)
    if not proj then
        print("Projectile not found: " .. tostring(projectile_str))
        return
    end

    print("Projectile: " .. tostring(projectile_str))

    -- Direct damage type
    local dmg_str = get_key_by_type_num(DamageSettingsDatabaseOUT, proj.DATA.damage_info_type)
    if dmg_str and dmg_str ~= "DamageInfoType_None" then  -- ← change the if condition
        local dmg = Read_DamageSettings_Data(dmg_str)
        print("    Damage: " .. tostring(dmg.DATA.damage_std) .. " || " .. tostring(dmg.DATA.damage_drb))
        print(
            "    AP Values: "
            .. tostring(dmg.DATA.ap_vals.ap1) .. " || "
            .. tostring(dmg.DATA.ap_vals.ap2) .. " || "
            .. tostring(dmg.DATA.ap_vals.ap3) .. " || "
            .. tostring(dmg.DATA.ap_vals.ap4)
        )
    else
        print("Damage: &lt;not found, type_num=" .. tostring(proj.DATA.damage_info_type) .. "&gt;")
    end

    -- Explosion on impact
    print_explosion_block("Explosion (Impact)", proj.DATA.explosion_type_impact)

    -- Explosion on expire
    print_explosion_block("Explosion (Expire)", proj.DATA.explosion_type_expire)
end


