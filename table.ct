-- //! =========================================================================
--                           interactable Component Data
-- //! =========================================================================

function locateInteractableAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "interactable"
    local struct_size = 0x450
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_Interactable_Data(target_unique_id)
    local target_info    = locateInteractableAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        zone1 = {
            radius        = readFloat(target_address + 0x00C),
            view_distance = readFloat(target_address + 0x010),
            auto_interact = readByte(target_address  + 0x080)},
        zone2 = {
            radius        = readFloat(target_address + 0x094),
            view_distance = readFloat(target_address + 0x098),
            auto_interact = readByte(target_address  + 0x108)},
        zone3 = {
            radius        = readFloat(target_address + 0x11C),
            view_distance = readFloat(target_address + 0x120),
            auto_interact = readByte(target_address  + 0x190)},
        zone4 = {
            radius        = readFloat(target_address + 0x1A4),
            view_distance = readFloat(target_address + 0x1A8),
            auto_interact = readByte(target_address  + 0x218)},
        zone5 = {
            radius        = readFloat(target_address + 0x22C),
            view_distance = readFloat(target_address + 0x230),
            auto_interact = readByte(target_address  + 0x2A0)},
        zone6 = {
            radius        = readFloat(target_address + 0x2B4),
            view_distance = readFloat(target_address + 0x2B8),
            auto_interact = readByte(target_address  + 0x328)},
        zone7 = {
            radius        = readFloat(target_address + 0x33C),
            view_distance = readFloat(target_address + 0x340),
            auto_interact = readByte(target_address  + 0x3B0)},
        zone8 = {
            radius        = readFloat(target_address + 0x3C4),
            view_distance = readFloat(target_address + 0x3C8),
            auto_interact = readByte(target_address  + 0x438)},
        }
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


