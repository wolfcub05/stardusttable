-- //! =========================================================================
--                           Mount Component Data
-- //! =========================================================================

function mountSymbol(Mount_db_name)
         --get mount
         local mount = Mount_db[Mount_db_name]
         if mount == nil then
            print("mountSymbol: Mount_db:"..Mount_db_name.." not found")
            return 0
         end

         local target_address = Read_Mount_Data(mount.uid).DATA.address
         --print("ArmorPassiveSymbol ArmorPassiveAddress:"..ArmorPassiveAddress.." target_address:"..target_address.. " armor.offset:"..armor.offset)
         unregisterSymbol(Mount_db_name)
         registerSymbol(Mount_db_name, target_address, true)

         return

end

function mountReset(Mount_db_name)
         local mount = Mount_db[Mount_db_name]
         if mount == nil then
            print("mountReset: Mount_db:"..Mount_db_name.." not found")
            return
         end
         local mountb = MountBackup[mount.uid]
         if mountb ~= nil then
            Apply_Mount_Data(mountb)
         end

         return
end

function mountSymbolReset(Mount_db_name)
         --get mount
         mountReset(Mount_db_name)
         unregisterSymbol(Mount_db_name)
         return
end



----------- read and write functions

function locateMountAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end

    local target_db   = "mount_params"
    local struct_size = 0x78
    local uid_idx     = UID_Localizator(input_uid_str, compdata_db[target_db])

    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    -- Calculate the final address
    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)

    fullAccess(output_address, struct_size)
    return {
        idx     = uid_idx,
        address = output_address
    }
end

MountBackup = MountBackup or {}

function MountBackupReset()
         MountBackup = {}
end

function Read_Mount_Data(target_unique_id)

    local backup = MountBackup[target_unique_id]
    if backup == nil then
       local target_info    = locateMountAddress(target_unique_id)
       local target_address = target_info.address

       local mount_template = {
          address = target_address,
          idx     = target_info.idx,
          uid     = target_unique_id,
          -- Path 1 [cite: 6]
          path_1        = string.format("%u", readQword(target_address + 0x00)),
          attach_node_1 = readInteger(target_address + 0x08),
          mount_side_1  = readInteger(target_address + 0x0C),
          name_1        = readInteger(target_address + 0x10),
          unknown_1     = readInteger(target_address + 0x14),
          -- Path 2 [cite: 7]
          path_2        = string.format("%u", readQword(target_address + 0x18)),
          attach_node_2 = readInteger(target_address + 0x20),
          mount_side_2  = readInteger(target_address + 0x24),
          name_2        = readInteger(target_address + 0x28),
          unknown_2     = readInteger(target_address + 0x2C),
          -- Path 3 [cite: 8]
          path_3        = string.format("%u", readQword(target_address + 0x30)),
          attach_node_3 = readInteger(target_address + 0x38),
          mount_side_3  = readInteger(target_address + 0x3C),
          name_3        = readInteger(target_address + 0x40),
          unknown_3     = readInteger(target_address + 0x44),
          -- Path 4
          path_4        = string.format("%u", readQword(target_address + 0x48)),
          attach_node_4 = readInteger(target_address + 0x50),
          mount_side_4  = readInteger(target_address + 0x54),
          name_4        = readInteger(target_address + 0x58),
          unknown_4     = readInteger(target_address + 0x5C),
          -- Path 5 [cite: 9]
          path_5        = string.format("%u", readQword(target_address + 0x60)),
          attach_node_5 = readInteger(target_address + 0x68),
          mount_side_5  = readInteger(target_address + 0x6C),
          name_5        = readInteger(target_address + 0x70),
          unknown_5     = readInteger(target_address + 0x74)
       }
       backup = deepcopy(mount_template)
       MountBackup[target_unique_id] = backup

       return {backup = backup, DATA = mount_template}
    else
       return {backup = backup, DATA = deepcopy(backup)}
    end

end


