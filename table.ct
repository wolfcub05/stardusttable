-- //! =========================================================================
--                           Mount Component Data
-- //! =========================================================================
-- 64-bit values above 2^63 can't be passed to writeQword as decimal text or as a float
-- (they end up as 0), so turn number-or-text into the exact 64-bit integer first.
local function U64(v)
    if math.type(v) == "integer" then return v end
    if type(v) == "number" then return math.tointeger(v) or 0 end
    local n = 0
    for d in tostring(v or 0):gmatch("%d") do n = n * 10 + tonumber(d) end
    return n
end

function Apply_Mount_Data(target_data)
    local target_address = target_data.address

    -- Slot 1
    writeQword(target_address + 0x00, U64(target_data.path_1))
    writeInteger(target_address + 0x08, target_data.attach_node_1)
    writeInteger(target_address + 0x0C, fromStringtoMemory(MountSideDatabaseOUT, target_data.mount_side_1))
    writeInteger(target_address + 0x10, target_data.name_1)
    writeInteger(target_address + 0x14, target_data.unknown_1)

    -- Slot 2
    writeQword(target_address + 0x18, U64(target_data.path_2))
    writeInteger(target_address + 0x20, target_data.attach_node_2)
    writeInteger(target_address + 0x24, fromStringtoMemory(MountSideDatabaseOUT, target_data.mount_side_2))
    writeInteger(target_address + 0x28, target_data.name_2)
    writeInteger(target_address + 0x2C, target_data.unknown_2)

    -- Slot 3
    writeQword(target_address + 0x30, U64(target_data.path_3))
    writeInteger(target_address + 0x38, target_data.attach_node_3)
    writeInteger(target_address + 0x3C, fromStringtoMemory(MountSideDatabaseOUT, target_data.mount_side_3))
    writeInteger(target_address + 0x40, target_data.name_3)
    writeInteger(target_address + 0x44, target_data.unknown_3)

    -- Slot 4
    writeQword(target_address + 0x48, U64(target_data.path_4))
    writeInteger(target_address + 0x50, target_data.attach_node_4)
    writeInteger(target_address + 0x54, fromStringtoMemory(MountSideDatabaseOUT, target_data.mount_side_4))
    writeInteger(target_address + 0x58, target_data.name_4)
    writeInteger(target_address + 0x5C, target_data.unknown_4)

    -- Slot 5
    writeQword(target_address + 0x60, U64(target_data.path_5))
    writeInteger(target_address + 0x68, target_data.attach_node_5)
    writeInteger(target_address + 0x6C, fromStringtoMemory(MountSideDatabaseOUT, target_data.mount_side_5))
    writeInteger(target_address + 0x70, target_data.name_5)
    writeInteger(target_address + 0x74, target_data.unknown_5)
end
