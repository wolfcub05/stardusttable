function RegisterPassive(passive_str_name)
    local target_offset  = readIndexedPassive(passive_str_name)
    local base_address   = readPointer(simple_pointers["armor_passives"]) + 0x1C
    local target_address = base_address + target_offset
    local num_pass      = readInteger(target_address + 0x18)
    local num_stat_mods = readInteger(target_address + 0x28)
    target_template = {
        address      = target_address,
        passive_name = passive_str_name,
        num_pass  = num_pass,
        offset    = target_offset}
    passives = {}
    for i = 1, num_pass do
        local mod_offset = 0x38 + (i - 1) * 0x10
        local mod_id    = readInteger(target_address + mod_offset)
        local mod_type  = readInteger(target_address + mod_offset + 0x04)
        local mod_value = readFloat(target_address + mod_offset + 0x08)
        local mod_desc  = readInteger(target_address + mod_offset + 0x0C)
        passives[i] = {
            mod_id    = mod_id,
            mod_type  = mod_type,
            mod_value = mod_value,
            mod_desc  = mod_desc}
    end
    target_template["passives"] = passives
    stat_modifiers = {}
    for i = 1, num_stat_mods do
        local mod_offset = 0x38 + (num_pass * 0x10) + (i - 1) * 0x0C
        local mod_type   = readInteger(target_address + mod_offset)
        local add_value  = readFloat(target_address   + mod_offset + 0x04)
        local mul_value  = readFloat(target_address   + mod_offset + 0x08)
        stat_modifiers[i] = {
            type       = mod_type,
            add_value  = add_value,
            mul_value  = mul_value}
    end
    target_template["stat_modifiers"] = stat_modifiers
    return {backup = deepcopy(target_template), DATA = deepcopy(target_template)}
end

