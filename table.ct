        unknown_434 = readByte(target_address + 0x434),
        unknown_435 = readByte(target_address + 0x435),
        unknown_436 = readByte(target_address + 0x436),
        unknown_437 = readByte(target_address + 0x437)
    }
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end
