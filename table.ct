        second_value = {0x008, 1.0, "Float"},
        third_value  = {0x010, 1.0, "Float"}
    }

    is_pointer_candidate = CheckConditionsCandidates(hex_address, sttvol_stratagem_specs)
    if is_pointer_candidate == true then
        print("Pointer for Status Volume Stratagems: : " .. hex_address)
        simple_pointers["status_volume"] = hex_address
    end

    --// =============    Resupply
    resupply_stratagem_specs   = {
        min_items  = 1,
        max_items  = 10,
        first_value  = {0x004, 867876502, "Integer"},
        second_value = {0x018, 1263463686, "Integer"},
        third_value  = {0x01C, 1673875834, "Integer"}
    }

    is_pointer_candidate = CheckConditionsCandidates(hex_address, resupply_stratagem_specs)
    if is_pointer_candidate == true then
        print("Pointer for resupply Stratagems: : " .. hex_address)
        simple_pointers["strat_resupply"] = hex_address
    end

    --// =============    mission
    mission_stratagem_specs   = {
        min_items  = 22,
        max_items  = 50,
        first_value  = {0x004, 2186648412, "Integer"},
        second_value = {0x018, 2186648412, "Integer"},
        third_value  = {0x01C, 2363192702, "Integer"}
    }

    is_pointer_candidate = CheckConditionsCandidates(hex_address, mission_stratagem_specs)
    if is_pointer_candidate == true then
        print("Pointer for mission Stratagems: : " .. hex_address)
        simple_pointers["strat_mission"] = hex_address
    end

end

function GetSimplePointers_Iterative()
    local pointers_dict = {}
    local hex_idx
    local hex_address, int_number, amount_items
    local output_str, hex_pointer, substring_end


    -- //! =========================================================
    for hex_idx = -0x090000, 0x90000, 0x08 do --// 0xD000, 0x08 do
        --// This will iterate from 0 to 0xD000 with step 0x08
        hex_address = Get_Address_Dicts(hex_idx)
        local cond_met = CheckValidInput(hex_address)
        if cond_met == true then
            int_number   = readInteger(readPointer(hex_address))
            amount_items = readInteger(readPointer(hex_address) - 0x08)
            output_str   = string.format("Hex Addr: %s || Amount of items: %d", hex_address, amount_items)
            hex_pointer   = string.format("%X", readPointer(hex_address))
            substring_end = string.sub(hex_pointer, -4, -1)
            if substring_end == "002C" then
                FilterCandidates_2C(hex_address)
            elseif substring_end == "0064" then
                FilterCandidates_64(hex_address)
            else
                FilterCandidates_XX(hex_address)
            end
        end
    end
end



CheckSimplePointerStatus()
if needed_auto_heal == true then
    GetSimplePointers_Iterative()
end

