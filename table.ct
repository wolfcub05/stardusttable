warrant_damage.DATA.ap_vals.ap2 = 3
warrant_damage.DATA.ap_vals.ap3 = 3
warrant_damage.DATA.ap_vals.ap4 = 3
warrant_damage.DATA.momentum.stagger = 15
warrant_damage.DATA.momentum.knkback = 10

