                    <CheatEntry>
                      <ID>1800001095</ID>
                      <Description>"[Beltfed GL] Cat-2 Special (Cosmetic Desync)"</Description>
                      <LastState/>
                      <Color>8080FF</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{
This script is made for Stardust's balance patch! If you're using this in a
different table there may be some weirdness in terms of the description below,
becasue it assumes you're using my table as a baseline! Other people's tables
have different defaults, so the text below's original values may not be accurate!

        Cat-2 Special
        [Unstable Overclock]
~~ Completely overhauls the grenade launcher to be more like a high powered AP4 Shotgun.
+ Increased ergonomics (20 --&gt; 27)
- Less reserve ammo (150 --&gt; 110)
- Locked to the lowest firerate (160, 240, 320 --&gt; 160)
- Increased spread (1, 1 --&gt; 180, 180)
-- The following is the stats of the shotgun:
- Shotgun does a total of 1080 damage per shot (90 x 12) and 360 durable (30 x 12)
- Pellets have AP4
- Pellets have 35 Stagger force
- Pellets have 20 Demo force
- Pellets have Extremely high drag (2.0)

}
{$lua}
-- //! GL-28 Belt Fed Grenade Launcher
--Appears to be based on the AGS-17 or similar belt-fed automatic grenade launchers, and firing a 30mm grenade given the significantly reduced damage-per-round vs the other 40mm grenade launchers in the game.
--Linked-belt electronically fired versions of this weapon have been in use since the 1970's.
Belt_Shotgun_damage = Read_DamageSettings_Data("DamageInfoType_Projectile_Shotgun_12g_magtri")
Belt_Shotgun_projectile  = Read_ProjectileInfo_Data("ProjectileType_Shotgun_12g_magtri", 9854668298113416351)
belt_fed_grenade_launcher_weaponinfo  = Read_WeaponInfo_Data(9854668298113416351)
belt_fed_grenade_launcher_deposit     = Read_DepositBackpack_Data(13495904577777136893)
belt_fed_grenade_launcher_hpod_settings = Read_SupportWeapons_Data("StratagemType_BeltGrenadeLauncher")

Belt_Shotgun_damage.DATA.damage_std = 90 --(Breakthrough mech is 90)
Belt_Shotgun_damage.DATA.damage_drb = 30 --(Breakthrough mech is 30)
Belt_Shotgun_damage.DATA.ap_vals.ap1 = 4 --(Breakthrough mech is 4)
Belt_Shotgun_damage.DATA.ap_vals.ap2 = 4 --(Breakthrough mech is 4)
Belt_Shotgun_damage.DATA.ap_vals.ap3 = 3 --(Breakthrough mech is 4)
Belt_Shotgun_damage.DATA.ap_vals.ap4 = 0 --(Breakthrough mech is 0)
Belt_Shotgun_damage.DATA.demolition = 20 --(Breakthrough mech is 20)
Belt_Shotgun_damage.DATA.momentum.stagger = 35 --(Breakthrough mech is 40)
Belt_Shotgun_damage.DATA.momentum.knkback = 30 --(Breakthrough mech is 30)

Belt_Shotgun_projectile.DATA.num_projectiles = 12 --(Breakthrough mech is 40)
Belt_Shotgun_projectile.DATA.drag = 2 --(Breakthrough mech is 1.2)
Belt_Shotgun_projectile.DATA.ptype                   = "ProjectileType_Shotgun_12g_magtri"

Belt_Shotgun_projectile.DATA.rpm.x             = 160 --(Breakthrough mech is 180)
Belt_Shotgun_projectile.DATA.rpm.y             = 160 --(Breakthrough mech is 180)
Belt_Shotgun_projectile.DATA.rpm.z             = 160 --(Breakthrough mech is 180)

belt_fed_grenade_launcher_weaponinfo.DATA.rounds.right_fn = "WeaponFunctionType_None"
belt_fed_grenade_launcher_weaponinfo.DATA.spread.infox = 180 --(Breakthrough mech is 200)
belt_fed_grenade_launcher_weaponinfo.DATA.spread.infoy = 180 --(Breakthrough mech is 200)
belt_fed_grenade_launcher_weaponinfo.DATA.handling.ergonomics = 27 --20

belt_fed_grenade_launcher_deposit.DATA.capacity             = 110 --100
belt_fed_grenade_launcher_deposit.DATA.init                 = -1 -- -1
belt_fed_grenade_launcher_deposit.DATA.refill               = 54 --54

--belt_fed_grenade_launcher_hpod_settings.DATA.cd_success  = 30

Apply_DamageSettings_Modifications(Belt_Shotgun_damage.DATA)
Apply_ProjectileInfo_Modifications(Belt_Shotgun_projectile.DATA)
Apply_WeaponInfo_Modifications(belt_fed_grenade_launcher_weaponinfo.DATA)
Apply_DepositBackpack_Modifications(belt_fed_grenade_launcher_deposit.DATA)
Apply_Stratagems_Modifications(belt_fed_grenade_launcher_hpod_settings.DATA)

{$asm}
[DISABLE]
{$lua}

Apply_DamageSettings_Modifications(Belt_Shotgun_damage.backup)
Apply_ProjectileInfo_Modifications(Belt_Shotgun_projectile.backup)
Apply_WeaponInfo_Modifications(belt_fed_grenade_launcher_weaponinfo.backup)
Apply_DepositBackpack_Modifications(belt_fed_grenade_launcher_deposit.backup)
Apply_Stratagems_Modifications(belt_fed_grenade_launcher_hpod_settings.backup)
</AssemblerScript>
