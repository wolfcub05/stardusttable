-- //! =========================================================================
--                           Minefield Component Data
-- //! =========================================================================
function locateMinefieldComponentAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "minefield_params"
    local struct_size = 0x2C
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end



function Read_Minefield_Data(target_unique_id)
    local target_info    = locateMinefieldComponentAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        trigger_sound = readInteger(target_address + 0x004),
        trigger_time  = readFloat(target_address   + 0x008),
        chain_rx_time = readFloat(target_address   + 0x00C),
        arm_time      = readFloat(target_address   + 0x010),
        trigger_actor = readInteger(target_address + 0x014),
        explosiontype = readInteger(target_address + 0x018),
        ai_avoidradii = readFloat(target_address   + 0x01C),
        trigger_touch = readInteger(target_address + 0x020),
        min_unit_size = readInteger(target_address + 0x024)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


