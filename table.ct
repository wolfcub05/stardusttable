{
Fallout's version 1.0
7/14/26
}
{$lua}

function Set_DamageElement_Type(input_table, damage_elem)
    if    damage_elem == "BLEED" then
        Set_DamageElement_Type_BLEED(input_table)
    elseif damage_elem == "GAS" then
        Set_DamageElement_Type_GAS(input_table)
    elseif damage_elem == "ACID" then
        Set_DamageElement_Type_ACID(input_table)
    elseif damage_elem == "FIRE" then
        Set_DamageElement_Type_FIRE(input_table)
    elseif damage_elem == "ELECTRIC" then
        Set_DamageElement_Type_ELECTRIC(input_table)
    elseif damage_elem == "STUN" then
        Set_DamageElement_Type_STUN(input_table)
    end
end


