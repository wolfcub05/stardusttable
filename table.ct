function MF.editable(uidStr) return MF.PLATFORMS[uidStr] == true end

function MF.name(uidStr)
  local t = MF.tags and MF.tags[uidStr] ; if t then return t.name end
  local e = MF.byUid[uidStr]
  return e and e.name or nil
end
function MF.cat(uidStr)
  local t = MF.tags and MF.tags[uidStr] ; if t then return t.cat end
  local e = MF.byUid[uidStr]
  return e and e.cat or nil
end

-- Accepts: friendly name (case-insensitive, partial ok) | decimal uid | number.
-- ALWAYS returns a canonical decimal STRING. UIDs are never round-tripped
-- through a Lua number here - that is what loses precision above 2^63.
local function resolve(v, what)
  if v == nil then return "0" end
  if type(v) == "number" then return MF.ustr(v) end
  local s = tostring(v)
  -- "#42" / "idx42" / "@42" address a mount_params record by its index,
  -- which is the only handle most unnamed enemy records have.
  local ix = s:match("^#%s*(%d+)$") or s:match("^[iI][dD][xX]%s*(%d+)$") or s:match("^@%s*(%d+)$")
  if ix then
    local u = MF.at(ix)
    if u then return u end
    error(("MF: no mount_params record at index %s"):format(ix), 3)
  end
  if s:match("^%d+$") then return (s:gsub("^0+(%d)", "%1")) end
  if s:match("^0[xX]%x+$") then return MF.ustr(MF.u64(s)) end
  local exact = MF.byName[s:lower()]
  if exact then return exact end
  local needle, found, count, sample = s:lower(), nil, 0, {}
  for name, uid in pairs(MF.byName) do
    if name:find(needle, 1, true) then
      found = uid ; count = count + 1
      if #sample &lt; 4 then sample[#sample + 1] = name end
    end
  end
  if count == 1 then return found end
  if count &gt; 1 then
    error(("MF: '%s' matches %d entries (e.g. %s) - be more specific")
          :format(s, count, table.concat(sample, ", ")), 3)
  end
  error(("MF: unknown %s '%s'. Pass the raw decimal UID instead."):format(what, s), 3)
end

-- both return a canonical decimal string
function MF.entityUid(v) return resolve(v, "entity") end
function MF.pathUid(v)   return resolve(v, "path")   end
function MF.pathName(uidStr)   return MF.name(uidStr) or ("uid:" .. uidStr) end
function MF.entityName(uidStr)
  if MF.whatIs == nil then return MF.name(uidStr) or ("uid:" .. uidStr) end
  return (MF.whatIs(uidStr)) or ("uid:" .. uidStr)
end
-- "Autocannon [SUPPORT WEAPONS]" / "uid:123 [?]"
function MF.label(uidStr)
  if uidStr == nil or uidStr == "0" then return "(empty)" end
  if MF.whatIs == nil then                       -- during load, before section 3b
    local e = MF.byUid[uidStr]
    return e and (e.name .. " [" .. e.cat .. "]") or ("uid:" .. uidStr .. " [?]")
  end
  local nm, _, cat = MF.whatIs(uidStr)
  if nm then return nm .. " [" .. (cat or "?") .. "]" end
  return "uid:" .. uidStr .. " [?]"
end

--=============================================================
-- 3b. INDEX / IDENTIFICATION / TAGS / CATEGORIES
--
-- Most mount_params records are enemies and props that the Mount
-- Editor dropdowns never named, so they show up as a bare idx and a
-- 20-digit uid. Three things fix that:
--   1. index addressing  - "#42" works anywhere an entity is expected
--   2. identification    - guess the entity from its attach nodes
--   3. tags              - name anything yourself, permanently
--=============================================================
