                      <LastState/>
                      <Color>00FF00</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{
  Game   : helldivers2.exe
  Version: 1.500.000
  Date   : 2025-12-05
  Author : MIAUSISI || MEOWSISI

  WEAPONS BALANCE TABLE
}
{$lua}
-- //! =================    U I D    L O C A L I Z A T O R    =================

function UID_Localizator(target_uid, target_database)
    target_uid = string.format("%u", target_uid)
    local function find()
        for idx, uid in pairs(target_database) do
            if uid == target_uid then
                return idx - 1
            end
        end
    end
    local found = find()
    if found then return found end
    --// 2026-10-07: not in the list made when CORE was turned on - in case the game rebuilt this
    --// table since, read it from the game once more and look again.
    local name
    for key, db in pairs(compdata_db) do
        if db == target_database then name = key end
    end
    if name and compdata_offsets[name] and vals_compdata_offsets[name] then
        baseaddr_pointer        = readPointer(compdata_baseaddr)
        compdata_pointers[name] = readPointer(baseaddr_pointer + compdata_offsets[name])
        values_compdata[name]   = compdata_pointers[name] + vals_compdata_offsets[name]
        local fresh = Generate_Single_Database(name)
        for key in pairs(target_database) do target_database[key] = nil end
        for key, uid in pairs(fresh) do target_database[key] = uid end
        found = find()
        if found then return found end
    end
    --// Before 2026-10-07 this returned 0, so the script silently edited the FIRST entity of that
    --// table instead. Now the locate functions get nil and use a scratch block (UID_Scratch):
    --// the script still turns on, its other entities are edited, this one is left alone.
    UID_MISSING = UID_MISSING or {}
    local key = (name or "?") .. " " .. target_uid
    if not UID_MISSING[key] then
        UID_MISSING[key] = true
        print(string.format("[CORE] UID %s is not in %s (entity no longer in the game or has no such component) - skipped, nothing written for it.", target_uid, name or "this table"))
    end
    return nil
end

function Generate_Single_Database(pointer_str_name)
    local target_addr
    local output_db = {}
    local beg_address = compdata_pointers[pointer_str_name]
    local end_address =   values_compdata[pointer_str_name]
    --// Debug: print("Init address: " .. beg_address)
    --// Debug: print("End address: " .. end_address)

    for target_addr = beg_address, end_address - 0x0010, 0x0010 do
        target_uid = readQword_str(target_addr)
        if target_uid ~= "0" then
            --// Adds the values to "output_db"
            aux_uid = readInteger(target_addr + 0x0008)
            output_db[aux_uid + 1] = target_uid --// Debug:
            --// Debug:out_str = string.format("UID: %s || Idx: %d", target_uid, aux_uid+1)
            --// Debug:print(out_str)
        end
    end
    return output_db
end

function GenerateDatabases()
    local output_database = {}
    local key, val
    for key in pairs(values_compdata) do
        --// Debug:print("Checking Database: " .. key)--// Debug:
        if key ~= "EntityDeltas" then
            output_database[key] = Generate_Single_Database(key)
        end
    end
    return output_database
end

--// Stand-in record for a UID that is not in the game: reads give zeros, writes go nowhere.
function UID_Scratch(struct_size)
    if not UID_SCRATCH or UID_SCRATCH == 0 then UID_SCRATCH = allocateMemory(0x10000) end
    local zero = {}
    for i = 1, math.min(struct_size or 0x1000, 0x10000) do zero[i] = 0 end
    writeBytes(UID_SCRATCH, zero)
    return UID_SCRATCH
end

compdata_db = GenerateDatabases()

