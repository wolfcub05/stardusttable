--// ============    Get Weapon Data CompData UID Address
function locateWeaponDataAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "weapondata"
    local struct_size = 0x4D0
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end

function Read_WeaponInfo_Data(target_unique_id)
    local target_info    = locateWeaponDataAddress(target_unique_id)
    local target_address = target_info.address
    local weapondata_template = {
        idx      = target_info.idx,
        address  = target_address,
        recoil   = {x     = readFloat(target_address + 0x000),
                    y     = readFloat(target_address + 0x004),
                    xbias = readFloat(target_address + 0x010),
                    randx = readFloat(target_address + 0x014),
                    randy = readFloat(target_address + 0x018)},
        climb    = {x     = readFloat(target_address + 0x01C),
                    y     = readFloat(target_address + 0x020),
                    xbias = readFloat(target_address + 0x02C),
                    randx = readFloat(target_address + 0x030),
                    randy = readFloat(target_address + 0x034),
                    wielder_animation_recoil_amount_increment_per_shot = readFloat(target_address + 0x038)
                    },
        multip   = {recoilx = readFloat(target_address + 0x03C),
                    recoily = readFloat(target_address + 0x040),
                    driftx  = readFloat(target_address + 0x044),
                    drifty  = readFloat(target_address + 0x048),
                    climbx  = readFloat(target_address + 0x04C),
                    climby  = readFloat(target_address + 0x050)},
        spread   = {infox   = readFloat(target_address + 0x054),
                    infoy   = readFloat(target_address + 0x058),
                    unknown_5C = readInteger(target_address + 0x05C),
                    multipx = readFloat(target_address + 0x060),
                    multipy = readFloat(target_address + 0x064)},
        handling = {sway_mlt             = readFloat(target_address + 0x068),
                    aim_block_length     = readFloat(target_address + 0x06C),
                    scope_sway           = readFloat(target_address + 0x080),
                    ergonomics           = readFloat(target_address + 0x164),
                    unknown_168          = readFloat(target_address + 0x168),
                    unknown_16C          = readInteger(target_address + 0x16C),
                    unknown_170          = readFloat(target_address + 0x170),
                    unknown_174          = readFloat(target_address + 0x174),
                    unknown_178          = readFloat(target_address + 0x178),
                    unknown_17C          = readFloat(target_address + 0x17C),
                    constrained_aim_leading = readByte(target_address + 0x180),
                    allow_fpv               = readByte(target_address + 0x181),
                    allow_aiming            = readByte(target_address + 0x182),
                    unknown_183             = readByte(target_address + 0x183)},
        scope   =  {aimzoomx   = readFloat(target_address + 0x074),
                    aimzoomy   = readFloat(target_address + 0x078),
                    aimzoomz   = readFloat(target_address + 0x07C),
                    offsetx    = readFloat(target_address + 0x13C),
