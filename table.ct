function printHex(input_var)
    if input_var == nil then
        return
    end
    if type(input_var) ~= "number" then
        print(input_var)
        return
    end
    output_str = string.format("%X", input_var)
    print(output_str)
end


function Dec2Hex(dec_number)
    local output_hex = tonumber(string.format("%X", dec_number), 16)
    return output_hex
end

function Hex2Dec(hex_number)
    local output_dec = tonumber(string.format("%d", hex_number))
    return output_dec
end

function fromStringtoMemory(target_database, target_string)
    if type(target_string) == "number" then
        return target_string
    end
    return target_database[target_string]["type_num"]
end


function GetAddressFromCompDataOffset(target_str)
    -- // Usage: printHex(GetAddressFromCompDataOffset(compdata_offsets["projectiles"]))
    return Dec2Hex(readPointer(baseaddr_pointer + target_str))
end


function readIndexedString(target_database, target_string)
    return target_database[target_string]["type_idx"]
end




function readIndexedPassive(target_string)
    return PassiveBonusesDatabaseOUT[target_string]["offset"]
end


function NumberToBinary(number)
  local remainder = ""
  while number &gt; 0 do
        remainder = tostring(number % 2)..remainder
        number = math.floor(number/2)
  end
  return remainder
end


--// Given an integer, it transforms into binary format
--// with 5 digits at most using NumberToBinary,
--// inverts the position of the digits, and returns it as a string.
function readInt_bin5digits(address)
    local value = readInteger(address)
    local binary = NumberToBinary(value)
    -- Invert the digits
    local inverted_binary = binary:reverse()
    -- Pad with zeros to ensure it has 5 digits
    while #inverted_binary &lt; 5 do
        inverted_binary = inverted_binary .. "0"
    end
    return inverted_binary
end


--// Similar to readInt_bin5digits, given an integer,
--// it transforms them into binary format with 13 digits at most using NumberToBinary,
--// inverts the position of the digits, and returns it as a string.
function readInt_bin13digits(address)
    local value = readInteger(address)
    local binary = NumberToBinary(value)
    -- Invert the digits
    local inverted_binary = binary:reverse()
    -- Pad with zeros to ensure it has 13 digits
    while #inverted_binary &lt; 13 do
        inverted_binary = inverted_binary .. "0"
    end
    return inverted_binary
end

-- // This function simplifies my previous method of naming certain data
-- // as strings.
-- // Input:
-- //     string: The string you want to format.
-- //     address: The address of the integer you want to read.
-- // Output:
-- //     A formatted string with the integer value.
-- // Example:
-- //     readInt_str("Weapon Charge: %d", target_address + 0x069420)
-- //     ==&gt; "Weapon Charge: 42"
function readInt_str(string, address)
    local value = readInteger(address)
    return string.format(string, value)
end

-- // This function allows for a ulong to be read properly:
-- //     1. By default, readQword is reading data as a signed integer.
-- //        That means, it can output negative numbers!
-- //     2. With this function, is properly read as an unsigned integer,
-- //        meaning that we can have a proper UID.
-- //
-- // Input:
-- //     address: The address of what you want to read.
-- // Output:
-- //     A string with an unsigned integer.
-- // Example:
-- //     readQword_str(target_address + 0x069420)
-- //     ==&gt; "11804315310924160597"
function readQword_str(address)
    local value = readQword(address)
    return string.format("%u", value)
end



