    writeFloat(target_address   + 0x094, target_data.combat.drift.speed)
    writeInteger(target_address + 0x098, target_data.combat.drift.locomotion_set)
    writeFloat(target_address  + 0x0A8, target_data.combat.reposition.min_time_stationary)
    writeFloat(target_address  + 0x0AC, target_data.combat.reposition.max_time_stationary)
    writeFloat(target_address  + 0x0B0, target_data.combat.reposition.min_time_repositioning)
    writeFloat(target_address  + 0x0B4, target_data.combat.reposition.max_time_repositioning)
