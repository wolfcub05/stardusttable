{$lua}
function printHex(input_var)
    if input_var == nil then
        return
    end
    if type(input_var) ~= "number" then
        print(input_var)
        return
    end
    output_str = string.format("%X", input_var)
    print(output_str)
end
--// printHex(getAddress("game.dll"))






LAST_KNOWN_OFFSET = 0x1CAAB88--0x2057000
function Get_Address_Dicts(offset_hex_idx)
    local output_dict = {}
    local base_offset = LAST_KNOWN_OFFSET + offset_hex_idx
    --// Get mock address
    local mock_address = string.format("game.dll + %X", base_offset)
    --// Get tuple from mock address
    local first_value  = readQword(mock_address)
    --// Print values:      print(string.format("Offset: %X, First Value: %d, Second Value: %d", base_offset, first_value, second_value))
    --// Check conditions

    if ( first_value &lt; 1000000000) then
        --// Return nil
        return nil
    end
    --// Return mock address
    return mock_address
end

function Get_Address_Dicts_old(offset_hex_idx)
    local output_dict = {}
    local base_offset = LAST_KNOWN_OFFSET + offset_hex_idx
    --// Get mock address
    local mock_address = string.format("game.dll + %X", base_offset)
    --// Get tuple from mock address
    local first_value  = readInteger(mock_address)
    local second_value = readInteger(string.format("%s + 0x04", mock_address))


    --// Print values:      print(string.format("Offset: %X, First Value: %d, Second Value: %d", base_offset, first_value, second_value))
    --// Check conditions

    if (    (first_value &lt; 1000000000 or first_value &gt; 7000000000)
        or (second_value &lt; 0          or second_value &gt; 5000)) then
        --// Return nil
        return nil
    end
    --// Return mock address
    return mock_address
end


function CheckValidInput(hex_address)
    local output_bool = false
    if hex_address ~= nil then
        local int_number = readInteger(readPointer(hex_address))
        if int_number ~= nil then
            if int_number &lt; 1000000000 then
                output_bool = true
            end
        end
    end
    return output_bool
end

function ReadValuesFromDict(base_address, input_subdict)
    local output_value = nil
    local output_bool  = false
    if input_subdict[3] == "Integer" then
        output_value = readInteger(base_address + input_subdict[1])
    elseif input_subdict[3] == "Float" then
        output_value = readFloat(base_address + input_subdict[1])
    elseif input_subdict[3] == "Qword" then
        output_value = readQword(base_address + input_subdict[1])
    end
    if output_value == input_subdict[2] then
        output_bool = true
    end
    return output_bool
end

function CheckConditionsCandidates(hex_address, input_dict)
    local amount_items = readInteger(readPointer(hex_address) - 0x08)
    local first_check, second_check, third_check
    local key, val
    local output_bool
    local pointer_addr = readPointer(hex_address)
    if   ((amount_items &gt;= input_dict["min_items"])
      and (amount_items &lt;= input_dict["max_items"])) then
        first_check  = ReadValuesFromDict(pointer_addr, input_dict["first_value"])
        second_check = ReadValuesFromDict(pointer_addr, input_dict["second_value"])
        third_check  = ReadValuesFromDict(pointer_addr, input_dict["third_value"])
        if first_check == true and second_check == true and third_check == true then
            return true
        end
    end
    return false
end

function FilterCandidates_64(hex_address)
    local is_pointer_candidate = false
    damage_specs = {
        min_items  = 525,
        max_items  = 650,
        first_value  = {0x000, 1,  "Integer"},
        second_value = {0x004, 50, "Integer"},
        third_value  = {0x008, 50, "Integer"}
    }
    is_pointer_candidate = CheckConditionsCandidates(hex_address, damage_specs)
    if is_pointer_candidate == true then
        print("Pointer for Damage: : " .. hex_address)
        simple_pointers["damage_weapons"] = hex_address
    end
end

