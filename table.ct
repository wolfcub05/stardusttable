                    unknown_150           = readInteger(target_address + 0x150),
                    zeroingx   = readFloat(target_address + 0x154),
                    zeroingy   = readFloat(target_address + 0x158),
                    zeroingz   = readFloat(target_address + 0x15C),
                    scope_hides_weapon    = readInteger(target_address + 0x160),
                    crosshair_type        = readInteger(target_address + 0x190),
                    alternate_crosshair_type        = readInteger(target_address + 0x19C)},
        suppresed = {is_suppressed   = readByte(target_address    + 0x070),
                     noise_template  = readInteger(target_address + 0x084),
                     visibility      = readFloat(target_address   + 0x088),
                     weapon_scream   = readInteger(target_address + 0x1D0)},
        rounds    = {num_burst          = readInteger(target_address + 0x08C),
                     primary_firemode   = readInteger(target_address + 0x090),
                     secondary_firemode = readInteger(target_address + 0x094),
                     tertiary_firemode  = readInteger(target_address + 0x098),
                     left_fn            = readInteger(target_address + 0x0B8),
                     right_fn           = readInteger(target_address + 0x0BC),
                     simultaneous_fire  = readInteger(target_address + 0x130),
                     on_fire_round_anim_event  = readInteger(target_address + 0x398),
                     on_fire_last_round_event  = readInteger(target_address + 0x39C),
                     on_fire_round_wielder_anim_event        = readInteger(target_address + 0x3A0),
                     on_fire_mode_changed_anim_variable      = readInteger(target_address + 0x3A4),
                     on_fire_mode_changed_wielder_anim_event = readInteger(target_address + 0x3A8),
                     },
        fire_nodes = {
            item1  = readInteger(target_address + 0x0CC),
            item2  = readInteger(target_address + 0x0D0),
            item3  = readInteger(target_address + 0x0D4),
            item4  = readInteger(target_address + 0x0D8),
            item5  = readInteger(target_address + 0x0DC),
            item6  = readInteger(target_address + 0x0E0),
            item7  = readInteger(target_address + 0x0E4),
            item8  = readInteger(target_address + 0x0E8),
            item9  = readInteger(target_address + 0x0EC),
            item10 = readInteger(target_address + 0x0F0),
            item11 = readInteger(target_address + 0x0F4),
            item12 = readInteger(target_address + 0x0F8),
            item13 = readInteger(target_address + 0x0FC),
            item14 = readInteger(target_address + 0x100),
            item15 = readInteger(target_address + 0x104),
            item16 = readInteger(target_address + 0x108),
            item17 = readInteger(target_address + 0x10C),
            item18 = readInteger(target_address + 0x110),
            item19 = readInteger(target_address + 0x114),
            item20 = readInteger(target_address + 0x118),
            item21 = readInteger(target_address + 0x11C),
            item22 = readInteger(target_address + 0x120),
            item23 = readInteger(target_address + 0x124),
            item24 = readInteger(target_address + 0x128),
            aim_source_node = readInteger(target_address + 0x12C)},
        fire_ability = readInteger(target_address + 0x3AC),
        unknown_3B0  = readInteger(target_address + 0x3B0),
        alternate_fire_ability = readInteger(target_address + 0x3B4),
        unknown_4B8 = readInteger(target_address + 0x4B8),
