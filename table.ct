        cooldown_moving_combat_min_distance = readFloat(target_address + 0x234),
        cooldown_moving_combat_max_distance = readFloat(target_address + 0x238),
        cooldown_standing                   = readFloat(target_address + 0x23C),
        cooldown_standing_combat            = readFloat(target_address + 0x240),
        cooldown_randomization              = readFloat(target_address + 0x244),
        unknown_204                         = readFloat(target_address + 0x248),
        cooldown_area_range                 = readFloat(target_address + 0x24C),
        unknown_20C                         = readFloat(target_address + 0x250),
        player_alert_range                  = readFloat(target_address + 0x254),
        player_alert_cooldown               = readFloat(target_address + 0x258),
        cooldown_id                         = readInteger(target_address  + 0x25C),
    }
    output_template["encounter_combat_time"] = readFloat(target_address + 0x260)
    output_template["target_share_radius"]   = readFloat(target_address + 0x268)
    output_template["use_feelers_navigation_distance"] = readFloat(target_address + 0x26C)
    output_template["interception_strength"] = readFloat(target_address + 0x270)
    --//! ===================== Offsets: 0x280 - 0x290 =========================
    output_template["nav_height_offset"]      = readFloat(target_address + 0x280)
    output_template["target_confirmation_lose_time"] = readFloat(target_address + 0x284)
