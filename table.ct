--// ============    Get Heat CompData UID Address
function locateHeatAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "heat_params"
    local struct_size = 0x250
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    fullAccess(output_address, struct_size)
    return output_info
end

function Read_HeatSettings_Data(target_unique_id)
    local target_info = locateHeatAddress(target_unique_id)
    local target_addr = target_info.address
    local output_template = {
        address                         = target_info.address,
        overheat_stages                 = {},
        magazines                       = readInteger(target_addr + 0x054),
        magazines_refill                = readInteger(target_addr + 0x058),
        magazines_max                   = readInteger(target_addr + 0x05C),
        overheat_temperature            = readFloat(target_addr   + 0x060),
        overheat_temperature_recover    = readFloat(target_addr   + 0x064),
        warning_temperature             = readFloat(target_addr   + 0x068),
        emission_temperature            = readFloat(target_addr   + 0x06C),
        temp_gain_per_shot              = readFloat(target_addr   + 0x074),
        temp_gain_per_second            = readFloat(target_addr   + 0x078),
        temp_gain_per_second_modifier   = readFloat(target_addr   + 0x07C),
        temp_loss_per_second            = readFloat(target_addr   + 0x080),
        temp_loss_modifier_extreme_heat = readFloat(target_addr   + 0x084),
        temp_loss_modifier_extreme_cold = readFloat(target_addr   + 0x088),
        temp_loss_per_second_overheated = readFloat(target_addr   + 0x08C),
        needs_reload_after_overheat     = readInteger(target_addr + 0x090),
        firing_charge                   = readFloat(target_addr   + 0x094),
        charge_gain_per_second          = readFloat(target_addr   + 0x098),
        charge_loss_per_second          = readFloat(target_addr   + 0x09C)}
    output_template.overheat_stages[1] = {
        temperature_threshold = readFloat(target_addr + 0x000),
        projectile_type       = readInteger(target_addr + 0x004),
        status_effect         = readInteger(target_addr + 0x014)}
    output_template.overheat_stages[2] = {
        temperature_threshold = readFloat(target_addr + 0x018),
        projectile_type       = readInteger(target_addr + 0x01C),
        status_effect         = readInteger(target_addr + 0x02C)}
    output_template.overheat_stages[3] = {
        temperature_threshold = readFloat(target_addr + 0x030),
        projectile_type       = readInteger(target_addr + 0x034),
        status_effect         = readInteger(target_addr + 0x044)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

