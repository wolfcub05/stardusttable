{$lua}
function AddressHandler(target_id, pointer_str_name, hex_struct_size)
    --[[
    Given the following elements:
    1. target_id (index ON MEMORY),
    2. pointer_str_name (check Simple Pointers -&gt; Manual Input)
    3. hex_struct_size (struct size in hexadecimal)

    Returns proper address where that element is located.
    --]]
    local hex_idx = string.format("%X", target_id)
    local target_pointer = readPointer(simple_pointers[pointer_str_name])
    local target_offset  = hex_struct_size * tonumber(hex_idx, 16)
    local output_address = target_pointer + target_offset
    return output_address
end

--// Example: printHex(AddressHandler(0, "damage_weapons", 0x4C))
{$asm}
