function Apply_Spray_Modifications(target_data)
    local target_address = target_data.address
    writeFloat(target_address + 0x000, target_data.warmup_time)
    writeFloat(target_address + 0x004, target_data.cooldown_time)
    writeFloat(target_address + 0x008, target_data.firenode_pose)
    writeFloat(target_address + 0x010, target_data.spray_capsule_radius)
    --// ==========================================================================
    --// ======================           WARM-UP          ========================
    --// ==========================================================================
    writeQword(target_address + 0x018, target_data.warmup.shake.world_shake_effect)
    writeQword(target_address + 0x020, target_data.warmup.shake.local_shake_effect)
    writeQword(target_address + 0x028, target_data.warmup.shake.fpv_shake_effect)
    writeFloat(target_address + 0x030, target_data.warmup.shake.inner_radius)
    writeFloat(target_address + 0x034, target_data.warmup.shake.outer_radius)
    writeQword(target_address + 0x038, target_data.warmup.muzzle_effect)
    --// ==========================================================================
    --// ======================           FIRING          ========================
    --// ==========================================================================
    writeQword(target_address + 0x050, target_data.firing.shake.world_shake_effect)
    writeQword(target_address + 0x058, target_data.firing.shake.local_shake_effect)
    writeQword(target_address + 0x060, target_data.firing.shake.fpv_shake_effect)
    writeFloat(target_address + 0x068, target_data.firing.shake.inner_radius)
    writeFloat(target_address + 0x06C, target_data.firing.shake.outer_radius)
    writeQword(target_address + 0x070, target_data.firing.muzzle_effect)
    --// ==========================================================================
    --// ======================           COOLDOWN        ========================
    --// ==========================================================================
    writeQword(target_address + 0x088, target_data.cooldown.shake.world_shake_effect)
    writeQword(target_address + 0x090, target_data.cooldown.shake.local_shake_effect)
    writeQword(target_address + 0x098, target_data.cooldown.shake.fpv_shake_effect)
    writeFloat(target_address + 0x0A0, target_data.cooldown.shake.inner_radius)
    writeFloat(target_address + 0x0A4, target_data.cooldown.shake.outer_radius)
    writeQword(target_address + 0x0A8, target_data.cooldown.muzzle_effect)
    --// ==========================================================================
    --// ==================          MISCELLANEOUS        ========================
    --// ==========================================================================
    writeInteger(target_address + 0x0C0, target_data.ammo_cost)
    writeInteger(target_address + 0x0C4, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_data.ptype))
    writeInteger(target_address + 0x0C8, fromStringtoMemory(DamageSettingsDatabaseOUT, target_data.damage_info_type))
    writeInteger(target_address + 0x0CC, fromStringtoMemory(HitEffectDamageTemplateDatabaseOUT, target_data.hit_effect_damage_type))
    writeInteger(target_address + 0x0D0, target_data.particle_triggers_mines)
    writeInteger(target_address + 0x0DC, fromStringtoMemory(FireTemplateDatabaseOUT, target_data.collision_fire_template))
end

