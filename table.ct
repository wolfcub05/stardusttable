{
    Game Name:     Helldivers 2
    Game Version:  1.005.001
    Author:        PRODIHUE
    Date:          2025-11-11
    Table Version: 3.4.0

    Equipment
    ----------
    -  This section of script is responsible for handling equipment
       information such as holstering, wielding, and looting.
}
{$lua}

-- //! =========================================================================
-- //! =============================== EQUIPMENT ===============================
-- //! =========================================================================
function locateEquipmentComponentAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "equipment"
    local struct_size = 0xE8
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]
    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end

function Read_EquipmentInfo_Data(target_unique_id)
    local target_info    = locateEquipmentComponentAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx							= target_info.idx,
        address						= target_address,
		wield_node  				= readInteger(target_address + 0x00),
		holster_duration  			= readFloat(target_address + 0x38),
		wield_duration  			= readFloat(target_address + 0x3C),
		pickup_duration  			= readFloat(target_address + 0x40),
		holster_duration_for_attach = readFloat(target_address + 0x60),
		wield_duration_for_attach 	= readFloat(target_address   + 0x64),
		drop_mode 					= readInteger(target_address + 0x88),
		grip_type					= readInteger(target_address + 0xC0),
		is_one_handed 				= readByte(target_address + 0xC4)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

