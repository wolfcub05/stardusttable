{$lua}

-- //! =========================================================================
--                           Ai Character Component Data
-- //! =========================================================================

function locateAiCharacterAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "AiCharacter"
    local struct_size = 0x50
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_AiCharacter_Data(target_unique_id)
    local target_info    = locateAiCharacterAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx             = target_info.idx,
        address         = target_address,
    }
    --//! ===================== Offsets: 0x000 - 0x028 =========================
    output_template["preferred_speed"] = readFloat(target_address + 0x000)
    output_template["maximum_speed"]   = readFloat(target_address + 0x004)
    output_template["fire_avoidance"]  = readFloat(target_address + 0x008)
    output_template["boids_cohesion_strength"] = readFloat(target_address + 0x00C)
    output_template["boids_optimal_distance"]  = readFloat(target_address + 0x010)
    output_template["boids_view_radius"]       = readFloat(target_address + 0x014)
    output_template["unknown_018"] = readByte(target_address + 0x018)
    output_template["unknown_019"] = readByte(target_address + 0x019)
    output_template["unknown_01A"] = readByte(target_address + 0x01A)
    output_template["unknown_01B"] = readByte(target_address + 0x01B)
    output_template["steering_properties"] = {
        collision_penalty           = readFloat(target_address + 0x01C),
        penetration_penalty         = readFloat(target_address + 0x020),
        wall_following_angle        = readFloat(target_address + 0x024),
        dodging_penalty             = readFloat(target_address + 0x028),
        velocity_hysteresis         = readFloat(target_address + 0x02C),
        sidedness_changing_penalty  = readFloat(target_address + 0x030),
        weight                      = readFloat(target_address + 0x034),
        priority                    = readInteger(target_address  + 0x038)
    }
    output_template["sensor_aabb"] = {
        bottom_extent = readFloat(target_address + 0x03C),
        top_extent    = readFloat(target_address + 0x040),
        half_width    = readFloat(target_address + 0x044)
    }
    output_template["default_mode"] = readInteger(target_address + 0x048)
    output_template["modulate_movespeed_on_turns"] = readByte(target_address + 0x04C)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


