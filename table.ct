-- Build name&lt;-&gt;id both ways by HASHING the pool. The pool stores names only;
-- the hash is the source of truth, so any name not in the pool still works.
MF.NODES, MF.NODE_NAME = {}, {}
for _, n in ipairs(MF.NODEPOOL) do
  local id = bignum.id32(n)
  MF.NODES[n] = id
  if MF.NODE_NAME[id] == nil then MF.NODE_NAME[id] = n end
end
-- Two legacy Patriot arm sockets whose real names were never recovered.
-- Verified against the toolkit's own "w/Shoulder Guns" reference scripts
-- (uncommented, live Read_Mount_Data() calls - not guesses). These four
-- node IDs never hash-matched any string in the attach-node dump, so they
-- are stored as literal numeric aliases rather than derived from a name.
--
-- Patriot / Emancipator / Breakthrough share ONE left/right shoulder pair.
-- Lumberer uses a DIFFERENT pair (attach_turret_l/r, hash-recovered above) -
-- confirmed by cross-checking all four exosuits' reference scripts, so do
-- not assume the pairs are interchangeable between walkers.
MF.NODES.exosuit_shoulder_l = 1137513325   -- Patriot/Emancipator/Breakthrough, Left
MF.NODES.exosuit_shoulder_r = 3282525496   -- Patriot/Emancipator/Breakthrough, Right
MF.NODE_NAME[1137513325] = MF.NODE_NAME[1137513325] or "exosuit_shoulder_l"
MF.NODE_NAME[3282525496] = MF.NODE_NAME[3282525496] or "exosuit_shoulder_r"
MF.NODES.ALIAS_patriot_missile = 1137513325   -- kept as an alias for anything already using this name
MF.NODES.ALIAS_patriot_gatling = 3282525496

-- Bastion Mk XVI cannon/HMG shoulder sockets. They are absent from the
-- attach-node dump, but their real names are in the game's thin-hash list:
-- attach_tank_gun / attach_tank_gun_mg (the TD-110 Maelstrom uses the same
-- two sockets). The old alias names keep working.
MF.NODES.bastion_cannon_socket = 3809236753   -- = attach_tank_gun,    slot 1, side Left
MF.NODES.bastion_hmg_socket    = 3085546557   -- = attach_tank_gun_mg, slot 2, side Right

-- Sockets used by player-side platforms that are not in the attach-node dump.
-- Names from the game's thin-hash list, so MF.hash32(name) reproduces each id.
for _, n in ipairs({ "attach_tank_gun", "attach_tank_gun_mg", "attach_turret", "attach_front_turret",
                     "attach_gun", "payload_left", "payload_right", "attach_smoke", "attach_silo_left",
                     "attach_silo_right", "gun_mount" }) do
  local id = bignum.id32(n)
  MF.NODES[n] = id
  MF.NODE_NAME[id] = n
end
-- Two FRV sockets whose real names are not in any hash list (literal ids).
MF.NODES.frv_cremator_tank_socket    = 1179913960   -- M-104 Incinerator FRV, Cremator fuel tank, side Common
MF.NODES.frv_supply_liberator_socket = 315954810    -- M-103 Supply FRV, Supply Liberator, side Common
MF.NODE_NAME[1179913960] = MF.NODE_NAME[1179913960] or "frv_cremator_tank_socket"
MF.NODE_NAME[315954810]  = MF.NODE_NAME[315954810]  or "frv_supply_liberator_socket"

-- expand the per-entity index lists into name lists, lazily
MF.NODEGROUPS = setmetatable({}, {__index = function(t, k)
  local raw = MF.NODEGROUPS_RAW[k]
  if raw == nil then return nil end
  local out = {}
  for i in raw:gmatch("%d+") do out[#out + 1] = MF.NODEPOOL[tonumber(i)] end
  rawset(t, k, out)
  return out
end})

-- self-test against a small independent probe set
MF.hashOK = false
do
  local total, hit = 0, 0
  for name, id in pairs(MF.HASH_PROBE) do
    total = total + 1
    if bignum.id32(name) == id then hit = hit + 1 end
  end
  MF.hashOK = (total &gt; 0 and hit == total)
  MF.hashScore = string.format("%d/%d", hit, total)
end

-- node("cockpit_aim") -&gt; 1357948804 ; accepts a raw number or numeric string too
function MF.node(v)
  if v == nil then return 0 end
  if type(v) == "number" then return v &amp; 0xFFFFFFFF end
  local s = tostring(v)
  if MF.NODES[s] then return MF.NODES[s] end
  if s:match("^%d+$") then return tonumber(s) &amp; 0xFFFFFFFF end
  if s:match("^0[xX]%x+$") then return tonumber(s:sub(3), 16) &amp; 0xFFFFFFFF end
  if MF.hashOK then
    local id = bignum.id32(s)
    MF.NODES[s] = id ; if MF.NODE_NAME[id] == nil then MF.NODE_NAME[id] = s end
    return id
  end
  error("MF.node: unknown node '"..s.."' and hashing self-test failed", 2)
end

function MF.nodeName(id)
  if id == 0 then return "(none)" end
  return MF.NODE_NAME[id] or ("#" .. tostring(id))
end

-- names valid for a given platform ("EXO-45 Patriot Exosuit" -&gt; its skeleton's nodes)
function MF.nodeGroup(entityName)
  local g = MF.NODEGROUP_FOR[entityName or ""]
  return g and MF.NODEGROUPS[g] or nil, g
end

function MF.hash64(s) return MF.ustr(bignum.mm64(s)) end
function MF.hash32(s) return bignum.id32(s) end

