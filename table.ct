    return output_info
end


function Read_Recharge_Data(target_unique_id)
    local target_info    = locateRechargeComponentAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx             = target_info.idx,
        address         = target_address,
        recharge_time   = readFloat(target_address + 0x00)
    }
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end
