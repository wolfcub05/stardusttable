    --//! ===================== Offsets: 0x218 - 0x27C =========================
    output_template["idle_vo"]  = {
        cooldown_moving_patrol              = readFloat(target_address + 0x224),
        cooldown_moving_investigate         = readFloat(target_address + 0x228),
