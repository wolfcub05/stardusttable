        output_template["size_y"]                 = readFloat(target_address + 0x01C)
        output_template["use_world_coord_size"]   = readInteger(target_address + 0x020)
        output_template["loc_string"]             = readInteger(target_address + 0x024)
        output_template["is_discovery_location"]  = readByte(target_address    + 0x028)
        output_template["revealed_by_map_pulse"]  = readByte(target_address    + 0x029)
        output_template["unknown_02B"]            = readByte(target_address    + 0x02B)
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end




