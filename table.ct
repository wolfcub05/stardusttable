function Read_Custom_Magazines(input_offset, struct_size)
    local base_addr   = GetEntityDeltasBaseAddr()
    local target_addr = base_addr + input_offset
    fullAccess(target_addr, struct_size)
    local custom_template = {
        address           = target_addr,
        struct_size       = struct_size,
        magazine_size 	  = readInteger(target_addr + 0x000),
        magazine_initial  = readInteger(target_addr + 0x004),
        magazine_max      = readInteger(target_addr + 0x008),
        magazine_refill   = readInteger(target_addr + 0x00C),
        reload_duration   =   readFloat(target_addr + struct_size - 0x004)}
    return {backup = deepcopy(custom_template), DATA = deepcopy(custom_template)}
end

function Apply_Custom_Magazines(target_data)
    local target_address = target_data.address
    local last_address   = target_address + target_data.struct_size
    writeInteger(target_address + 0x000, target_data.magazine_size)
    writeInteger(target_address + 0x004, target_data.magazine_initial)
    writeInteger(target_address + 0x008, target_data.magazine_max)
    writeInteger(target_address + 0x00C, target_data.magazine_refill)
    writeFloat(    last_address - 0x004, target_data.reload_duration)
end

