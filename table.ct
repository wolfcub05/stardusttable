    Equipment
    ----------
    -  This section of script is responsible for handling equipment
       information such as holstering, wielding, and looting.
}
{$lua}

-- //! =========================================================================
-- //!                         Apply Equipment CompData
-- //! =========================================================================
function Apply_EquipmentInfo_Modifications(target_data)
    local target_address = target_data.address
    writeInteger(target_address + 0x00, target_data.wield_node)
    writeFloat(target_address + 0x38, target_data.holster_duration)
    writeFloat(target_address + 0x3C, target_data.wield_duration)
    writeFloat(target_address + 0x40, target_data.pickup_duration)
    writeFloat(target_address + 0x60, target_data.holster_duration_for_attach)
    writeFloat(target_address   + 0x64, target_data.wield_duration_for_attach)
    writeInteger(target_address + 0x88, fromStringtoMemory(EquipmentDropModeDatabaseOUT, target_data.drop_mode))
    writeInteger(target_address + 0xC0, fromStringtoMemory(WeaponGripTypeDatabaseOUT,    target_data.grip_type))
    writeByte(target_address + 0xC4, target_data.is_one_handed)
end

