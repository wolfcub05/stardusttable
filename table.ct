Apply_ProjectileInfo_Modifications(gatling_gun_sentry_projectile.backup)
Apply_WeaponInfo_Modifications(gatling_gun_sentry_weaponinfo.backup)
Apply_MagazineSettings_Modifications(gatling_gun_sentry_magazine.backup)
Apply_MagazineSettings_Modifications(exo45_patriot_right_arm_magazine.backup)
Apply_ProjectileInfo_Modifications(exo45_patriot_right_arm_projectile.backup)
Apply_ProjectileInfo_Modifications(machine_sentry_gun_projectile.backup)
Apply_ProjectileInfo_Modifications(gatling_sentry_projectile.backup)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337316045</ID>
                  <Description>"[Health Pool] Super Helldiver"</Description>
                  <LastState/>
                  <Color>C08000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{
This script is made for Stardust's balance patch! If you're using this in a
different table there may be some weirdness in terms of the description below,
becasue it assumes you're using my table as a baseline! Other people's tables
have different defaults, so the text below's original values may not be accurate!

        Super Helldiver
        [Unstable Overclock]
++ Double the Main HP (125 --&gt; 250)
++ Significantly increased Head Health (85 --&gt; 165)
++ Significantly increased Torso Health (60 --&gt; 120)
+ Increased Arm health (35 --&gt; 65)
+ Increased Leg health (45 --&gt; 80)
-- Significantly weaker stims (Only heals around 1/3rd of your HP)
-- Significantly weaker stim pistol stims (Heals about 25% of your HP)
-- Medic armor &amp; Adreno-defib armor extra stim duration reduced (1s/2s --&gt; 0.1s/0.2s)
}
{$lua}

player_health      = Read_HealthConfiguration_Data(5556372446766824087)
stimheal_statuseff = Read_StatusEffect_Data("StatusEffectType_Stim_Heal")
stimpistolheal_statuseff = Read_StatusEffect_Data("StatusEffectType_Stim_Pistol_Heal")
medkit = RegisterPassive("HelldiverCustomizationPassiveBonus_Armor_CombatMedic")
adrenodefib = RegisterPassive("HelldiverCustomizationPassiveBonus_Armor_Adreno_Defib")

stimheal_statuseff.DATA.strength = 1
stimheal_statuseff.DATA.duration = 0.4

stimpistolheal_statuseff.DATA.strength = 1
stimpistolheal_statuseff.DATA.duration = 0.1

player_health.DATA.health  = 250
player_health.DATA.dmg_zones.zone1.health = 165 -- 85 (Head)
player_health.DATA.dmg_zones.zone2.health = 120 -- 60 (Torso)
player_health.DATA.dmg_zones.zone3.health = 65 -- 35 (arm)
player_health.DATA.dmg_zones.zone4.health = 65 -- 35 (arm)
player_health.DATA.dmg_zones.zone5.health = 80 -- 45 (leg)
player_health.DATA.dmg_zones.zone6.health = 80 -- 45 (leg)

medkit.DATA.passives[2].mod_value = 0.1
adrenodefib.DATA.passives[2].mod_value = 0.2

Apply_Passive_Modifications(medkit.DATA)
Apply_HealthConfiguration_Modifications(player_health.DATA)
Apply_StatusEffect_Modifications(stimpistolheal_statuseff.DATA)
Apply_StatusEffect_Modifications(stimheal_statuseff.DATA)
Apply_Passive_Modifications(adrenodefib.DATA)

{$asm}
[DISABLE]
{$lua}

Apply_Passive_Modifications(medkit.backup)
Apply_HealthConfiguration_Modifications(player_health.backup)
Apply_StatusEffect_Modifications(stimpistolheal_statuseff.backup)
Apply_StatusEffect_Modifications(stimheal_statuseff.backup)
Apply_Passive_Modifications(adrenodefib.backup)
</AssemblerScript>
