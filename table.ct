{$lua}

function Apply_WeaponInfo_Modifications(target_data)
    local target_address = target_data.address

    writeFloat(target_address   + 0x000, target_data.recoil.x)
    writeFloat(target_address   + 0x004, target_data.recoil.y)
    writeFloat(target_address   + 0x010, target_data.recoil.xbias)
    writeFloat(target_address   + 0x014, target_data.recoil.randx)
    writeFloat(target_address   + 0x018, target_data.recoil.randy)

    writeFloat(target_address   + 0x01C, target_data.climb.x)
    writeFloat(target_address   + 0x020, target_data.climb.y)
    writeFloat(target_address   + 0x02C, target_data.climb.xbias)
    writeFloat(target_address   + 0x030, target_data.climb.randx)
    writeFloat(target_address   + 0x034, target_data.climb.randy)
    writeFloat(target_address   + 0x038, target_data.climb.wielder_animation_recoil_amount_increment_per_shot)

    writeFloat(target_address   + 0x03C, target_data.multip.recoilx)
    writeFloat(target_address   + 0x040, target_data.multip.recoily)
    writeFloat(target_address   + 0x044, target_data.multip.driftx)
    writeFloat(target_address   + 0x048, target_data.multip.drifty)
    writeFloat(target_address   + 0x04C, target_data.multip.climbx)
    writeFloat(target_address   + 0x050, target_data.multip.climby)

    writeFloat(target_address   + 0x054, target_data.spread.infox)
    writeFloat(target_address   + 0x058, target_data.spread.infoy)
    writeInteger(target_address + 0x05C, target_data.spread.unknown_5C)
    writeFloat(target_address   + 0x060, target_data.spread.multipx)
    writeFloat(target_address   + 0x064, target_data.spread.multipy)

    --// ===========================     HANDLING    ===========================
    writeFloat(target_address   + 0x068, target_data.handling.sway_mlt)
    writeFloat(target_address   + 0x06C, target_data.handling.aim_block_length)
    writeFloat(target_address   + 0x080, target_data.handling.scope_sway)
    writeFloat(target_address   + 0x164, target_data.handling.ergonomics)
    writeFloat(target_address   + 0x168, target_data.handling.unknown_168)
    writeInteger(target_address + 0x16C, target_data.handling.unknown_16C)
    writeFloat(target_address   + 0x170, target_data.handling.unknown_170)
    writeFloat(target_address   + 0x174, target_data.handling.unknown_174)
    writeFloat(target_address   + 0x178, target_data.handling.unknown_178)
    writeFloat(target_address   + 0x17C, target_data.handling.unknown_17C)
    writeByte(target_address    + 0x180, target_data.handling.constrained_aim_leading)
    writeByte(target_address    + 0x181, target_data.handling.allow_fpv)
    writeByte(target_address    + 0x182, target_data.handling.allow_aiming)
    writeByte(target_address    + 0x183, target_data.handling.unknown_183)

    --// ===========================     SCOPE    ===========================
    writeFloat(target_address   + 0x074, target_data.scope.aimzoomx)
    writeFloat(target_address   + 0x078, target_data.scope.aimzoomy)
    writeFloat(target_address   + 0x07C, target_data.scope.aimzoomz)

    writeFloat(target_address   + 0x13C, target_data.scope.offsetx)
    writeFloat(target_address   + 0x140, target_data.scope.offsety)
    writeFloat(target_address   + 0x144, target_data.scope.offsetz)

    writeFloat(target_address   + 0x148, target_data.scope.crosshairx)
    writeFloat(target_address   + 0x14C, target_data.scope.crosshairy)

    writeInteger(target_address + 0x150, target_data.scope.unknown_150)


