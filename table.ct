{$lua}
-- //! =========================================================================
--                              Throwables Component Data
-- //! =========================================================================
function locateThrowableComponentAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "throwables"
    local struct_size = 0x168
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end

function Read_Throwable_Data(target_unique_id)
    local target_info    = locateThrowableComponentAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        dynamic_actor          = readInteger(target_address   + 0x000),
        delayed_dyn_actor      = readInteger(target_address   + 0x004),
        delayed_dyn_actor_time = readFloat(target_address   + 0x008),
        throw_distance_min = readFloat(target_address   + 0x00C),
        throw_distance_max = readFloat(target_address   + 0x010),
        use_angular_vel       = readByte(target_address   + 0x014),
        angular_vel_in_motion = readByte(target_address   + 0x015),
        custom_angvel_min = {
            x = readFloat(target_address   + 0x018),
            y = readFloat(target_address   + 0x01C),
            z = readFloat(target_address   + 0x020)},
        custom_angvel_max = {
            x = readFloat(target_address   + 0x024),
            y = readFloat(target_address   + 0x028),
            z = readFloat(target_address   + 0x02C)},
        thrower_velocity = {
            addition     = readFloat(target_address   + 0x048),
            substraction = readFloat(target_address   + 0x04C),
            deadzone     = readFloat(target_address   + 0x050)},
        sticky                = readInteger(target_address + 0x054),
        sticky_delay          = readFloat(target_address   + 0x058),
        is_impact_trigger             = readByte(target_address   + 0x05C),
        ignore_thrower_impact_trigger = readByte(target_address   + 0x05D),
        drop_on_cancelled             = readByte(target_address   + 0x05E),
        enable_interact_delay = readFloat(target_address   + 0x060),
        start_amount  = readInteger(target_address + 0x064),
        max_amount    = readInteger(target_address + 0x068),
        refill_amount = readInteger(target_address + 0x06C),
        unknown_158   = readInteger(target_address + 0x158)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end



