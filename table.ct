function Apply_HeatSettings_Modifications(target_data)
    local target_address = target_data.address
    writeFloat(target_address   + 0x000, target_data.overheat_stages[1].temperature_threshold)
    writeInteger(target_address + 0x004, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_data.overheat_stages[1].projectile_type))
    writeInteger(target_address + 0x014, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.overheat_stages[1].status_effect))
    writeFloat(target_address   + 0x018, target_data.overheat_stages[2].temperature_threshold)
    writeInteger(target_address + 0x01C, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_data.overheat_stages[2].projectile_type))
    writeInteger(target_address + 0x02C, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.overheat_stages[2].status_effect))
    writeFloat(target_address   + 0x030, target_data.overheat_stages[3].temperature_threshold)
    writeInteger(target_address + 0x034, fromStringtoMemory(ProjectileSettingsDatabaseOUT, target_data.overheat_stages[3].projectile_type))
    writeInteger(target_address + 0x044, fromStringtoMemory(StatusEffectDatabaseOUT, target_data.overheat_stages[3].status_effect))

    writeInteger(target_address + 0x054, target_data.magazines)
    writeInteger(target_address + 0x058, target_data.magazines_refill)
    writeInteger(target_address + 0x05C, target_data.magazines_max)
    writeFloat(target_address   + 0x060, target_data.overheat_temperature)
    writeFloat(target_address   + 0x064, target_data.overheat_temperature_recover)
    writeFloat(target_address   + 0x068, target_data.warning_temperature)
    writeFloat(target_address   + 0x06C, target_data.emission_temperature)
    writeFloat(target_address   + 0x074, target_data.temp_gain_per_shot)
    writeFloat(target_address   + 0x078, target_data.temp_gain_per_second)
    writeFloat(target_address   + 0x07C, target_data.temp_gain_per_second_modifier)
    writeFloat(target_address   + 0x080, target_data.temp_loss_per_second)
    writeFloat(target_address   + 0x084, target_data.temp_loss_modifier_extreme_heat)
    writeFloat(target_address   + 0x088, target_data.temp_loss_modifier_extreme_cold)
    writeFloat(target_address   + 0x08C, target_data.temp_loss_per_second_overheated)
    writeInteger(target_address + 0x090, target_data.needs_reload_after_overheat)
    writeFloat(target_address   + 0x094, target_data.firing_charge)
    writeFloat(target_address   + 0x098, target_data.charge_gain_per_second)
    writeFloat(target_address   + 0x09C, target_data.charge_loss_per_second)
end


