            auto_interact = readByte(target_address  + 0x190)},
        zone4 = {
            radius        = readFloat(target_address + 0x1A4),
            view_distance = readFloat(target_address + 0x1A8),
            auto_interact = readByte(target_address  + 0x218)},
        zone5 = {
            radius        = readFloat(target_address + 0x22C),
            view_distance = readFloat(target_address + 0x230),
            auto_interact = readByte(target_address  + 0x2A0)},
        zone6 = {
            radius        = readFloat(target_address + 0x2B4),
            view_distance = readFloat(target_address + 0x2B8),
            auto_interact = readByte(target_address  + 0x328)},
        zone7 = {
            radius        = readFloat(target_address + 0x33C),
            view_distance = readFloat(target_address + 0x340),
            auto_interact = readByte(target_address  + 0x3B0)},
        zone8 = {
            radius        = readFloat(target_address + 0x3C4),
            view_distance = readFloat(target_address + 0x3C8),
            auto_interact = readByte(target_address  + 0x438)},
        }
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end



