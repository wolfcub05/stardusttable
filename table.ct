                  <AssemblerScript>[ENABLE]
{
This script is made for Stardust's balance patch! If you're using this in a
different table there may be some weirdness in terms of the description below,
becasue it assumes you're using my table as a baseline! Other people's tables
have different defaults, so the text below's original values may not be accurate!

        Pipe Grenades
        [Unstable Overclock]
~ What makes me a good demoman?... WELL IF I WERE A BAD DEMOMAN--
++ Massive increase to projectile direct damage (50 --&gt; 640)
++ Massive increase to projectile durable damage (2 --&gt; 540)
++ Heavy armor penetration on the projectile (AP3 --&gt; AP4)
+ Increased projectile stagger (30 --&gt; 35)
+ Increased explosion damage (440 --&gt; 540)
~ No arming distance (7m --&gt; 0m)
- Decrease in initial shells (24 --&gt; 16)
- Decrease in muzzle velocity (100m/s --&gt; 75m/s)
-- Huge decrease to resupply amount (32 --&gt; 16)
-- Huge decrease to ammo reserves (32 --&gt; 16)
-- Huge increase in gravity multiplier (1.0x --&gt; 3.0x)
}
{$lua}
--// ====================== GL-15 Evictor ======================
--// UID: 31037231052968958 (pump_grenade_launcher)
--// Reload: the reload component duration is 0 (animation driven), so there is nothing to edit there.
--// None of the damage/explosion types above are shared with another weapon.
evictor_proj_damage = Read_DamageSettings_Data("DamageInfoType_Projectile_Grenade_Evictor")
evictor_projectile  = Read_ProjectileInfo_Data("ProjectileType_Grenade_Evictor", 31037231052968958)
evictor_expl_damage = Read_DamageSettings_Data("DamageInfoType_Explosion_Projectile_Grenade_Evictor")
evictor_explosion   = Read_ExplosiveSettings_Data("ExplosionType_Grenade_Evictor")
evictor_weaponinfo  = Read_WeaponInfo_Data(31037231052968958)
evictor_tagsinfo    = Read_TagsInfo_Data(31037231052968958)
evictor_rounds      = Read_Rounds_Data(31037231052968958)

--// direct hit of the 40mm shell (all values below are vanilla)
evictor_proj_damage.DATA.damage_std          = 640 --50
evictor_proj_damage.DATA.damage_drb          = 540 --2
Set_ArmorPenetration_Type(evictor_proj_damage, evictor_tagsinfo.DATA, "HeavyArmorPen")
evictor_proj_damage.DATA.ap_vals.ap1         = 4 --3
evictor_proj_damage.DATA.ap_vals.ap2         = 4 --3
evictor_proj_damage.DATA.ap_vals.ap3         = 4 --3
evictor_proj_damage.DATA.ap_vals.ap4         = 0 --0
evictor_proj_damage.DATA.demolition          = 30 --10
evictor_proj_damage.DATA.momentum.stagger    = 35 --30
evictor_proj_damage.DATA.momentum.knkback    = 10 --10

evictor_projectile.DATA.speed              = 75 --100
evictor_projectile.DATA.drag               = 1.2 --1.2
evictor_projectile.DATA.gravity_multiplier = 3 --1
evictor_projectile.DATA.arming_distance      = 0 --7
evictor_projectile.DATA.rpm.y                = 60 --60

evictor_expl_damage.DATA.damage_std          = 540 --440
evictor_expl_damage.DATA.damage_drb          = 540 --440
evictor_expl_damage.DATA.ap_vals.ap1         = 3 --3
evictor_expl_damage.DATA.ap_vals.ap2         = 0 --0
evictor_expl_damage.DATA.ap_vals.ap3         = 0 --0
evictor_expl_damage.DATA.ap_vals.ap4         = 0 --0
evictor_expl_damage.DATA.demolition          = 30 --30
evictor_expl_damage.DATA.momentum.stagger    = 25 --25
evictor_expl_damage.DATA.momentum.knkback    = 30 --30

evictor_explosion.DATA.inner_radius          = 2.25 --2.25
evictor_explosion.DATA.outer_radius          = 5.5 --5.5
evictor_explosion.DATA.stagger_radius        = 8 --8

--evictor_weaponinfo.DATA.spread.infox       = 15 --15
--evictor_weaponinfo.DATA.spread.infoy       = 12 --12
evictor_weaponinfo.DATA.handling.ergonomics  = 65 --65

evictor_rounds.DATA.mag_size.x               = 4 --4 (shells in the tube)
evictor_rounds.DATA.ammo.total               = 16 --32 (max spare shells)
evictor_rounds.DATA.ammo.refill              = 16 --32 (shells per resupply)
evictor_rounds.DATA.ammo.init                = 16 --24 (spare shells at spawn)
evictor_rounds.DATA.reload_amount            = 1 --1 (shells loaded per reload step)


Apply_DamageSettings_Modifications(evictor_proj_damage.DATA)
Apply_ProjectileInfo_Modifications(evictor_projectile.DATA)
Apply_DamageSettings_Modifications(evictor_expl_damage.DATA)
Apply_ExplosiveSettings_Modifications(evictor_explosion.DATA)
Apply_WeaponInfo_Modifications(evictor_weaponinfo.DATA)
Apply_TagsInfo_Modifications(evictor_tagsinfo.DATA)
Apply_RoundsSettings_Modifications(evictor_rounds.DATA)

{$asm}
[DISABLE]
{$lua}

Apply_DamageSettings_Modifications(evictor_proj_damage.backup)
Apply_ProjectileInfo_Modifications(evictor_projectile.backup)
Apply_DamageSettings_Modifications(evictor_expl_damage.backup)
Apply_ExplosiveSettings_Modifications(evictor_explosion.backup)
Apply_WeaponInfo_Modifications(evictor_weaponinfo.backup)
Apply_TagsInfo_Modifications(evictor_tagsinfo.backup)
Apply_RoundsSettings_Modifications(evictor_rounds.backup)
</AssemblerScript>
