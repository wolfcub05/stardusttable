{$lua}
function getAddressStratagemSettings(target_id, strat_type_str)
    local struct_size = 0x190
    local output_addr = AddressHandler(target_id, strat_type_str, struct_size)
    return output_addr
end

--global var for storing backups and quick retival
StratBackup = {}

--if need to reset for some reason
function StratBackupReset()
         StratBackup = {}
end

--[[ dont use this funtion (only get backup) use funtion after
eg use
Read_StratSettings_Data(input_str_idx)
]]
function Read_StratSettings(input_str_idx)

    local backup = StratBackup[input_str_idx]
    if backup == nil then

      local StratDBItem  = StratagemsDatabaseOUT[input_str_idx]
      local target_address = getAddressStratagemSettings(StratDBItem.type_idx, StratDBItem.pointerStr)
      local temp_078 = readInt_bin13digits(target_address + 0x078)
      local temp_180 = readInt_bin5digits(target_address + 0x170)

      local strat_template = {
          address            = target_address,
          category           = readInteger(target_address + 0x03C),
          uses               = readInteger(target_address + 0x050),
          spawn_time         = readFloat(target_address + 0x054),
          spawn_radius       = readFloat(target_address + 0x058),
          unknown_05C        = readFloat(target_address + 0x05C),
          beacon_linger_time = readFloat(target_address + 0x060),
          extra_travel_time  = readFloat(target_address + 0x064),
          cd_success         = readFloat(target_address + 0x068),
          cd_fail            = readFloat(target_address + 0x06C),
          call_in_type       = readInteger(target_address + 0x074),
             --[[
              0:Throw
              1:Exact Location
              2:Landing Zone Beacon
              3:Hellpad Call
              ]]
          call_in_logic_flags = {
              Use_Objective_Position = tonumber(temp_078:sub(1, 1)),
              unknown_02 = tonumber(temp_078:sub(2, 2)),
              Objective_Owner = tonumber(temp_078:sub(3, 3)),
              Host_Confirmation = tonumber(temp_078:sub(4, 4)),
              Host_Confirm_Unique_Instance = tonumber(temp_078:sub(5, 5)),
              Host_Confirm_Objective_Stratagem_Usage = tonumber(temp_078:sub(6, 6)),
              Blocked_by_Stratagem_Blocker = tonumber(temp_078:sub(7, 7)),
              unknown_8_yes_for_hellbomb = tonumber(temp_078:sub(8, 8)),
              Available_After_Mission_End = tonumber(temp_078:sub(9, 9))
          },

          triggers_war              = readInteger(target_address + 0x090),
          cost                      = readInteger(target_address + 0x0BC),
          enabled                   = readInteger(target_address + 0x0C0),
          --Depends_On_Stratagem_ID = readInteger(target_address + 0x0C4),
          --Additional_Stratagems_ID is only changed in stratagem adder but this is used for backup of eagles
          Additional_Stratagems_ID = readInteger(target_address + 0x0C8),
          --Max_in_Loadout          = readInteger(target_address + 0x0CC),
          allow_for_button_overlap  = tonumber(temp_180:sub(1, 1)),
          deploy_on_navmesh_only    = tonumber(temp_180:sub(2, 2))

      }


      StratBackup[input_str_idx] = strat_template
      return strat_template
    else
       return backup
    end

end

function Read_StratSettings_Data(input_str_idx)
         local backup = Read_StratSettings(input_str_idx)
         return {backup = backup, DATA = deepcopy(backup)}
end


function Read_EagleSettings_Data(input_str_idx)
    return Read_StratSettings_Data(input_str_idx)--, "strat_eagle")
end


