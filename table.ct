function Apply_Interactable_Modifications(target_data)
    local target_address = target_data.address
    writeFloat(target_address   + 0x00C, target_data.zone1.radius)
    writeFloat(target_address   + 0x010, target_data.zone1.view_distance)
    writeByte(target_address    + 0x080, target_data.zone1.auto_interact)

    writeFloat(target_address   + 0x094, target_data.zone2.radius)
    writeFloat(target_address   + 0x098, target_data.zone2.view_distance)
    writeByte(target_address    + 0x108, target_data.zone2.auto_interact)

    writeFloat(target_address   + 0x11C, target_data.zone3.radius)
    writeFloat(target_address   + 0x120, target_data.zone3.view_distance)
    writeByte(target_address    + 0x190, target_data.zone3.auto_interact)

    writeFloat(target_address   + 0x1A4, target_data.zone4.radius)
    writeFloat(target_address   + 0x1A8, target_data.zone4.view_distance)
    writeByte(target_address    + 0x218, target_data.zone4.auto_interact)

    writeFloat(target_address   + 0x22C, target_data.zone5.radius)
    writeFloat(target_address   + 0x230, target_data.zone5.view_distance)
    writeByte(target_address    + 0x2A0, target_data.zone5.auto_interact)

    writeFloat(target_address   + 0x2B4, target_data.zone6.radius)
    writeFloat(target_address   + 0x2B8, target_data.zone6.view_distance)
    writeByte(target_address    + 0x328, target_data.zone6.auto_interact)

    writeFloat(target_address   + 0x33C, target_data.zone7.radius)
    writeFloat(target_address   + 0x340, target_data.zone7.view_distance)
    writeByte(target_address    + 0x3B0, target_data.zone7.auto_interact)

    writeFloat(target_address   + 0x3C4, target_data.zone8.radius)
    writeFloat(target_address   + 0x3C8, target_data.zone8.view_distance)
    writeByte(target_address    + 0x438, target_data.zone8.auto_interact)
end


