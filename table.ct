                  <CheatEntries>
                    <CheatEntry>
                      <ID>1337316028</ID>
                      <Description>"[One-two] The Haymaker (Cosmetic Desync)"</Description>
                      <LastState/>
                      <Color>C08080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{
This script is made for Stardust's balance patch! If you're using this in a
different table there may be some weirdness in terms of the description below,
becasue it assumes you're using my table as a baseline! Other people's tables
have different defaults, so the text below's original values may not be accurate!

        The Haymaker
        [Unstable Overclock]
~ Replaces the underbarrel grenade launcher with an underbarrel Bushwhacker Shotgun
+ Unlike the bushwhacker, this shotgun has AP3. Otherwise it is identical.
+ Underbarrel Mag capacity increased (1 --&gt; 2)
+ Underbarrel reload speed increased (2s? --&gt; 1.4s)
+ Underbarrel reloads one at a time. (Round reload)
+ Underbarrel max ammo increased (3 --&gt; 10)
+ Underbarrel refill increased (? --&gt; 7)
+ Underbarrel initial increased (? --&gt; 8)
(The following is the bushwhacker's default stats:)
+ The Shotgun fires 18 Pellets
+ The Shotgun does 50 damage per pellet (900 Total)
+ The Shotgun does 15 Durable damage per pellet (270 Total)
+ The Shotgun has high stagger (35)
~ The Shotgun has high spread (200x, 150y)
- The Shotgun has high drag (1.0)
}

{$lua}
-- //! ==========          You can adjust the values here:

SHOTGUN_damage = Read_DamageSettings_Data("DamageInfoType_Projectile_Shotgun_12g_tri")
onetwo_grenade_rounds = Read_Rounds_Data(201944147320653301)
onetwo_grenade_reload = Read_Reload_Data(201944147320653301)
SHOTGUN_projectile = Read_ProjectileInfo_Data("ProjectileType_Shotgun_12g_tri", 201944147320653301)
SHOTGUN_weaponinfo  = Read_WeaponInfo_Data(201944147320653301)
onetwo_tagsinfo   = Read_TagsInfo_Data(12201875276601049603)
onetwo_grenade_rounds.DATA.ammo_types.primary = "ProjectileType_Shotgun_12g_tri"

SHOTGUN_damage.DATA.damage_std = 50 --45
SHOTGUN_damage.DATA.damage_drb = 15 --12
SHOTGUN_damage.DATA.ap_vals.ap1 = 3
SHOTGUN_damage.DATA.ap_vals.ap2 = 3
SHOTGUN_damage.DATA.ap_vals.ap3 = 2
SHOTGUN_damage.DATA.ap_vals.ap4 = 0
SHOTGUN_damage.DATA.demolition = 10
SHOTGUN_damage.DATA.momentum.stagger = 35
SHOTGUN_damage.DATA.momentum.knkback = 30

SHOTGUN_projectile.DATA.num_projectiles = 18
SHOTGUN_projectile.DATA.drag = 1

SHOTGUN_weaponinfo.DATA.spread.infox = 200
SHOTGUN_weaponinfo.DATA.spread.infoy = 150

onetwo_grenade_reload.DATA.duration = 1.4

onetwo_grenade_rounds.DATA.mag_size.x = 2 --60
onetwo_grenade_rounds.DATA.mag_size.y = 2 --60
onetwo_grenade_rounds.DATA.reload_amount = 1 --60
onetwo_grenade_rounds.DATA.chambered = 1 --60
onetwo_grenade_rounds.DATA.ammo.total = 10 --60
onetwo_grenade_rounds.DATA.ammo.refill = 7 --60
onetwo_grenade_rounds.DATA.ammo.init = 8 --32

-- // =============== Tags Settings
onetwo_tagsinfo.DATA.tag2 = 0

-- //! =======================================================
-- //!               DO NOT CHANGE the code below:
-- //! =======================================================
Apply_DamageSettings_Modifications(SHOTGUN_damage.DATA)
Apply_ProjectileInfo_Modifications(SHOTGUN_projectile.DATA)
Apply_RoundsSettings_Modifications(onetwo_grenade_rounds.DATA)
Apply_ReloadSettings_Modifications(onetwo_grenade_reload.DATA)
Apply_WeaponInfo_Modifications(SHOTGUN_weaponinfo.DATA)
Apply_TagsInfo_Modifications(onetwo_tagsinfo.DATA)

{$asm}
[DISABLE]
{$lua}

Apply_DamageSettings_Modifications(SHOTGUN_damage.backup)
Apply_ProjectileInfo_Modifications(SHOTGUN_projectile.backup)
Apply_RoundsSettings_Modifications(onetwo_grenade_rounds.backup)
Apply_ReloadSettings_Modifications(onetwo_grenade_reload.backup)
Apply_WeaponInfo_Modifications(SHOTGUN_weaponinfo.backup)
Apply_TagsInfo_Modifications(onetwo_tagsinfo.backup)
</AssemblerScript>
