{$lua}
local AP_VALUES = {
    LightArmorPen  = {2, 2, 1, 0},
    MediumArmorPen = {3, 3, 2, 0},
    HeavyArmorPen  = {4, 4, 3, 0},
    LightAntiTank  = {5, 5, 4, 0},
    AntiTank       = {6, 6, 5, 0},
}

-- Set_ArmorPenetration_Type(damage, [tags, tags, ...], "MediumArmorPen")
-- The AP type is always the last argument; any tag tables in between get tag1 set (nil/missing ones are skipped).
function Set_ArmorPenetration_Type(input_damage_table, ...)
    local n = select('#', ...)
    if n == 0 then return end
    local input_ap_type = select(n, ...)
    local v = AP_VALUES[input_ap_type]
    if not v then print("Set_ArmorPenetration_Type: unknown AP type " .. tostring(input_ap_type)) return end
    input_damage_table.ap_vals = {ap1 = v[1], ap2 = v[2], ap3 = v[3], ap4 = v[4]}
    for i = 1, n - 1 do
        local tags = select(i, ...)
        if type(tags) == "table" then tags.tag1 = getTag(input_ap_type) end
    end
end

