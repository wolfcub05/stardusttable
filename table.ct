{$lua}
-- //! =========================================================================
-- //!                    Read WarpPack CompData
-- //! =========================================================================

function locateWarpPackAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "warppack_params"
    local struct_size = 0x4F0
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end


function Read_Warppack_Data(target_unique_id)
    local target_info    = locateWarpPackAddress(target_unique_id)
    local target_address = target_info.address
    local output_template = {
        idx             = target_info.idx,
        address         = target_address,
        explosion_type         = readInteger(target_address + 0x038),
        warp_usage_delay       = readFloat(target_address   + 0x04C),
        warp_forward_distance  = readFloat(target_address   + 0x078),
        warp_upward_distance   = readFloat(target_address   + 0x080),
        warp_downward_distance = readFloat(target_address   + 0x084),
        warp_charge_safe_usage = readFloat(target_address   + 0x08C),
        explosion_threshold    = readFloat(target_address   + 0x090),
        heat_gained_per_use    = readFloat(target_address   + 0x094),
        heat_decay_rate        = readFloat(target_address   + 0x098)}
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end


