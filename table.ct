grenadelauncher_exp_damage.DATA.ap_vals.ap2       = 0 --0
grenadelauncher_exp_damage.DATA.ap_vals.ap3       = 0 --0
grenadelauncher_exp_damage.DATA.ap_vals.ap4       = 0 --0

