    writeFloat(target_address  + 0x0D8, target_data.combat.target_maximum_distance_secondary)
    writeFloat(target_address  + 0x0DC, target_data.combat.target_preferred_distance_secondary)
    writeFloat(target_address  + 0x0E8, target_data.combat.rotate_target_intercept_time)
    writeFloat(target_address  + 0x0EC, target_data.combat.time_until_reengagement)
    writeByte(target_address   + 0x0F0, target_data.combat.rotate_toward_target)
    writeByte(target_address   + 0x0F1, target_data.combat.follow_squad_leader)

    --//! =====================           Retreat
    writeFloat(target_address   + 0x0F4, target_data.retreat.movement.speed)
    writeInteger(target_address + 0x0F8, target_data.retreat.movement.locomotion_set)
    writeFloat(target_address   + 0x104, target_data.retreat.retreat_distance)
    writeFloat(target_address   + 0x108, target_data.retreat.max_retreat_time)
    writeFloat(target_address   + 0x110, target_data.retreat.ability_target_distance)

    --//! =====================           Charge
    writeFloat(target_address   + 0x114, target_data.charge.movement.speed)
    writeInteger(target_address + 0x118, target_data.charge.movement.locomotion_set)
    writeFloat(target_address   + 0x124, target_data.charge.acceleration)
    writeFloat(target_address   + 0x128, target_data.charge.turn_rate_interpolation_speed)
    writeFloat(target_address   + 0x12C, target_data.charge.charge_angle)
    writeFloat(target_address   + 0x130, target_data.charge.passed_stop_time)
    writeFloat(target_address   + 0x138, target_data.charge.lock_rotation_distance)

    --//! =====================           Flank
    writeFloat(target_address   + 0x1D4, target_data.flank.min_flank_distance)
    writeFloat(target_address   + 0x1D8, target_data.flank.max_flank_distance)
    writeFloat(target_address   + 0x1DC, target_data.flank.max_flank_angle)
    writeFloat(target_address   + 0x1E0, target_data.flank.feeler_length)

    --//! =====================           Cloak
    writeByte(target_address    + 0x1EC, target_data.cloak.can_cloak)
    writeByte(target_address    + 0x1ED, target_data.cloak.auto_cloak)
    writeFloat(target_address   + 0x1F0, target_data.cloak.cloak_time)
    writeInteger(target_address + 0x1F4, target_data.cloak.material_animation_cloak)
    writeInteger(target_address + 0x1F8, target_data.cloak.material_animation_decloak)


    --//! =====================           Idle VO
    writeFloat(target_address    + 0x224, target_data.idle_vo.cooldown_moving_patrol)
    writeFloat(target_address    + 0x228, target_data.idle_vo.cooldown_moving_investigate)
    writeFloat(target_address    + 0x22C, target_data.idle_vo.cooldown_moving_combat_min)
    writeFloat(target_address    + 0x230, target_data.idle_vo.cooldown_moving_combat_max)
    writeFloat(target_address    + 0x234, target_data.idle_vo.cooldown_moving_combat_min_distance)
    writeFloat(target_address    + 0x238, target_data.idle_vo.cooldown_moving_combat_max_distance)
    writeFloat(target_address    + 0x23C, target_data.idle_vo.cooldown_standing)
    writeFloat(target_address    + 0x240, target_data.idle_vo.cooldown_standing_combat)
    writeFloat(target_address    + 0x244, target_data.idle_vo.cooldown_randomization)
    writeFloat(target_address    + 0x248, target_data.idle_vo.unknown_204)
    writeFloat(target_address    + 0x24C, target_data.idle_vo.cooldown_area_range)
    writeFloat(target_address    + 0x250, target_data.idle_vo.unknown_20C)
    writeFloat(target_address    + 0x254, target_data.idle_vo.player_alert_range)
    writeFloat(target_address    + 0x258, target_data.idle_vo.player_alert_cooldown)
    writeInteger(target_address  + 0x25C, target_data.idle_vo.cooldown_id)


    --//! =====================           Misc Data
    writeFloat(target_address + 0x260, target_data.encounter_combat_time)
    writeFloat(target_address + 0x268, target_data.target_share_radius)
    writeFloat(target_address + 0x26C, target_data.use_feelers_navigation_distance)
    writeFloat(target_address + 0x270, target_data.interception_strength)
    writeFloat(target_address + 0x284, target_data.target_confirmation_lose_time)
    writeFloat(target_address + 0x288, target_data.combat_value)
    writeFloat(target_address + 0x28C, target_data.spot_time_close)
    writeFloat(target_address + 0x290, target_data.spot_time_far)
end

