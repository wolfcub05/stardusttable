function Apply_HealthConfiguration_Modifications(target_data)
    local target_address = target_data.address
    if target_address == "0x0000000000000000" then
        return
    end
    writeInteger(target_address + 0x0000, target_data.health)
    writeFloat(target_address   + 0x0004, target_data.health_changerate)
    writeInteger(target_address + 0x0008, target_data.health_changerate_disabled)
    writeFloat(target_address   + 0x000C, target_data.health_changerate_cooldown)
    writeInteger(target_address + 0x0010, target_data.regeneration_segments)
    writeFloat(target_address   + 0x0014, target_data.regeneration_changerate)
    writeInteger(target_address + 0x0018, target_data.constitution)
    writeFloat(target_address   + 0x001C, target_data.constitution_changerate)
    writeInteger(target_address + 0x0020, target_data.constitution_disables_interactions)
    writeFloat(target_address   + 0x0024, target_data.zone_bleedout_changerate)
    writeInteger(target_address + 0x0028, target_data.unit_size)
    writeFloat(target_address   + 0x002C, target_data.unit_mass)
    writeInteger(target_address + 0x0030, target_data.kill_score)
    writeFloat(target_address   + 0x0034, target_data.wounded_state.sway_multiplier)
    writeFloat(target_address   + 0x0038, target_data.wounded_state.move_speed_multiplier)
    writeInteger(target_address + 0x0104, target_data.default_dmg_zone_info.dmg_multiplier)
    writeInteger(target_address + 0x0108, target_data.default_dmg_zone_info.dmg_multiplier_dps)
    writeFloat(target_address   + 0x010C, target_data.default_dmg_zone_info.proj_drb_resistance)
    writeInteger(target_address + 0x0118, target_data.default_dmg_zone_info.armor)
    writeInteger(target_address + 0x011C, target_data.default_dmg_zone_info.armor_angle_check)
    writeInteger(target_address + 0x0120, target_data.default_dmg_zone_info.max_armor)
    writeInteger(target_address + 0x0124, target_data.default_dmg_zone_info.ignore_armor_on_self)
    writeInteger(target_address + 0x0128, target_data.default_dmg_zone_info.health)
    writeInteger(target_address + 0x012C, target_data.default_dmg_zone_info.constitution)
    writeByte(target_address    + 0x0130, target_data.default_dmg_zone_info.immortal)
    writeFloat(target_address   + 0x0138, target_data.default_dmg_zone_info.affects_main_health)
    writeByte(target_address    + 0x0181, target_data.default_dmg_zone_info.regeneration_enabled)
    writeByte(target_address    + 0x0182, target_data.default_dmg_zone_info.bleedout_enabled)
    writeByte(target_address    + 0x0183, target_data.default_dmg_zone_info.affected_by_explosions)
    writeFloat(target_address   + 0x0184, target_data.default_dmg_zone_info.explosion_dmg_mult)
    writeInteger(target_address + 0x0188, target_data.default_dmg_zone_info.affected_by_collision_impact)
    writeInteger(target_address + 0x018C, target_data.default_dmg_zone_info.on_dead_disable_all_actors)
    writeInteger(target_address + 0x0190, target_data.default_dmg_zone_info.explosion_verification)
    writeInteger(target_address + 0x0194, target_data.default_dmg_zone_info.main_health_affect_capped_zh)
    writeInteger(target_address + 0x0198, target_data.default_dmg_zone_info.hit_effect_receiver_type)

    --// Damage zones
    for i = 1, 38 do
        local zone_offset = 0x02CC + ((i - 1) * 0x228)
        local target_string = "zone" .. tostring(i)
        local zone_data = target_data.dmg_zones[target_string]
        writeInteger(target_address + zone_offset + 0x0000, zone_data.dmg_multiplier)
        writeInteger(target_address + zone_offset + 0x0004, zone_data.dmg_multiplier_dps)
        writeFloat(target_address   + zone_offset + 0x0008, zone_data.proj_drb_resistance)
        writeInteger(target_address + zone_offset + 0x0014, zone_data.armor)
        writeInteger(target_address + zone_offset + 0x0018, zone_data.armor_angle_check)
        writeInteger(target_address + zone_offset + 0x001C, zone_data.max_armor)
        writeInteger(target_address + zone_offset + 0x0020, zone_data.ignore_armor_on_self)
        writeInteger(target_address + zone_offset + 0x0024, zone_data.health)
        writeInteger(target_address + zone_offset + 0x0028, zone_data.constitution)
        writeByte(target_address    + zone_offset + 0x002C, zone_data.immortal)
        writeFloat(target_address   + zone_offset + 0x0034, zone_data.affects_main_health)
        writeByte(target_address    + zone_offset + 0x007D, zone_data.regeneration_enabled)
        writeByte(target_address    + zone_offset + 0x007E, zone_data.bleedout_enabled)
        writeByte(target_address    + zone_offset + 0x007F, zone_data.affected_by_explosions)
        writeFloat(target_address   + zone_offset + 0x0080, zone_data.explosion_dmg_mult)
        writeInteger(target_address + zone_offset + 0x0084, zone_data.affected_by_collision_impact)
        writeInteger(target_address + zone_offset + 0x0088, zone_data.on_dead_disable_all_actors)
        writeInteger(target_address + zone_offset + 0x008C, zone_data.explosion_verification)
        writeInteger(target_address + zone_offset + 0x0090, zone_data.main_health_affect_capped_zh)
        writeInteger(target_address + zone_offset + 0x0094, zone_data.hit_effect_receiver_type)
    end

    -- // Elemental damage
    writeInteger(target_address + 0x53FC, fromStringtoMemory(ElementTypeDatabaseOUT, target_data.elem_dmg.elem1_type))
    writeFloat(target_address   + 0x5400, target_data.elem_dmg.elem1_mult)
    writeInteger(target_address + 0x5404, fromStringtoMemory(ElementTypeDatabaseOUT, target_data.elem_dmg.elem2_type))
    writeFloat(target_address   + 0x5408, target_data.elem_dmg.elem2_mult)
    writeInteger(target_address + 0x540C, fromStringtoMemory(ElementTypeDatabaseOUT, target_data.elem_dmg.elem3_type))
    writeFloat(target_address   + 0x5410, target_data.elem_dmg.elem3_mult)
    writeInteger(target_address + 0x5414, fromStringtoMemory(ElementTypeDatabaseOUT, target_data.elem_dmg.elem4_type))
    writeFloat(target_address   + 0x5418, target_data.elem_dmg.elem4_mult)
    -- // Decay
    writeInteger(target_address + 0x541C, target_data.decay.mode)
    writeFloat(target_address   + 0x5420, target_data.decay.accel)
    writeFloat(target_address   + 0x5424, target_data.decay.min_delay)
    writeFloat(target_address   + 0x5428, target_data.decay.max_delay)
    -- // Others
    writeInteger(target_address + 0x5594, target_data.require_demo)
    writeInteger(target_address + 0x5598, target_data.downed_anim)
    writeInteger(target_address + 0x55AC, target_data.dead_anim)
    writeInteger(target_address + 0x55B0, target_data.on_downed_hide_vis_group)
    writeInteger(target_address + 0x55B4, target_data.on_downed_show_vis_group)
    writeInteger(target_address + 0x55B8, target_data.on_dead_hide_vis_group)
    writeInteger(target_address + 0x55BC, target_data.on_dead_show_vis_group)
    writeInteger(target_address + 0x55E0, target_data.on_death_destruct_lvl)
    writeInteger(target_address + 0x55E4, target_data.can_die_naturally)
    writeInteger(target_address + 0x55E8, target_data.death_propagation)
    writeInteger(target_address + 0x55EC, target_data.ui_health_str.str1)
    writeInteger(target_address + 0x55F0, target_data.ui_health_str.str2)
    writeInteger(target_address + 0x55F4, target_data.ui_health_str.str3)
    writeInteger(target_address + 0x55F8, target_data.ui_health_str.str4)
end


