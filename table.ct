{$lua}

function SetHealthArmorValues(tbl, health_val, armor_val, max_armor_val)
    for k, v in pairs(tbl) do
        if type(v) == "table" then
            SetHealthArmorValues(v, health_val, armor_val, max_armor_val)
        elseif k == "health" and type(v) == "number" and v &gt; 0.1 then
            tbl[k] = health_val
        elseif k == "armor" and type(v) == "number" and v &gt; 0.1 then
            tbl[k] = armor_val
            if type(tbl["max_armor"]) == "number" then
                tbl["max_armor"] = max_armor_val
            end
        end
    end
end


function locateHealthConfigurationAddress(input_uid_str)
    if input_uid_str == nil or input_uid_str == "" then
        return {idx = 0, address = "0x0000000000000000"}
    end
    local target_db   = "health_params"
    local struct_size = 0x5650 --//0x53E0
    local uid_idx     = UID_Localizator(input_uid_str,
                                        compdata_db[target_db]) --// output_idx
    local hex_uid_idx = Dec2Hex(uid_idx or 0)
    local values_addr = values_compdata[target_db]

    local output_address = uid_idx and (values_addr + (struct_size * hex_uid_idx)) or UID_Scratch(struct_size)
    fullAccess(output_address, struct_size)
    local output_info = {
        idx     = uid_idx,
        address = output_address}
    return output_info
end

function Read_HealthConfiguration_Data(target_unique_id)
    local target_info    = locateHealthConfigurationAddress(target_unique_id)
    local target_address = getAddress(target_info.address)
    fullAccess(target_address, 21464)
    local output_template = {
        idx                = target_info.idx,
        address            = target_address,
        health                             = readInteger(target_address   + 0x0000),
        health_changerate                  = readFloat(target_address     + 0x0004),
        health_changerate_disabled         = readInteger(target_address   + 0x0008),
        health_changerate_cooldown         = readFloat(target_address     + 0x000C),
        regeneration_segments              = readInteger(target_address   + 0x0010),
        regeneration_changerate            = readFloat(target_address     + 0x0014),
        constitution                       = readInteger(target_address   + 0x0018),
        constitution_changerate            = readFloat(target_address     + 0x001C),
        constitution_disables_interactions = readInteger(target_address   + 0x0020),
        zone_bleedout_changerate           = readFloat(target_address     + 0x0024),
        unit_size                          = readInteger(target_address   + 0x0028),
        unit_mass                          = readFloat(target_address     + 0x002C),
        kill_score                         = readInteger(target_address   + 0x0030),
        wounded_state = {
            sway_multiplier       = readFloat(target_address + 0x0034),
            move_speed_multiplier = readFloat(target_address + 0x0038)},
        default_dmg_zone_info = {
            dmg_multiplier    = readInteger(target_address    + 0x0104),
            dmg_multiplier_dps = readInteger(target_address    + 0x0108),
            proj_drb_resistance = readFloat  (target_address  + 0x010C),
            armor               = readInteger(target_address  + 0x0118),
            armor_angle_check   = readInteger(target_address  + 0x011C),
            max_armor           = readInteger(target_address  + 0x0120),
            ignore_armor_on_self = readInteger(target_address + 0x0124),
            health              = readInteger(target_address  + 0x0128),
            constitution        = readInteger(target_address  + 0x012C),
            immortal            = readByte(target_address     + 0x0130),
            affects_main_health = readFloat(target_address    + 0x0138),
            regeneration_enabled = readByte(target_address    + 0x0181),
            bleedout_enabled     = readByte(target_address    + 0x0182),
            affected_by_explosions = readByte(target_address  + 0x0183),
            explosion_dmg_mult     = readFloat(target_address + 0x0184),
            affected_by_collision_impact = readInteger(target_address + 0x0188),
            on_dead_disable_all_actors   = readInteger(target_address + 0x018C),
            explosion_verification       = readInteger(target_address + 0x0190),
            main_health_affect_capped_zh = readInteger(target_address + 0x0194),
            hit_effect_receiver_type     = readInteger(target_address + 0x0198),
        },
        dmg_zones = {},
        elem_dmg  = {
            elem1_type = readInteger(target_address + 0x53FC),
            elem1_mult = readFloat(target_address   + 0x5400),
            elem2_type = readInteger(target_address + 0x5404),
            elem2_mult = readFloat(target_address   + 0x5408),
            elem3_type = readInteger(target_address + 0x540C),
            elem3_mult = readFloat(target_address   + 0x5410),
            elem4_type = readInteger(target_address + 0x5414),
            elem4_mult = readFloat(target_address   + 0x5418)},
        decay     = {
            mode      = readInteger(target_address + 0x541C),
            accel     = readFloat(target_address   + 0x5420),
            min_delay = readFloat(target_address   + 0x5424),
            max_delay = readFloat(target_address   + 0x5428)},
        -- // UNUSED: death_snd_ids = {},
        -- // UNUSED: on_hit_effect = {},
        -- // UNUSED: while_alive_effect = {},
        -- // UNUSED: on_death_effect = {},
        -- // UNUSED: bled_to_death_effect = {},
        require_demo             = readInteger(target_address + 0x5594),
        downed_anim              = readInteger(target_address + 0x5598),
        dead_anim                = readInteger(target_address + 0x55AC),
        on_downed_hide_vis_group = readInteger(target_address + 0x55B0),
        on_downed_show_vis_group = readInteger(target_address + 0x55B4),
        on_dead_hide_vis_group   = readInteger(target_address + 0x55B8),
        on_dead_show_vis_group   = readInteger(target_address + 0x55BC),
        on_death_destruct_lvl    = readInteger(target_address + 0x55E0),
        can_die_naturally        = readInteger(target_address + 0x55E4),
        death_propagation        = readInteger(target_address + 0x55E8),
        ui_health_str = {
            str1 = readInteger(target_address + 0x55EC),
            str2 = readInteger(target_address + 0x55F0),
            str3 = readInteger(target_address + 0x55F4),
            str4 = readInteger(target_address + 0x55F8)}}
    -- // Loop through the damage zones and read their respective values
    for i = 1, 38 do
        local zone_offset = 0x02CC + ((i - 1) * 0x228)
        local zone_info = {
            dmg_multiplier    = readInteger(target_address    + zone_offset + 0x0000),
            dmg_multiplier_dps = readInteger(target_address   + zone_offset + 0x0004),
            proj_drb_resistance = readFloat  (target_address  + zone_offset + 0x0008),
            armor               = readInteger(target_address  + zone_offset + 0x0014),
            armor_angle_check   = readInteger(target_address  + zone_offset + 0x0018),
            max_armor           = readInteger(target_address  + zone_offset + 0x001C),
            ignore_armor_on_self = readInteger(target_address + zone_offset + 0x0020),
            health              = readInteger(target_address  + zone_offset + 0x0024),
            constitution        = readInteger(target_address  + zone_offset + 0x0028),
            immortal            = readByte(target_address     + zone_offset + 0x002C),
            affects_main_health = readFloat(target_address    + zone_offset + 0x0034),
            regeneration_enabled = readByte(target_address    + zone_offset + 0x007D),
            bleedout_enabled     = readByte(target_address    + zone_offset + 0x007E),
            affected_by_explosions = readByte(target_address  + zone_offset + 0x007F),
            explosion_dmg_mult     = readFloat(target_address + zone_offset + 0x0080),
            affected_by_collision_impact = readInteger(target_address + zone_offset + 0x0084),
            on_dead_disable_all_actors   = readInteger(target_address + zone_offset + 0x0088),
            explosion_verification       = readInteger(target_address + zone_offset + 0x008C),
            main_health_affect_capped_zh = readInteger(target_address + zone_offset + 0x0090),
            hit_effect_receiver_type     = readInteger(target_address + zone_offset + 0x0094)}
        local target_string = "zone" .. tostring(i)
        output_template.dmg_zones[target_string] = zone_info
    end
    return {backup = deepcopy(output_template), DATA = deepcopy(output_template)}
end

